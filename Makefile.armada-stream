# Isolated Armada full-stream profile. The controller occupies the existing
# pre-boot reserved pool; ordinary/excerpt loader objects are not destinations.
ifeq ($(KUI_WINCE_CDDA_PROFILE),worms)
override ARMADA_AUDIO_DIR := build/worms-ce-stream
WINCE_CDDA_PROFILE_FLAGS := -DKUI_WINCE_CDDA_WORMS=1
WINCE_CDDA_PROFILE_CHECK := --worms
WINCE_CDDA_CONTROLLER_BEGIN := 0x8cec7000
else ifeq ($(KUI_WINCE_CDDA_PROFILE),bam4)
override ARMADA_AUDIO_DIR := build/bam4-ce-stream
WINCE_CDDA_PROFILE_FLAGS := -DKUI_WINCE_CDDA_BAM4=1
WINCE_CDDA_PROFILE_CHECK := --bam4
else ifeq ($(KUI_WINCE_CDDA_PROFILE),wwp)
override ARMADA_AUDIO_DIR := build/wwp-ce-stream
WINCE_CDDA_PROFILE_FLAGS := -DKUI_WINCE_CDDA_WWP=1 -DKUI_ARMADA_CE_GENERIC_APPLICATION=1
WINCE_CDDA_PROFILE_CHECK := --wwp
else
override ARMADA_AUDIO_DIR := build/armada-ce-stream
endif
WINCE_CDDA_CONTROLLER_BEGIN ?= 0x8cfa7000
# Diagnostic only (Armada): K-UI's time in its GD calls and interrupt during
# the intro movie. The low reader keeps TMU0 tick totals in its own region;
# the controller reads them through its attached bus and reports them.
# KUI_ARMADA_CE_MOVIE_TIMING_PARTS isolates a half for a boot check: low
# (the low reader's counters only) or high (the controller's sampling only).
KUI_ARMADA_CE_MOVIE_TIMING_PARTS ?= both
ifeq ($(KUI_ARMADA_CE_MOVIE_TIMING),1)
ifneq ($(KUI_WINCE_CDDA_PROFILE),)
$(error Movie timing is an Armada diagnostic only)
endif
WINCE_CDDA_PROFILE_FLAGS += -DKUI_ARMADA_CE_MOVIE_TIMING=1
ifeq ($(KUI_ARMADA_CE_MOVIE_TIMING_PARTS),both)
override ARMADA_AUDIO_DIR := build/armada-ce-movie-timing
WINCE_CDDA_PROFILE_FLAGS += -DKUI_ARMADA_CE_MOVIE_TIMING_LOW=1 -DKUI_ARMADA_CE_MOVIE_TIMING_HIGH=1
else ifeq ($(KUI_ARMADA_CE_MOVIE_TIMING_PARTS),low)
override ARMADA_AUDIO_DIR := build/armada-ce-movie-timing-low
WINCE_CDDA_PROFILE_FLAGS += -DKUI_ARMADA_CE_MOVIE_TIMING_LOW=1
else ifeq ($(KUI_ARMADA_CE_MOVIE_TIMING_PARTS),high)
override ARMADA_AUDIO_DIR := build/armada-ce-movie-timing-high
WINCE_CDDA_PROFILE_FLAGS += -DKUI_ARMADA_CE_MOVIE_TIMING_HIGH=1
else
$(error KUI_ARMADA_CE_MOVIE_TIMING_PARTS must be both, low or high)
endif
# One behavior change on the measured timing reader: after a DMA overrun at
# 12.5 MHz, receive the next 64 blocks (the refetch included) at 6.25 MHz;
# an overrun there returns to 12.5 MHz and the programmed refetch.
ifeq ($(KUI_ARMADA_CE_SLOW_AFTER_OVERRUN),1)
ifneq ($(KUI_ARMADA_CE_MOVIE_TIMING_PARTS),both)
$(error The slow-after-overrun trial runs on the complete timing reader)
endif
override ARMADA_AUDIO_DIR := build/armada-ce-movie-timing-slow
WINCE_CDDA_PROFILE_FLAGS += -DKUI_CE_SCI_SLOW_AFTER_OVERRUN=1
endif
else ifeq ($(KUI_ARMADA_CE_SLOW_AFTER_OVERRUN),1)
$(error The slow-after-overrun trial needs KUI_ARMADA_CE_MOVIE_TIMING=1)
endif
override ARMADA_AUDIO_EXTRA_FLAGS := -DKUI_ARMADA_CE_EXCERPT=1 -DKUI_ARMADA_CE_STREAM=1 $(WINCE_CDDA_PROFILE_FLAGS)
override ARMADA_AUDIO_EXTRA_STAGE_FLAGS := -DKUI_ARMADA_CE_RAM_BIND_STAGE=1 -DKUI_ARMADA_CE_EXCERPT_STAGE=1 -DKUI_ARMADA_CE_STREAM=1 -DKUI_RETAIL_EXTENDED_MAP=1 $(WINCE_CDDA_PROFILE_FLAGS)
override ARMADA_AUDIO_EXTRA_STAGE_DEPS := $(ARMADA_AUDIO_DIR)/bind-probe.bin
override ARMADA_AUDIO_EXTRA_ASM_FLAGS := -DKUI_ARMADA_CE_RAM_BIND_STAGE=1 -DKUI_ARMADA_CE_RAM_BIND_BIN='"$(ARMADA_AUDIO_DIR)/bind-probe.bin"'
override ARMADA_AUDIO_EXTRA_LINK_FLAGS := -Wl,--defsym,_kui_armada_ce_bind_probe=$(WINCE_CDDA_CONTROLLER_BEGIN)
override ARMADA_AUDIO_EXTRA_CHECK := python3 tools/check_armada_ce_excerpt.py --stream $(WINCE_CDDA_PROFILE_CHECK) $(ARMADA_AUDIO_DIR)
ifeq ($(KUI_WINCE_CDDA_PROFILE),wwp)
# The controller is linked first. Export only its checked scalar object;
# importing the whole controller symbol table would collide with low helpers.
override ARMADA_AUDIO_EXTRA_LINK_FLAGS += -Wl,-T,$(ARMADA_AUDIO_DIR)/wwp-drive-status.ld
# Keep named callee relocations in LTRANS assembly: SH section+addend
# optimization otherwise leaves stale branch targets after linker relaxation.
override ARMADA_AUDIO_EXTRA_LINK_FLAGS += -Wa,--renesas
endif
ifneq ($(findstring -DKUI_ARMADA_CE_MOVIE_TIMING_LOW=1,$(WINCE_CDDA_PROFILE_FLAGS)),)
# The timing counters move the low reader's relaxed layout onto the same
# fault: eleven calls into the SD delivery chain landed four bytes into
# their callees (as in the 67b0df9 VMU-Off reader, which stopped at
# Entering Windows CE). Keep named callee relocations, keep the final
# relocations, and refuse any branch that enters a function mid-way.
override ARMADA_AUDIO_EXTRA_LINK_FLAGS += -Wa,--renesas -Wl,-q
override ARMADA_AUDIO_SCIA_POSTLINK := python3 tools/check_relaxed_calls.py
endif
include Makefile.armada-audio
ifeq ($(KUI_WINCE_CDDA_PROFILE),wwp)
# The embedded synchronous fallback also uses LTRANS and SH relaxation.
$(ARMADA_AUDIO_DIR)/resident-sci.elf: override RETAIL_SCI_LINK += -Wa,--renesas
$(ARMADA_AUDIO_DIR)/entry.elf: tools/check_retail_calls.py
endif

ARMADA_STREAM_FLAGS := $(RETAIL_FLAGS) -DKUI_RETAIL_CE=1 -DKUI_ARMADA_CE_EXCERPT=1 -DKUI_ARMADA_CE_STREAM=1 -DKUI_RETAIL_EXTENDED_MAP=1 -fcallgraph-info=su $(WINCE_CDDA_PROFILE_FLAGS)
# Override to empty only for the initial high-placement excerpt preflight.
# Full stream builds require all three independently implemented source units.
ARMADA_STREAM_EXTRA_SRC ?= src/loader/armada_ce_stream_model.c src/loader/armada_ce_stream_native.c src/loader/armada_ce_stream_transport.c src/loader/armada_ce_stream_player.c src/loader/armada_ce_stream_trace.c
ARMADA_STREAM_EXTRA_OBJS := $(patsubst src/loader/armada_ce_stream_%.c,$(ARMADA_AUDIO_DIR)/stream-%.o,$(ARMADA_STREAM_EXTRA_SRC))
ARMADA_STREAM_OBJS := $(ARMADA_AUDIO_DIR)/bind-probe.o $(ARMADA_AUDIO_DIR)/excerpt.o $(ARMADA_AUDIO_DIR)/excerpt-asm.o $(ARMADA_AUDIO_DIR)/excerpt-minic.o $(ARMADA_STREAM_EXTRA_OBJS) $(ARMADA_AUDIO_DIR)/stream-image.o $(ARMADA_AUDIO_DIR)/stream-cursor.o

$(ARMADA_AUDIO_DIR)/bind-probe.o: src/loader/armada_ce_excerpt_entry.c include/kui/armada_ce_excerpt_entry.h include/kui/armada_ce_live_sound.h include/kui/armada_ce_excerpt.h
	@mkdir -p $(@D)
	sh-elf-gcc $(ARMADA_STREAM_FLAGS) -MMD -MP -c $< -o $@
$(ARMADA_AUDIO_DIR)/excerpt.o: src/loader/armada_ce_excerpt.c include/kui/armada_ce_excerpt.h
	@mkdir -p $(@D)
	sh-elf-gcc $(ARMADA_STREAM_FLAGS) -MMD -MP -c $< -o $@
$(ARMADA_AUDIO_DIR)/excerpt-asm.o: src/loader/armada_ce_excerpt.S
	@mkdir -p $(@D)
	sh-elf-gcc $(ARMADA_STREAM_FLAGS) -MMD -MP -c $< -o $@
$(ARMADA_AUDIO_DIR)/excerpt-minic.o: src/loader/minic.c
	@mkdir -p $(@D)
	sh-elf-gcc $(ARMADA_STREAM_FLAGS) -MMD -MP -c $< -o $@
$(ARMADA_AUDIO_DIR)/stream-%.o: src/loader/armada_ce_stream_%.c
	@mkdir -p $(@D)
	sh-elf-gcc $(ARMADA_STREAM_FLAGS) -MMD -MP -c $< -o $@
$(ARMADA_AUDIO_DIR)/stream-image.o: src/core/retail_image.c
	@mkdir -p $(@D)
	sh-elf-gcc $(ARMADA_STREAM_FLAGS) -MMD -MP -c $< -o $@
$(ARMADA_AUDIO_DIR)/stream-cursor.o: src/core/retail_cursor.c
	@mkdir -p $(@D)
	sh-elf-gcc $(ARMADA_STREAM_FLAGS) -MMD -MP -c $< -o $@
$(ARMADA_AUDIO_DIR)/bind-probe.elf: $(ARMADA_STREAM_OBJS) src/loader/armada_ce_stream.ld
	sh-elf-gcc $(RETAIL_LINK) -Wl,--defsym,_kui_stream_code_base=$(WINCE_CDDA_CONTROLLER_BEGIN) -Tsrc/loader/armada_ce_stream.ld -Wl,-Map,$(@:.elf=.map) -o $@ $(ARMADA_STREAM_OBJS) -lgcc
$(ARMADA_AUDIO_DIR)/bind-probe.bin: $(ARMADA_AUDIO_DIR)/bind-probe.elf
	sh-elf-objcopy -O binary $< $@
$(ARMADA_AUDIO_DIR)/resident-scia.elf: $(ARMADA_AUDIO_DIR)/bind-probe.elf
ifeq ($(KUI_WINCE_CDDA_PROFILE),wwp)
$(ARMADA_AUDIO_DIR)/wwp-drive-status.ld: $(ARMADA_AUDIO_DIR)/bind-probe.elf tools/check_armada_ce_excerpt.py
	python3 tools/check_armada_ce_excerpt.py --wwp-drive-link $< > $@.new
	mv $@.new $@
$(ARMADA_AUDIO_DIR)/resident-scia.elf: $(ARMADA_AUDIO_DIR)/wwp-drive-status.ld
endif

-include $(ARMADA_STREAM_OBJS:.o=.d)

# The stage decodes a separate complete256-slot source map; the low DATA
# resident retains its original64-slot allocation and linked budget.
$(ARMADA_AUDIO_DIR)/common/src/core/retail_image.o: src/core/retail_image.c
	@mkdir -p $(@D)
	sh-elf-gcc $(RETAIL_FLAGS) -DKUI_RETAIL_EXTENDED_MAP=1 -MMD -MP -c $< -o $@
