# Isolated Armada full-stream profile. The controller occupies the existing
# pre-boot reserved pool; ordinary/excerpt loader objects are not destinations.
ifeq ($(KUI_WINCE_CDDA_PROFILE),worms)
override ARMADA_AUDIO_DIR := build/worms-ce-stream
WINCE_CDDA_PROFILE_FLAGS := -DKUI_WINCE_CDDA_WORMS=1
WINCE_CDDA_PROFILE_CHECK := --worms
WINCE_CDDA_CONTROLLER_BEGIN := 0x8cec7000
else ifeq ($(KUI_WINCE_CDDA_PROFILE),bam4)
override ARMADA_AUDIO_DIR := build/bam4-ce-stream
WINCE_CDDA_PROFILE_FLAGS := -DKUI_WINCE_CDDA_BAM4=1
WINCE_CDDA_PROFILE_CHECK := --bam4
else ifeq ($(KUI_WINCE_CDDA_PROFILE),wwp)
override ARMADA_AUDIO_DIR := build/wwp-ce-stream
WINCE_CDDA_PROFILE_FLAGS := -DKUI_WINCE_CDDA_WWP=1 -DKUI_ARMADA_CE_GENERIC_APPLICATION=1
WINCE_CDDA_PROFILE_CHECK := --wwp
else
override ARMADA_AUDIO_DIR := build/armada-ce-stream
endif
# Another kernel of World Party's group (include/kui/wince_cdda_wwp_kernels.h,
# derived by tools/wince_cdda_wwp_kernels.py): KUI_WINCE_CDDA_WWP_KERNEL=NAME,
# for example RAILROAD_TYCOON_II. That module admits only that kernel and
# carries its KUICDK01 record for the GUI; package it as
# ce-cdda-<first 12 hex digits of the kernel's SHA-256>.kui. World Party's own
# kernel, the default, builds ce-cdda-wwp.kui unchanged.
KUI_WINCE_CDDA_WWP_KERNEL ?= WORMS_WORLD_PARTY
ifneq ($(KUI_WINCE_CDDA_WWP_KERNEL),WORMS_WORLD_PARTY)
ifneq ($(KUI_WINCE_CDDA_PROFILE),wwp)
$(error KUI_WINCE_CDDA_WWP_KERNEL selects a kernel of World Party's group: build Makefile.wwp-stream)
endif
ifeq ($(shell grep -c '^\#define KUI_WINCE_CDDA_WWP_KERNEL_$(KUI_WINCE_CDDA_WWP_KERNEL) ' include/kui/wince_cdda_wwp_kernels.h),0)
$(error Unknown World Party group kernel $(KUI_WINCE_CDDA_WWP_KERNEL))
endif
WINCE_CDDA_WWP_KERNEL_FLAGS := -DKUI_WINCE_CDDA_WWP_KERNEL=KUI_WINCE_CDDA_WWP_KERNEL_$(KUI_WINCE_CDDA_WWP_KERNEL)
override ARMADA_AUDIO_DIR := build/wwp-ce-stream-$(shell echo '$(KUI_WINCE_CDDA_WWP_KERNEL)' | tr A-Z_ a-z-)
WINCE_CDDA_PROFILE_FLAGS += $(WINCE_CDDA_WWP_KERNEL_FLAGS)
WINCE_CDDA_PROFILE_CHECK += --wwp-kernel $(KUI_WINCE_CDDA_WWP_KERNEL)
ARMADA_AUDIO_EXTRA_ENTRY_FLAGS += -DKUI_WINCE_CDDA_KERNEL_RECORD=1 $(WINCE_CDDA_WWP_KERNEL_FLAGS)
endif
# Another kernel of Bust-A-Move 4's group (include/kui/wince_cdda_bam4_kernels.h,
# derived by tools/wince_cdda_bam4_kernels.py): KUI_WINCE_CDDA_BAM4_KERNEL=NAME,
# for example PUZZLE_BOBBLE_4, as World Party's group above. Bust-A-Move 4's own
# kernel, the default, builds ce-cdda-bam4.kui unchanged.
KUI_WINCE_CDDA_BAM4_KERNEL ?= BUST_A_MOVE_4
ifneq ($(KUI_WINCE_CDDA_BAM4_KERNEL),BUST_A_MOVE_4)
ifneq ($(KUI_WINCE_CDDA_PROFILE),bam4)
$(error KUI_WINCE_CDDA_BAM4_KERNEL selects a kernel of Bust-A-Move 4's group: build Makefile.bam4-stream)
endif
ifeq ($(shell grep -c '^\#define KUI_WINCE_CDDA_BAM4_KERNEL_$(KUI_WINCE_CDDA_BAM4_KERNEL) ' include/kui/wince_cdda_bam4_kernels.h),0)
$(error Unknown Bust-A-Move 4 group kernel $(KUI_WINCE_CDDA_BAM4_KERNEL))
endif
WINCE_CDDA_BAM4_KERNEL_FLAGS := -DKUI_WINCE_CDDA_BAM4_KERNEL=KUI_WINCE_CDDA_BAM4_KERNEL_$(KUI_WINCE_CDDA_BAM4_KERNEL)
override ARMADA_AUDIO_DIR := build/bam4-ce-stream-$(shell echo '$(KUI_WINCE_CDDA_BAM4_KERNEL)' | tr A-Z_ a-z-)
WINCE_CDDA_PROFILE_FLAGS += $(WINCE_CDDA_BAM4_KERNEL_FLAGS)
WINCE_CDDA_PROFILE_CHECK += --bam4-kernel $(KUI_WINCE_CDDA_BAM4_KERNEL)
ARMADA_AUDIO_EXTRA_ENTRY_FLAGS += -DKUI_WINCE_CDDA_KERNEL_RECORD=1 -DKUI_WINCE_CDDA_BAM4=1 $(WINCE_CDDA_BAM4_KERNEL_FLAGS)
endif
WINCE_CDDA_CONTROLLER_BEGIN ?= 0x8cfa7000
# Diagnostic only (Armada): K-UI's time in its GD calls and interrupt during
# the intro movie. The low reader keeps TMU0 tick totals in its own region;
# the controller reads them through its attached bus and reports them.
# KUI_ARMADA_CE_MOVIE_TIMING_PARTS isolates a half for a boot check: low
# (the low reader's counters only) or high (the controller's sampling only).
KUI_ARMADA_CE_MOVIE_TIMING_PARTS ?= both
ifeq ($(KUI_ARMADA_CE_MOVIE_TIMING),1)
ifneq ($(KUI_WINCE_CDDA_PROFILE),)
$(error Movie timing is an Armada diagnostic only)
endif
WINCE_CDDA_PROFILE_FLAGS += -DKUI_ARMADA_CE_MOVIE_TIMING=1
ifeq ($(KUI_ARMADA_CE_MOVIE_TIMING_PARTS),both)
override ARMADA_AUDIO_DIR := build/armada-ce-movie-timing
WINCE_CDDA_PROFILE_FLAGS += -DKUI_ARMADA_CE_MOVIE_TIMING_LOW=1 -DKUI_ARMADA_CE_MOVIE_TIMING_HIGH=1
else ifeq ($(KUI_ARMADA_CE_MOVIE_TIMING_PARTS),low)
override ARMADA_AUDIO_DIR := build/armada-ce-movie-timing-low
WINCE_CDDA_PROFILE_FLAGS += -DKUI_ARMADA_CE_MOVIE_TIMING_LOW=1
else ifeq ($(KUI_ARMADA_CE_MOVIE_TIMING_PARTS),high)
override ARMADA_AUDIO_DIR := build/armada-ce-movie-timing-high
WINCE_CDDA_PROFILE_FLAGS += -DKUI_ARMADA_CE_MOVIE_TIMING_HIGH=1
else
$(error KUI_ARMADA_CE_MOVIE_TIMING_PARTS must be both, low or high)
endif
# One behavior change on the measured timing reader: after a DMA overrun at
# 12.5 MHz, receive the next 64 blocks (the refetch included) at 6.25 MHz;
# an overrun there returns to 12.5 MHz and the programmed refetch.
ifeq ($(KUI_ARMADA_CE_SLOW_AFTER_OVERRUN),1)
ifneq ($(KUI_ARMADA_CE_MOVIE_TIMING_PARTS),both)
$(error The slow-after-overrun trial runs on the complete timing reader)
endif
override ARMADA_AUDIO_DIR := build/armada-ce-movie-timing-slow
WINCE_CDDA_PROFILE_FLAGS += -DKUI_CE_SCI_SLOW_AFTER_OVERRUN=1
# The next single change on the measured slow trial: the per-block CRC and
# bit reversal as one tighter loop (identical bytes and CRC).
ifeq ($(KUI_ARMADA_CE_FAST_TAKE),1)
override ARMADA_AUDIO_DIR := build/armada-ce-movie-timing-fast
WINCE_CDDA_PROFILE_FLAGS += -DKUI_CE_SCI_FAST_TAKE=1
endif
else ifeq ($(KUI_ARMADA_CE_FAST_TAKE),1)
$(error The fast block check runs on the slow-after-overrun trial)
endif
else ifneq ($(KUI_ARMADA_CE_SLOW_AFTER_OVERRUN)$(KUI_ARMADA_CE_FAST_TAKE),)
$(error The slow-after-overrun and fast-check trials need KUI_ARMADA_CE_MOVIE_TIMING=1)
endif
# Diagnostic only (Armada, CD music On): the fast-check timing reader with
# its six report rows taken from gameplay instead of the movie, from the first
# GD poll after the intro movie to the report: K-UI's time with the music
# worker's, the game's 64 KiB reads with and without music grants while they
# ran, the music transport's counts and the worker's steps
# (include/kui/armada_ce_play_timing.h). The low reader is the timing
# reader's; only the controller changes.
# KUI_ARMADA_CE_PLAY_TIMING=2 builds its control: the same module, except
# that the music is never queued (no worker, buffer or music card reads).
KUI_ARMADA_CE_PLAY_TIMING ?= 0
ifneq ($(filter $(KUI_ARMADA_CE_PLAY_TIMING),1 2),)
ifneq ($(KUI_ARMADA_CE_MOVIE_TIMING):$(KUI_ARMADA_CE_MOVIE_TIMING_PARTS):$(KUI_ARMADA_CE_SLOW_AFTER_OVERRUN):$(KUI_ARMADA_CE_FAST_TAKE),1:both:1:1)
$(error The gameplay timing needs KUI_ARMADA_CE_MOVIE_TIMING=1 KUI_ARMADA_CE_SLOW_AFTER_OVERRUN=1 KUI_ARMADA_CE_FAST_TAKE=1)
endif
override ARMADA_AUDIO_DIR := build/armada-ce-play-timing$(if $(filter 2,$(KUI_ARMADA_CE_PLAY_TIMING)),-silent)
WINCE_CDDA_PROFILE_FLAGS += -DKUI_ARMADA_CE_PLAY_TIMING=$(KUI_ARMADA_CE_PLAY_TIMING)
else ifneq ($(KUI_ARMADA_CE_PLAY_TIMING),0)
$(error KUI_ARMADA_CE_PLAY_TIMING must be 0, 1 or 2)
endif
# Every WinCE CD music reader (Armada, Worms, Bust-A-Move 4, Worms World
# Party): after a 12.5 MHz DMA overrun the next 64 receptions run at
# 6.25 MHz, and each block's CRC and bit reversal run as one tighter pass.
# Console-measured on Armada (VMU Off 8cdbc0a351f8, VMU On cb07c6454454).
# 0 rebuilds the earlier readers (eeed38bd540e) byte-identical. The timing
# diagnostics above keep their own explicit trial settings.
KUI_CE_READER_FIXES ?= 1
ifneq ($(filter $(KUI_CE_READER_FIXES),0 1),$(KUI_CE_READER_FIXES))
$(error KUI_CE_READER_FIXES must be 0 or 1)
endif
ifneq ($(KUI_ARMADA_CE_MOVIE_TIMING),1)
ifeq ($(KUI_CE_READER_FIXES),1)
WINCE_CDDA_PROFILE_FLAGS += -DKUI_CE_SCI_SLOW_AFTER_OVERRUN=1 -DKUI_CE_SCI_FAST_TAKE=1
endif
endif
# Delivery defaults: the CD music set console-accepted on 21 Nov 2026 as
# build 1ba2fa7e7040 on all five CD music modules (docs/wince-cdda-chain-test.md):
# the adaptive slow window (16 receptions, doubling twice), the worker's
# programmed receptions as an emergency only, and the music's card stream
# restarting where it stops. The timing diagnostics and KUI_CE_READER_FIXES=0
# keep the earlier settings. KUI_CE_SLOW_WINDOW=64 KUI_CE_SLOW_ADAPT=0
# KUI_CE_CDDA_EMERGENCY_PIO=0 KUI_CE_CDDA_CHAIN=0 rebuild the previous set
# (7b216f2e1136) byte-identical.
ifeq ($(filter 1,$(KUI_ARMADA_CE_MOVIE_TIMING)):$(KUI_CE_READER_FIXES),:1)
WINCE_CDDA_ACCEPTED_DEFAULTS := 1
endif
# The slow window after an overrun, as the generic module's switches
# (Makefile.dc KUI_CE_SLOW_WINDOW, KUI_CE_SLOW_ADAPT; src/loader/sci_stream.h):
# 16 receptions doubling up to 64 while overruns recur soon after the window
# is the generic module's console-measured setting (871c4c7784b4,
# docs/wince-adaptive-window-test.md). Both reach the reader and the
# controller, so the two see the same stream state.
KUI_CE_SLOW_WINDOW ?= $(if $(WINCE_CDDA_ACCEPTED_DEFAULTS),16,64)
KUI_CE_SLOW_ADAPT ?= $(if $(WINCE_CDDA_ACCEPTED_DEFAULTS),2,0)
ifneq ($(KUI_CE_SLOW_WINDOW):$(KUI_CE_SLOW_ADAPT),64:0)
ifneq ($(KUI_CE_READER_FIXES),1)
$(error KUI_CE_SLOW_WINDOW and KUI_CE_SLOW_ADAPT size the slow refetch of KUI_CE_READER_FIXES=1)
endif
ifeq ($(KUI_ARMADA_CE_MOVIE_TIMING),1)
$(error The movie timing diagnostic keeps its own reader settings)
endif
ifneq ($(shell [ "$(KUI_CE_SLOW_WINDOW)" -ge 1 ] 2>/dev/null && [ "$(KUI_CE_SLOW_WINDOW)" -le 127 ] 2>/dev/null && echo ok),ok)
$(error KUI_CE_SLOW_WINDOW must be a number from 1 to 127)
endif
ifneq ($(filter $(KUI_CE_SLOW_ADAPT),0 1 2 3),$(KUI_CE_SLOW_ADAPT))
$(error KUI_CE_SLOW_ADAPT must be 0, 1, 2 or 3 doublings)
endif
ifneq ($(shell [ $$(( $(KUI_CE_SLOW_WINDOW) << $(KUI_CE_SLOW_ADAPT) )) -le 127 ] 2>/dev/null && echo ok),ok)
$(error KUI_CE_SLOW_WINDOW doubled KUI_CE_SLOW_ADAPT times exceeds 127 receptions)
endif
ifneq ($(KUI_CE_SLOW_WINDOW),64)
WINCE_CDDA_PROFILE_FLAGS += -DKUI_SCI_STREAM_SLOW_BLOCKS=$(KUI_CE_SLOW_WINDOW)u
endif
ifneq ($(KUI_CE_SLOW_ADAPT),0)
WINCE_CDDA_PROFILE_FLAGS += -DKUI_SCI_STREAM_SLOW_ADAPT=$(KUI_CE_SLOW_ADAPT)
endif
endif
# The music worker's programmed receptions as an emergency only: it receives
# by programmed transfers only while the music plays with at most half a
# second of fresh PCM (until one second), not whenever the music is urgent;
# by DMA otherwise, prefill included (src/loader/armada_ce_stream_transport.c).
# Those urgent receptions were the console-measured cause of CD music On's
# gameplay lag (docs/wince-cdda-play-timing-test.md). Controller only; on by
# default with the delivery defaults above.
KUI_CE_CDDA_EMERGENCY_PIO ?= $(if $(WINCE_CDDA_ACCEPTED_DEFAULTS),1,0)
ifeq ($(KUI_CE_CDDA_EMERGENCY_PIO),1)
WINCE_CDDA_PROFILE_FLAGS += -DKUI_ARMADA_CE_STREAM_EMERGENCY_PIO=1
else ifneq ($(KUI_CE_CDDA_EMERGENCY_PIO),0)
$(error KUI_CE_CDDA_EMERGENCY_PIO must be 0 or 1)
endif
# The music's card stream restarts inside the interrupt or GD call that
# needs it, not at the worker's next visit: a restart's token search goes on
# for up to eight more slices there, and a fast overrun is refetched by DMA
# at 6.25 MHz while the slow window is armed, as the game's reads are
# (src/loader/armada_ce_stream_transport.c). Without it the music's DMA chain
# stops at each such restart until the worker's next visit, which the
# worker's programmed receptions covered (docs/wince-cdda-emergency-pio-test.md).
# Controller only; needs the reader's slow window. On by default with the
# delivery defaults above.
KUI_CE_CDDA_CHAIN ?= $(if $(WINCE_CDDA_ACCEPTED_DEFAULTS),1,0)
ifeq ($(KUI_CE_CDDA_CHAIN),1)
ifeq ($(findstring -DKUI_CE_SCI_SLOW_AFTER_OVERRUN=1,$(WINCE_CDDA_PROFILE_FLAGS)),)
$(error KUI_CE_CDDA_CHAIN needs the reader's slow window (KUI_CE_READER_FIXES=1, or the timing reader's slow trial))
endif
WINCE_CDDA_PROFILE_FLAGS += -DKUI_ARMADA_CE_STREAM_CHAIN=1
else ifneq ($(KUI_CE_CDDA_CHAIN),0)
$(error KUI_CE_CDDA_CHAIN must be 0 or 1)
endif
# A PLAY20/PLAY21 repeat count above the drive's four-bit field (15 repeats
# indefinitely) saturates to 15 instead of being refused
# (src/loader/armada_ce_stream_model.c). Ducati World asks for 1000.
# Controller only. On by default only in Ducati World's kernel module, so
# every other module stays byte-identical; 0 rebuilds that module as test
# build 1c71ba3afa17.
KUI_CE_CDDA_REPEAT_CLAMP ?= $(if $(filter DUCATI_WORLD,$(KUI_WINCE_CDDA_WWP_KERNEL)),1,0)
ifeq ($(KUI_CE_CDDA_REPEAT_CLAMP),1)
ARMADA_STREAM_EXTRA_FLAGS += -DKUI_ARMADA_CE_STREAM_REPEAT_CLAMP=1
else ifneq ($(KUI_CE_CDDA_REPEAT_CLAMP),0)
$(error KUI_CE_CDDA_REPEAT_CLAMP must be 0 or 1)
endif
override ARMADA_AUDIO_EXTRA_FLAGS := -DKUI_ARMADA_CE_EXCERPT=1 -DKUI_ARMADA_CE_STREAM=1 $(WINCE_CDDA_PROFILE_FLAGS)
override ARMADA_AUDIO_EXTRA_STAGE_FLAGS := -DKUI_ARMADA_CE_RAM_BIND_STAGE=1 -DKUI_ARMADA_CE_EXCERPT_STAGE=1 -DKUI_ARMADA_CE_STREAM=1 -DKUI_RETAIL_EXTENDED_MAP=1 $(WINCE_CDDA_PROFILE_FLAGS)
override ARMADA_AUDIO_EXTRA_STAGE_DEPS := $(ARMADA_AUDIO_DIR)/bind-probe.bin
override ARMADA_AUDIO_EXTRA_ASM_FLAGS := -DKUI_ARMADA_CE_RAM_BIND_STAGE=1 -DKUI_ARMADA_CE_RAM_BIND_BIN='"$(ARMADA_AUDIO_DIR)/bind-probe.bin"'
override ARMADA_AUDIO_EXTRA_LINK_FLAGS := -Wl,--defsym,_kui_armada_ce_bind_probe=$(WINCE_CDDA_CONTROLLER_BEGIN)
# Virtua Cop 2 (JPN)'s IP.BIN bootstrap 2 uses the map and work pages at the
# top of the pool as scratch (include/kui/armada_ce_boot2_scratch.h): after it
# has finished, the stage reinstalls them from its proven copy, for that exact
# IP.BIN, before the relay checks the pool. Stage only. On by default only in
# Virtua Cop 2's kernel module, so every other module stays byte-identical; 0,
# with KUI_CE_CDDA_SMALL_STACK=0 and KUI_CE_CDDA_VRAM_DMA=0, rebuilds that module
# as test build 9e89e778370f.
KUI_CE_CDDA_BOOT2_SCRATCH ?= $(if $(filter VIRTUA_COP_2,$(KUI_WINCE_CDDA_BAM4_KERNEL)),1,0)
ifeq ($(KUI_CE_CDDA_BOOT2_SCRATCH),1)
ifneq ($(KUI_WINCE_CDDA_BAM4_KERNEL),VIRTUA_COP_2)
$(error KUI_CE_CDDA_BOOT2_SCRATCH=1 belongs only to Virtua Cop 2's module (KUI_WINCE_CDDA_PROFILE=bam4 KUI_WINCE_CDDA_BAM4_KERNEL=VIRTUA_COP_2))
endif
override ARMADA_AUDIO_EXTRA_STAGE_FLAGS += -DKUI_ARMADA_CE_BOOT2_SCRATCH=1
override ARMADA_AUDIO_EXTRA_ASM_FLAGS += -DKUI_ARMADA_CE_BOOT2_SCRATCH=1
else ifneq ($(KUI_CE_CDDA_BOOT2_SCRATCH),0)
$(error KUI_CE_CDDA_BOOT2_SCRATCH must be 0 or 1)
endif
# Virtua Cop 2 (JPN)'s CD music reader needs more room than d800 for its data
# (it takes stream pieces into video memory, below): its background reader
# keeps the 1 KiB guarded stack of the accepted Armada CD music and VMU reader
# (ce-armada-all-on), retail_resident_ce_async_small_stack.ld, and its code and
# read-only data stay below d800 for the stream controller. Reader only. On by
# default only in Virtua Cop 2's module, so every other module stays
# byte-identical; 0, with KUI_CE_CDDA_VRAM_DMA=0 (which needs this room), builds
# that module with the 2 KiB stack, as test build 1ac7e667c0d3.
KUI_CE_CDDA_SMALL_STACK ?= $(if $(filter VIRTUA_COP_2,$(KUI_WINCE_CDDA_BAM4_KERNEL)),1,0)
ifeq ($(KUI_CE_CDDA_SMALL_STACK),1)
ifneq ($(KUI_WINCE_CDDA_BAM4_KERNEL),VIRTUA_COP_2)
$(error KUI_CE_CDDA_SMALL_STACK=1 belongs only to Virtua Cop 2's module (KUI_WINCE_CDDA_PROFILE=bam4 KUI_WINCE_CDDA_BAM4_KERNEL=VIRTUA_COP_2))
endif
override ARMADA_AUDIO_EXTRA_FLAGS += -DKUI_ARMADA_CE_STREAM_SMALL_STACK=1
override ARMADA_AUDIO_SCIA_LINKER := src/loader/retail_resident_ce_async_small_stack.ld
else ifneq ($(KUI_CE_CDDA_SMALL_STACK),0)
$(error KUI_CE_CDDA_SMALL_STACK must be 0 or 1)
endif
override ARMADA_AUDIO_EXTRA_CHECK := python3 tools/check_armada_ce_excerpt.py --stream $(WINCE_CDDA_PROFILE_CHECK) $(if $(filter 1,$(KUI_CE_READER_FIXES)),$(if $(filter 1,$(KUI_ARMADA_CE_MOVIE_TIMING)),,--reader-fixes)) $(ARMADA_AUDIO_DIR)
# Virtua Cop 2 (JPN) streams pieces of a DMAREAD_STREAM_EX straight into video
# memory after its memory-card check: its CD music reader takes them as the
# generic module has since a660354d804c (KUI_RETAIL_CE_VRAM_DMA, docs/
# wince-vram-stream.md, console-proven with CD music Off on 20 Nov 2026), and
# the module's build also runs the halfword-width check of that path on the
# linked reader. Background reader only; it needs the small stack's room. On by
# default only in Virtua Cop 2's module, so every other module stays
# byte-identical; 0 rebuilds that module without it, as the layout-only control
# 0414c2d08b02.
KUI_CE_CDDA_VRAM_DMA ?= $(if $(filter VIRTUA_COP_2,$(KUI_WINCE_CDDA_BAM4_KERNEL)),1,0)
ifeq ($(KUI_CE_CDDA_VRAM_DMA),1)
ifneq ($(KUI_WINCE_CDDA_BAM4_KERNEL),VIRTUA_COP_2)
$(error KUI_CE_CDDA_VRAM_DMA=1 belongs only to Virtua Cop 2's module (KUI_WINCE_CDDA_PROFILE=bam4 KUI_WINCE_CDDA_BAM4_KERNEL=VIRTUA_COP_2))
endif
ifneq ($(KUI_CE_CDDA_SMALL_STACK),1)
$(error KUI_CE_CDDA_VRAM_DMA=1 needs KUI_CE_CDDA_SMALL_STACK=1: the reader has no room for it otherwise)
endif
override ARMADA_AUDIO_EXTRA_FLAGS += -DKUI_RETAIL_CE_VRAM_DMA=1
override ARMADA_AUDIO_EXTRA_CHECK += && python3 tools/check_ce_virtual_vram_width.py $(ARMADA_AUDIO_DIR)/resident-scia.elf
else ifneq ($(KUI_CE_CDDA_VRAM_DMA),0)
$(error KUI_CE_CDDA_VRAM_DMA must be 0 or 1)
endif
ifeq ($(KUI_WINCE_CDDA_PROFILE),wwp)
# The controller is linked first. Export only its checked scalar object;
# importing the whole controller symbol table would collide with low helpers.
override ARMADA_AUDIO_EXTRA_LINK_FLAGS += -Wl,-T,$(ARMADA_AUDIO_DIR)/wwp-drive-status.ld
# Keep named callee relocations in LTRANS assembly: SH section+addend
# optimization otherwise leaves stale branch targets after linker relaxation.
override ARMADA_AUDIO_EXTRA_LINK_FLAGS += -Wa,--renesas
endif
ifneq ($(findstring -DKUI_ARMADA_CE_MOVIE_TIMING_LOW=1,$(WINCE_CDDA_PROFILE_FLAGS))$(findstring -DKUI_CE_SCI_SLOW_AFTER_OVERRUN=1,$(WINCE_CDDA_PROFILE_FLAGS)),)
# The timing counters (and equally the reader changes) move the low reader's
# relaxed layout onto the same fault: eleven calls into the SD delivery chain
# landed four bytes into their callees (as in the 67b0df9 VMU-Off reader,
# which stopped at Entering Windows CE). Keep named callee relocations, keep
# the final relocations, and refuse any branch that enters a function mid-way.
override ARMADA_AUDIO_EXTRA_LINK_FLAGS += -Wa,--renesas -Wl,-q
override ARMADA_AUDIO_SCIA_POSTLINK := python3 tools/check_relaxed_calls.py
endif
include Makefile.armada-audio
ifeq ($(KUI_WINCE_CDDA_PROFILE),wwp)
# The embedded synchronous fallback also uses LTRANS and SH relaxation.
$(ARMADA_AUDIO_DIR)/resident-sci.elf: override RETAIL_SCI_LINK += -Wa,--renesas
$(ARMADA_AUDIO_DIR)/entry.elf: tools/check_retail_calls.py
endif

include Makefile.armada-stream-controller

# These directories have no other flags record: rebuild every object when the
# reader changes are switched.
.PHONY: force-wince-reader-config
force-wince-reader-config:
$(ARMADA_AUDIO_DIR)/reader-config: force-wince-reader-config
	@mkdir -p $(@D)
	@printf '%s\n' 'READER_FIXES=$(KUI_CE_READER_FIXES)' > $@.tmp
ifneq ($(KUI_CE_SLOW_WINDOW):$(KUI_CE_SLOW_ADAPT),64:0)
	@printf '%s\n' 'SLOW_WINDOW=$(KUI_CE_SLOW_WINDOW)' 'SLOW_ADAPT=$(KUI_CE_SLOW_ADAPT)' >> $@.tmp
endif
ifeq ($(KUI_CE_CDDA_EMERGENCY_PIO),1)
	@printf '%s\n' 'EMERGENCY_PIO=1' >> $@.tmp
endif
ifeq ($(KUI_CE_CDDA_CHAIN),1)
	@printf '%s\n' 'CHAIN=1' >> $@.tmp
endif
ifeq ($(KUI_CE_CDDA_REPEAT_CLAMP),1)
	@printf '%s\n' 'REPEAT_CLAMP=1' >> $@.tmp
endif
ifneq ($(KUI_WINCE_CDDA_WWP_KERNEL),WORMS_WORLD_PARTY)
	@printf '%s\n' 'WWP_KERNEL=$(KUI_WINCE_CDDA_WWP_KERNEL)' >> $@.tmp
endif
ifneq ($(KUI_WINCE_CDDA_BAM4_KERNEL),BUST_A_MOVE_4)
	@printf '%s\n' 'BAM4_KERNEL=$(KUI_WINCE_CDDA_BAM4_KERNEL)' >> $@.tmp
endif
ifeq ($(KUI_CE_CDDA_BOOT2_SCRATCH),1)
	@printf '%s\n' 'BOOT2_SCRATCH=1' >> $@.tmp
endif
ifeq ($(KUI_CE_CDDA_SMALL_STACK),1)
	@printf '%s\n' 'SMALL_STACK=1' >> $@.tmp
endif
ifeq ($(KUI_CE_CDDA_VRAM_DMA),1)
	@printf '%s\n' 'VRAM_DMA=1' >> $@.tmp
endif
