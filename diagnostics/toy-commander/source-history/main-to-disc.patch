+    const uint32_t tcr=*(volatile const uint16_t *)0xffd80010u;
+    const uint32_t tstr=*(volatile const uint8_t *)0xffd80004u;
+    return (struct ra_clock){word(0xffd8000cu),kui_toy_pilot_clock_profile(frqcr,tcor,tcr,tstr)};
+}
