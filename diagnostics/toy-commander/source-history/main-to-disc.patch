diff --git a/src/loader/toy_suite_report_stage.inc b/src/loader/toy_suite_report_stage.inc
new file mode 100644
index 00000000..8899b05c
--- /dev/null
+++ b/src/loader/toy_suite_report_stage.inc
@@ -0,0 +1,33 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include "kui/toy_suite_report_wire.h"
+
+/* The GUI patches this object after verifying the module envelope. Assembly
+ * keeps the blank initializer from being folded into the cold-stage reader. */
+__asm__(".section .rodata.toy_report_seed,\"a\"\n.balign 4\n"
+        ".global __toy_suite_report_seed\n.type __toy_suite_report_seed,@object\n"
+        "__toy_suite_report_seed:\n.ascii \"KUITRS01\"\n.long 1,64\n.zero 48\n"
+        ".size __toy_suite_report_seed,64\n.previous\n");
+extern const struct kui_toy_report_wire toy_report_seed __asm__("__toy_suite_report_seed");
+
+static void toy_suite_report_prepare(struct kui_toy_report_wire *out) {
+    const struct kui_toy_report_wire *seed=&toy_report_seed;
+#if KUI_TOY_FMV_COMPARE
+    unsigned test=29u;
+#else
+    unsigned test=toy_suite_source==2u && KUI_TOY_SUITE_MODE==1 ? 5u : KUI_TOY_SUITE_MODE;
+#endif
+    if(!toy_suite_source || card.transport!=KUI_STORAGE_SCI || seed->test!=test ||
+       seed->magic[0]!=KUI_TOY_REPORT_MAGIC0 || seed->magic[1]!=KUI_TOY_REPORT_MAGIC1 ||
+       seed->version!=KUI_TOY_REPORT_VERSION || seed->bytes!=sizeof(*seed) || seed->reserved ||
+       seed->high_capacity>1u || seed->lba[0]==seed->lba[1] ||
+       kui_retail_crc32(0,seed,KUI_TOY_REPORT_CRC_OFFSET)!=seed->crc32)return;
+    for(unsigned i=0;i<2u;i++) {
+        uint32_t lba=seed->lba[i];
+        if(!lba || lba<manifest.partition_start || lba>=manifest.partition_end || lba>=manifest.card_sectors)return;
+        for(unsigned j=0;j<manifest.extent_count;j++) {
+            const struct kui_retail_extent *e=&manifest.slots[manifest.track_count+j].extent;
+            if(lba>=e->card_lba && lba-e->card_lba<e->blocks)return;
+        }
+    }
+    *out=*seed;
+}
diff --git a/src/loader/toy_suite_report_write.inc b/src/loader/toy_suite_report_write.inc
new file mode 100644
index 00000000..fe2aa0a3
--- /dev/null
+++ b/src/loader/toy_suite_report_write.inc
@@ -0,0 +1,37 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include "../dreamcast/sci_sd_storage.h"
+#include "kui/vmu_backing.h"
+
+static int toy_suite_report_write(struct kui_loader_sd *loan) {
+    const struct kui_toy_report_wire *seed=&config.toy_report;
+    if(!loan || !state.armed || state.error!=0x4fu || state.pending ||
+       state.submitted!=state.completed || !seed->test || !loan->ready || loan->slow ||
+       loan->high_capacity!=!!seed->high_capacity ||
+       seed->lba[0]==seed->lba[1] || seed->lba[0]>=loan->blocks || seed->lba[1]>=loan->blocks ||
+       kui_retail_crc32(0,seed,KUI_TOY_REPORT_CRC_OFFSET)!=seed->crc32)return -1;
+    struct kui_vmu_sd_identity identity;
+    if(kui_vmu_sd_identity_read(loan,&identity)!=KUI_VMU_BACKING_OK ||
+       memcmp(identity.cid,seed->cid,sizeof(identity.cid)))return -1;
+    uint8_t *verify=issued_chain+KUI_TOY_REPORT_FILE_BYTES;
+    for(unsigned i=0;i<2u;i++) {
+        if(kui_loader_sd_read(loan,seed->lba[i],1u,verify)!=KUI_LOADER_SD_OK ||
+           kui_retail_crc32(0,verify,KUI_TOY_REPORT_SECTOR_BYTES)!=seed->placeholder_crc[i])return -1;
+    }
+    /* Match the durable writer's PIO path. Both slots have been checked before
+     * the first write, and no filesystem metadata is updated in-game. */
+    bool (*block)(void *,const uint8_t *,uint8_t *,size_t,bool,uint16_t *)=loan->bus.transfer_block;
+    loan->bus.transfer_block=NULL;
+    int result=0;
+    for(unsigned i=0;i<2u;i++) {
+        if(kui_sci_sd_write(loan,seed->lba[i],1u,issued_chain+i*KUI_TOY_REPORT_SECTOR_BYTES)!=KUI_LOADER_SD_OK) {
+            result=-1;break;
+        }
+    }
+    loan->bus.transfer_block=block;
+    if(result || kui_sci_sd_sync(loan)!=KUI_LOADER_SD_OK)return -1;
+    for(unsigned i=0;i<2u;i++) {
+        if(kui_loader_sd_read(loan,seed->lba[i],1u,verify)!=KUI_LOADER_SD_OK ||
+           memcmp(verify,issued_chain+i*KUI_TOY_REPORT_SECTOR_BYTES,KUI_TOY_REPORT_SECTOR_BYTES))return -1;
+    }
+    return 0;
+}
diff --git a/src/loader/toy_suite_witness.inc b/src/loader/toy_suite_witness.inc
new file mode 100644
index 00000000..248e3a5a
--- /dev/null
+++ b/src/loader/toy_suite_witness.inc
@@ -0,0 +1,70 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include "kui/retail_loader_layout.h"
+#include "kui/toy_suite_witness.h"
+
+#ifdef KUI_TOY_WITNESS_HOST_TEST
+extern const uint8_t *kui_toy_witness_test_read(uint32_t);
+#endif
+
+static unsigned toy_witness_diff(const uint8_t *expected,const uint8_t *actual) {
+    unsigned at=0u;
+    typedef uint32_t word __attribute__((__may_alias__));
+    if(!(((uintptr_t)expected|(uintptr_t)actual)&3u)) {
+        for(;at<KUI_GAME_DATA_BYTES;at+=sizeof(word))
+            if(*(const word *)(expected+at)!=*(const word *)(actual+at))break;
+    }
+    for(;at<KUI_GAME_DATA_BYTES;at++)if(expected[at]!=actual[at])break;
+    return at;
+}
+
+/* Runs after native GD publishes the terminal result, still under the
+ * serialized hook. Read the actual destination from P2, like write_out()
+ * after it purges the relevant P1 lines. No storage or cache operations. */
+static void toy_suite_witness_complete(const kui_retail_async_region_type *r) {
+    const struct kui_retail_gd *s=&r->shared.service;
+    const struct kui_retail_async *e=&r->engine;
+    const struct kui_toy_suite_seed *seed=&C.config.suite_seed;
+    if(!seed->count[0] || !s->initialized || !s->token || s->token!=e->token ||
+       s->pending || s->executing || s->error || s->status!=KUI_GD_COMPLETED ||
+       (s->command!=KUI_GD_PIOREAD && s->command!=KUI_GD_DMAREAD) ||
+       s->sector_bytes!=KUI_GAME_DATA_BYTES || !s->count ||
+       s->lba>=KUI_GAME_LBA_LIMIT || s->count>KUI_GAME_LBA_LIMIT-s->lba ||
+       e->active || e->failed || e->native_loan_state || e->cursor.raw ||
+       !e->manifest || e->cursor.manifest!=e->manifest || e->cursor.lba!=s->lba ||
+       e->cursor.count!=s->count || e->cursor.done!=s->count)return;
+
+    const uint32_t bytes=s->count*KUI_GAME_DATA_BYTES;
+    const uint32_t dest=e->destination;
+    const uint32_t physical=dest&UINT32_C(0x1fffffff);
+    const uint32_t lease=C.config.lease;
+    if(s->request_bytes!=bytes || s->completed_bytes!=bytes ||
+       dest!=((s->destination&UINT32_C(0x00ffffff))|UINT32_C(0x8c000000)) ||
+       dest<KUI_RETAIL_IP_ADDRESS || dest<s->guest_begin ||
+       dest>=KUI_RETAIL_RAM_END || dest>=s->guest_end ||
+       bytes>KUI_RETAIL_RAM_END-dest || bytes>s->guest_end-dest ||
+       (physical<lease+C.config.lease_bytes && physical+bytes>lease-32u))return;
+
+    const uint32_t end=s->lba+s->count;
+    const uint8_t *expected=C.config.data;
+    for(unsigned w=0u;w<2u;w++,expected+=KUI_TOY_WITNESS_SECTORS*KUI_GAME_DATA_BYTES) {
+        uint32_t first=seed->base[w],count=KUI_TOY_WITNESS_SECTORS;
+        if(seed->count[w]!=count || first>=end || first+count<=s->lba)continue;
+        uint32_t lba=first>s->lba?first:s->lba;
+        uint32_t last=first+count<end?first+count:end;
+        for(;lba<last;lba++) {
+            uint32_t address=(dest+(lba-s->lba)*KUI_GAME_DATA_BYTES)|UINT32_C(0x20000000);
+#ifdef KUI_TOY_WITNESS_HOST_TEST
+            const uint8_t *actual=kui_toy_witness_test_read(address);
+#else
+            const uint8_t *actual=(const void *)(uintptr_t)address;
+#endif
+            const uint8_t *wanted=expected+(lba-first)*KUI_GAME_DATA_BYTES;
+            unsigned byte=toy_witness_diff(wanted,actual);
+            ++C.suite[1];
+            if(byte<KUI_GAME_DATA_BYTES && !C.suite[2]) {
+                C.suite[2]=lba; C.suite[3]=byte;
+                C.suite[4]=(uint32_t)wanted[byte]<<8|actual[byte];
+            }
+        }
+    }
+}
diff --git a/src/loader/toy_suite_witness_stage.inc b/src/loader/toy_suite_witness_stage.inc
new file mode 100644
index 00000000..78533b30
--- /dev/null
+++ b/src/loader/toy_suite_witness_stage.inc
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include "kui/hash.h"
+#include "kui/toy_suite_witness.h"
+
+_Static_assert(2u*KUI_TOY_WITNESS_SECTORS*KUI_GAME_DATA_BYTES==sizeof(toy_suite_data),
+    "Both complete witness windows must fit the existing arena");
+
+/* SCI is already owned by the cold stage. Validate both raw on-card
+ * witnesses before publishing either window to the runtime. The on-card
+ * EDC is independent of the SPI transfer CRC and GD output copy. */
+static bool toy_suite_witness_seed(void) {
+    const struct kui_toy_movie_range *movie=&toy_movie_ranges[3];
+    /* Latest original-GDI runs last completed requests at these exclusive
+     * LBAs. Sample the preceding 40 sectors and the following eight. */
+    static const uint32_t base[2]={UINT32_C(0x724a0)-40u,UINT32_C(0x72858)-40u};
+    uint8_t *out=toy_suite_data;
+    for(unsigned window=0u;window<2u;window++) {
+        uint32_t first=base[window];
+        if(first<movie->lba || first-movie->lba>=movie->count ||
+           KUI_TOY_WITNESS_SECTORS>movie->count-(first-movie->lba))return false;
+        for(unsigned at=0u;at<KUI_TOY_WITNESS_SECTORS;) {
+            unsigned count=KUI_TOY_WITNESS_SECTORS-at;
+            const unsigned capacity=sizeof(raw_boot)/KUI_GAME_RAW_BYTES;
+            if(count>capacity)count=capacity;
+            if(kui_retail_image_read(&image,first+at,count,KUI_GAME_SECTOR_RAW,
+                 raw_boot,count*KUI_GAME_RAW_BYTES)!=KUI_GAME_OK)return false;
+            for(unsigned i=0u;i<count;i++) {
+                const uint8_t *raw=raw_boot+i*KUI_GAME_RAW_BYTES;
+                if(raw[15]!=1u || !kui_sector_edc_valid_at(raw,first+at+i+150u))return false;
+                memcpy(out,raw+16u,KUI_GAME_DATA_BYTES);
+                out+=KUI_GAME_DATA_BYTES;
+            }
+            at+=count;
+        }
+    }
+    for(unsigned i=0u;i<2u;i++) {
+        toy_suite_seed.base[i]=base[i];
+        toy_suite_seed.count[i]=KUI_TOY_WITNESS_SECTORS;
+    }
+    return true;
+}
