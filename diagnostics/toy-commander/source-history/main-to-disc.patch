index 00000000..f17c3138
--- /dev/null
+++ b/tests/test_toy_fmv_compare.c
@@ -0,0 +1,112 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include "kui/toy_fmv_compare.h"
+#include "kui/gd_service.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+static const struct kui_toy_movie_range ranges[4]={
+    {1000u,600u},{2000u,600u},{3000u,600u},{4000u,600u}
+};
+
+static void test_movie_bins(void) {
+    struct kui_toy_fmv_trace trace={0};
+    const uint32_t begin=256u;
+    const uint32_t half=KUI_TOY_FMV_BIN_TICKS;
+    struct kui_toy_fmv_movie *bumper=&trace.movie[0], *intro=&trace.movie[1];
+
+    /* The header, the end of an extent, and invalid requests are excluded. */
+    kui_toy_fmv_request(&trace,ranges,1u,1385u,1u,begin);
+    kui_toy_fmv_request(&trace,ranges,1u,1600u,1u,begin);
+    kui_toy_fmv_request(&trace,ranges,0u,1386u,1u,begin);
+    kui_toy_fmv_request(&trace,ranges,1u,1386u,0u,begin);
+    assert(!bumper->requests && !intro->requests);
+
+    /* Requests are attributed to their issue bin and completions to their
+     * CHECK bin. Two handles can overlap and complete out of issue order. */
+    kui_toy_fmv_request(&trace,ranges,1u,1386u,4u,begin);
+    kui_toy_fmv_request(&trace,ranges,2u,1390u,2u,begin-1u);
+    kui_toy_fmv_status(&trace,1u,begin-2u,KUI_GD_PROCESSING,2048u);
+    kui_toy_fmv_status(&trace,3u,begin-3u,KUI_GD_COMPLETED,2048u);
+    assert(bumper->requests==2u && bumper->bins[0].requested==6u && !bumper->acks);
+    kui_toy_fmv_status(&trace,2u,begin-(half-1u),KUI_GD_COMPLETED,4096u);
+    assert(bumper->bins[0].completed==2u && bumper->bins[0].longest==half-2u);
+    assert(bumper->end_lba==1392u);
+    kui_toy_fmv_status(&trace,1u,begin-half,KUI_GD_COMPLETED,6145u);
+    kui_toy_fmv_status(&trace,1u,begin-half-1u,KUI_GD_COMPLETED,8192u);
+    assert(bumper->acks==2u && bumper->short_bytes==1u && !bumper->failed);
+    assert(bumper->bins[1].completed==3u && bumper->bins[1].longest==half);
+    assert(bumper->bins[1].gap==1u && bumper->end_lba==1389u && !trace.clock_lost);
+
+    /* Each movie has its own zero. A failed read ends its request without
+     * adding successful sectors, even if CHECK reports a byte count. */
+    const uint32_t intro_begin=begin-17u*half;
+    kui_toy_fmv_request(&trace,ranges,3u,4386u,5u,intro_begin);
+    kui_toy_fmv_status(&trace,3u,intro_begin-half,KUI_GD_FAILED,4096u);
+    assert(intro->first_tick==intro_begin && intro->bins[0].requested==5u);
+    assert(intro->acks==1u && intro->failed==1u && !intro->short_bytes);
+    assert(!intro->bins[1].completed && intro->bins[1].longest==half);
+    kui_toy_fmv_request(&trace,ranges,4u,4391u,1u,intro_begin-20u*half);
+    kui_toy_fmv_status(&trace,4u,intro_begin-20u*half-1u,KUI_GD_COMPLETED,2048u);
+    assert(intro->bins[12].requested==1u && intro->bins[12].completed==1u);
+    assert(intro->bins[12].gap==19u*half+1u && intro->end_lba==4392u);
+}
+
+static void test_pending_and_clock(void) {
+    struct kui_toy_fmv_trace trace={0};
+    struct kui_toy_fmv_movie *bumper=&trace.movie[0], *intro=&trace.movie[1];
+    const uint32_t begin=1000u;
+
+    for(uint32_t token=1u;token<=KUI_TOY_FMV_PENDING+1u;++token)
+        kui_toy_fmv_request(&trace,ranges,token,2386u,1u,begin-token);
+    assert(bumper->requests==KUI_TOY_FMV_PENDING+1u && bumper->unmatched==1u);
+    kui_toy_fmv_status(&trace,KUI_TOY_FMV_PENDING+1u,begin-8u,KUI_GD_COMPLETED,2048u);
+    assert(!bumper->acks);
+
+    kui_toy_fmv_request(&trace,ranges,2u,3386u,2u,begin-10u);
+    assert(bumper->unmatched==2u && intro->requests==1u);
+    kui_toy_fmv_status(&trace,2u,begin-11u,KUI_GD_COMPLETED,4096u);
+    assert(intro->acks==1u && intro->bins[0].completed==2u && !bumper->acks);
+
+    kui_toy_fmv_status(&trace,1u,begin+1u,KUI_GD_COMPLETED,2048u);
+    kui_toy_fmv_request(&trace,ranges,7u,2387u,1u,begin+1u);
+    assert(trace.clock_lost==2u && !bumper->acks);
+    assert(bumper->requests==KUI_TOY_FMV_PENDING+1u);
+    kui_toy_fmv_request(&trace,ranges,7u,2387u,1u,begin-13u);
+    kui_toy_fmv_status(&trace,7u,begin-14u,KUI_GD_COMPLETED,4096u);
+    assert(bumper->acks==1u && bumper->short_bytes==1u);
+    assert(bumper->bins[0].completed==1u);
+}
+
+static void test_format(void) {
+    struct kui_toy_fmv_trace trace={0};
+    struct kui_toy_fmv_movie *bumper=&trace.movie[0];
+    char guarded[KUI_TOY_REPORT_FILE_BYTES+3u];
+    memset(guarded,'!',sizeof(guarded));
+    char *const report=guarded+1u;
+    const char end[]="\nEND REPORT\n";
+    const size_t end_bytes=sizeof(end)-1u;
+
+    bumper->requests=UINT32_MAX;
+    bumper->bins[0]=(struct kui_toy_fmv_bin){UINT32_MAX,5u,781u,1562u};
+    trace.pending[0]=(struct kui_toy_fmv_pending){5u,100u,4386u,1u,1u};
+    trace.clock_lost=UINT32_MAX;
+    kui_toy_fmv_format(report,&trace,"PHYSICAL-LONG","123456789abc-extra");
+    assert(guarded[0]=='!' && report[KUI_TOY_REPORT_FILE_BYTES]=='!');
+    assert(report[KUI_TOY_REPORT_FILE_BYTES+1u]=='!');
+    assert(memcmp(report+KUI_TOY_REPORT_FILE_BYTES-end_bytes,end,end_bytes)==0);
+    report[KUI_TOY_REPORT_FILE_BYTES]='\0';
+    assert(strstr(report,"K-UI TOY FMV COMPARE V1 / PHYSICAL 123456789abc\n"));
+    assert(strstr(report,"BUMPER\nFFFF 0000 0000 0000 0000 0000 00000000 00000000\n"));
+    assert(strstr(report,"FFFF 0005 0001 0002\n"));
+    assert(strstr(report,"INTRO\n0000 0000 0000 0000 0000 0001 00000000 00000000\n"));
+    assert(strstr(report,"CLOCK LOST FFFFFFFF\n"));
+}
+
+int main(void) {
+    test_movie_bins();
+    test_pending_and_clock();
+    test_format();
+    puts("Toy FMV comparison bins, pending handles, clock and report passed");
+    return 0;
+}
diff --git a/tests/test_toy_movie_iso_stage.c b/tests/test_toy_movie_iso_stage.c
new file mode 100644
index 00000000..e50e09b0
--- /dev/null
+++ b/tests/test_toy_movie_iso_stage.c
@@ -0,0 +1,74 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include "retail_storage.h"
+#include "kui/retail_image.h"
+#include "kui/vmu_native_mode.h"
+#include "kui/vmu_launch_package.h"
+#include <assert.h>
+#include <string.h>
+
+static struct kui_retail_manifest manifest;
+static struct kui_retail_storage card;
+static struct kui_retail_image image;
+static uint8_t raw_boot[KUI_GAME_DATA_BYTES], volume[KUI_GAME_DATA_BYTES], directory[KUI_GAME_DATA_BYTES];
+static uint32_t boot_crc, exec_bytes, largest_range;
+static unsigned acquire, release;
+static bool fail_stop;
+
+static uint32_t native_runtime_mode(void) { return KUI_VMU_NATIVE_MODE_READER_ONLY; }
+enum kui_loader_sd_result kui_retail_storage_acquire(struct kui_retail_storage *s) {
+    assert(s==&card);++acquire;return KUI_LOADER_SD_OK;
+}
+enum kui_loader_sd_result kui_retail_storage_stop(struct kui_retail_storage *s) {
+    assert(s==&card);return fail_stop?KUI_LOADER_SD_TIMEOUT:KUI_LOADER_SD_OK;
+}
+void kui_retail_storage_release(struct kui_retail_storage *s) { assert(s==&card);++release; }
+enum kui_game_result kui_retail_image_read(struct kui_retail_image *img,uint32_t lba,
+    uint32_t count,enum kui_game_sector_format format,void *out,size_t bytes) {
+    assert(img==&image && count==1u && format==KUI_GAME_SECTOR_MODE1 && bytes==KUI_GAME_DATA_BYTES);
+    if(lba==45016u)memcpy(out,volume,bytes);
+    else if(lba==45020u)memcpy(out,directory,bytes);
+    else return KUI_GAME_RANGE;
+    return KUI_GAME_OK;
+}
+enum kui_game_result kui_retail_image_check_validated(const struct kui_retail_manifest *m,
+    uint32_t lba,uint32_t count,enum kui_game_sector_format format) {
+    assert(m==&manifest && format==KUI_GAME_SECTOR_MODE1 && count<=KUI_RETAIL_IMAGE_MAX_SECTORS);
+    if(count>largest_range)largest_range=count;
+    return lba>=49000u && lba+count<52000u?KUI_GAME_OK:KUI_GAME_RANGE;
+}
+#include "toy_movie_iso_stage.inc"
+
+static void dual(uint8_t *p,uint32_t value) {
+    for(unsigned i=0;i<4u;i++)p[i]=p[7u-i]=(uint8_t)(value>>(i*8u));
+}
+static unsigned record(uint8_t *p,const char *name,unsigned length,uint32_t lba,
+    uint32_t bytes,uint8_t flags) {
+    unsigned record_size=33u+length+!(length&1u);
+    memset(p,0,record_size);p[0]=record_size;p[25]=flags;p[32]=length;
+    dual(p+2,lba);dual(p+10,bytes);memcpy(p+33,name,length);
+    return record_size;
+}
+static void reset(void) {
+    memset(toy_movie_ranges,0,sizeof(toy_movie_ranges));
+    memset(volume,0,sizeof(volume));memset(directory,0,sizeof(directory));
+    manifest.reader=KUI_RETAIL_READER_ASYNC;manifest.session_lba=45000u;
+    manifest.ip_crc32=KUI_VMU_LAUNCH_TOY_IP_CRC;boot_crc=KUI_VMU_LAUNCH_TOY_EXEC_CRC;
+    exec_bytes=KUI_VMU_LAUNCH_TOY_EXEC_BYTES;
+    volume[0]=1u;memcpy(volume+1,"CD001\1",6u);volume[129]=volume[130]=8u;
+    record(volume+156,"\0",1u,45020u,2048u,2u);
+    const char bumper[]="60hz_Bumper_LRTF.avi;1",intro[]="60HZ_INTRO_LRTF.AVI";
+    unsigned next=record(directory,bumper,sizeof(bumper)-1u,49000u,130u*2048u,0u);
+    record(directory+next,intro,sizeof(intro)-1u,51000u,340u*2048u+1u,0u);
+    acquire=release=largest_range=0u;fail_stop=false;
+}
+int main(void) {
+    reset();toy_movie_scan();
+    assert(acquire==1u && release==1u && largest_range==64u);
+    assert(!toy_movie_ranges[0].count && toy_movie_ranges[1].lba==49000u && toy_movie_ranges[1].count==130u);
+    assert(!toy_movie_ranges[2].count && toy_movie_ranges[3].lba==51000u && toy_movie_ranges[3].count==341u);
+    reset();fail_stop=true;toy_movie_scan();assert(release==1u && !toy_movie_ranges[1].count);
+    reset();directory[25]=128u;toy_movie_scan();assert(release==1u && !toy_movie_ranges[1].count);
+    reset();directory[9]^=1u;toy_movie_scan();assert(release==1u && !toy_movie_ranges[1].count);
+    reset();boot_crc=0u;toy_movie_scan();assert(!acquire && !toy_movie_ranges[1].count);
+    return 0;
+}
diff --git a/tests/test_toy_sci_burst.c b/tests/test_toy_sci_burst.c
new file mode 100644
index 00000000..16c77346
--- /dev/null
+++ b/tests/test_toy_sci_burst.c
@@ -0,0 +1,242 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* Hardware model for the auxiliary transport, not a timing emulation. */
+#include "retail_async.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+enum { RA_CLOSED, RA_PAUSED, RA_DMA, RA_LOST, RA_RESUME };
+static uint32_t read_hw(uint32_t address,unsigned width);
+#include "../src/loader/toy_sci_burst.inc"
+
+static struct {
+    uint32_t smr,brr,scr,ssr,rdr,scmr,sptr,stbcr,pdtr;
+    uint32_t sar,dar,tcr,chcr,dmaor;
+    unsigned fences,writes,starts,stops,clocked,phase,command,bytes,gap,late_at;
+    bool bad_stop;
+#if KUI_TOY_SUITE_MODE == 28
+    bool refuse_slow_rate,refuse_scr_stop;
+#endif
+} hw;
+static kui_retail_async_region_type region;
+static uint8_t slab[TOY_BURST_SLAB_BYTES] __attribute__((aligned(32)));
+static uint8_t other[TOY_BURST_SLAB_BYTES] __attribute__((aligned(32)));
+
+static uint32_t *reg(uint32_t address) {
+    switch(address) {
+    case TOY_BURST_SMR: return &hw.smr;
+    case TOY_BURST_BRR: return &hw.brr;
+    case TOY_BURST_SCR: return &hw.scr;
+    case TOY_BURST_SSR: return &hw.ssr;
+    case TOY_BURST_RDR: return &hw.rdr;
+    case TOY_BURST_SCMR: return &hw.scmr;
+    case TOY_BURST_SPTR: return &hw.sptr;
+    case TOY_BURST_STBCR: return &hw.stbcr;
+    case TOY_BURST_PDTR: return &hw.pdtr;
+    case TOY_BURST_SAR: return &hw.sar;
+    case TOY_BURST_DAR: return &hw.dar;
+    case TOY_BURST_TCR: return &hw.tcr;
+    case TOY_BURST_CHCR: return &hw.chcr;
+    case TOY_BURST_DMAOR: return &hw.dmaor;
+    default: assert(false);return NULL;
+    }
+}
+static uint32_t read_hw(uint32_t address,unsigned width) {
+    (void)width;
+    return *reg(address);
+}
+void kui_toy_sci_burst_test_write(uint32_t address,unsigned width,uint32_t value) {
+    (void)width;
+    ++hw.writes;
+#if KUI_TOY_SUITE_MODE == 28
+    if(address==TOY_BURST_BRR) {
+        assert(!hw.scr);
+        if(value==1u && hw.refuse_slow_rate)return;
+    }
+    if(address==TOY_BURST_SCR && !value && hw.refuse_scr_stop)return;
+#endif
+    *reg(address)=value;
+    if(address==TOY_BURST_STBCR && (value&1u)) {
+        hw.smr=hw.scr=hw.scmr=0;
+        hw.brr=0xffu;
+        hw.ssr=0x84u;
+    }
+}
+uint32_t kui_toy_sci_burst_test_physical(const void *buffer) {
+    return buffer==slab?0x0c100000u:buffer==other?0x0c102000u:0;
+}
+void kui_toy_sci_burst_test_fence(const void *buffer) {
+    assert(buffer==slab || buffer==other);
+    ++hw.fences;
+    if(hw.fences==hw.late_at) {--hw.tcr;++hw.dar;}
+}
+
+enum { CARD_IDLE,CARD_COMMAND,CARD_STUFF,CARD_REPLY,CARD_TOKEN,CARD_PAYLOAD };
+static void card_select(void *unused,bool selected) {
+    (void)unused;
+    assert(hw.scr!=0x50u && region.engine.in_irq==0);
+    hw.pdtr=selected?0u:0x80u;
+}
+static uint8_t card_byte(void *unused,uint8_t byte,bool slow) {
+    (void)unused;
+    assert(!slow && hw.scr==0x30u && hw.brr==0u && region.engine.in_irq==0);
+    ++hw.clocked;
+    if(hw.pdtr&0x80u) return 0xffu;
+    if(hw.phase!=CARD_COMMAND && (byte==0x52u || byte==0x4cu)) {
+        hw.command=byte;
+        hw.phase=CARD_COMMAND;
+        hw.bytes=1;
+        return 0xffu;
+    }
+    switch(hw.phase) {
+    case CARD_COMMAND:
+        if(++hw.bytes==6u) {
+            if(hw.command==0x4cu) {++hw.stops;hw.phase=CARD_STUFF;}
+            else {++hw.starts;hw.phase=CARD_REPLY;}
+        }
+        return 0xffu;
+    case CARD_STUFF:
+        hw.phase=CARD_REPLY;
+        return 0xffu;
+    case CARD_REPLY:
+        hw.phase=hw.command==0x52u?CARD_TOKEN:CARD_IDLE;
+        return hw.command==0x4cu && hw.bad_stop?0x08u:0u;
+    case CARD_TOKEN:
+        if(hw.gap) {--hw.gap;return 0xffu;}
+        hw.phase=CARD_PAYLOAD;
+        return 0xfeu;
+    default:
+        return 0xffu;
+    }
+}
+static void setup(void) {
+    memset(&hw,0,sizeof(hw));
+    memset(&region,0,sizeof(region));
+    memset(slab,0,sizeof(slab));
+    hw.smr=0x80u;hw.scr=0x30u;hw.ssr=0x84u;hw.pdtr=0x80u;hw.dmaor=1u;
+    hw.sar=0x0c0a1120u;hw.dar=0x0c040020u;hw.tcr=23u;hw.chcr=0x4400u;
+    struct kui_loader_sd *card=&region.shared.card.device.sd;
+    card->blocks=1u<<19;
+    card->ready=card->high_capacity=true;
+    card->bus.select=card_select;
+    card->bus.transfer=card_byte;
+    region.shared.stream.card=card;
+    region.shared.port.acquired=true;
+    region.engine.opened=1u;
+}
+static void finished(unsigned received,unsigned planned) {
+    assert(received<=planned);
+    memset(slab,0x6c,received);
+    hw.dar=kui_toy_sci_burst_test_physical(slab)+received;
+    hw.tcr=planned-received;
+    hw.chcr=TOY_BURST_RX_DMA|(received==planned?2u:0u);
+    hw.ssr=0xe4u;
+}
+
+static void test_receive_cuts(bool slow) {
+    const unsigned bytes=15u*516u-2u;
+    uint32_t received;
+    for(unsigned length=0;length<=bytes;++length) {
+        setup();
+#if KUI_TOY_SUITE_MODE == 28
+        assert(toy_sci_burst_start_rate(&region,7123u,15u,slab,slow)==KUI_SCI_STREAM_OK);
+#else
+        assert(toy_sci_burst_start(&region,7123u,15u,slab)==KUI_SCI_STREAM_OK);
+#endif
+        assert(hw.starts==1u && hw.scr==0x50u && hw.tcr==bytes &&
+            hw.brr==(uint32_t)slow &&
+            region.shared.stream.state==KUI_TOY_SCI_BURST_DMA);
+        unsigned writes=hw.writes,clocked=hw.clocked;
+        region.engine.in_irq=1u;
+        assert(toy_sci_burst_poll(&region,slab,15u,&received)==KUI_SCI_STREAM_PENDING);
+        assert(!received && hw.writes==writes);
+        assert(toy_sci_burst_stop(&region,slab,15u)==KUI_SCI_STREAM_BUSY);
+        finished(length,bytes);
+        assert(toy_sci_burst_poll(&region,slab,15u,&received)==KUI_SCI_STREAM_OK);
+        assert(received==length && hw.fences==(length==bytes?2u:6u) && hw.clocked==clocked &&
+            hw.sar==0x0c0a1120u && hw.dar==0x0c040020u && hw.tcr==23u &&
+            hw.chcr==0x4400u && hw.scr==0x30u && hw.brr==0u && hw.pdtr==0x80u);
+        assert(region.shared.stream.stats.overruns==(length!=bytes));
+        region.engine.in_irq=0;
+        assert(toy_sci_burst_stop(&region,slab,15u)==KUI_SCI_STREAM_OK);
+        assert(hw.stops==1u && region.shared.stream.state==RA_CLOSED);
+    }
+}
+
+int main(void) {
+    const unsigned bytes=15u*516u-2u;
+    uint32_t received;
+    test_receive_cuts(false);
+#if KUI_TOY_SUITE_MODE == 28
+    test_receive_cuts(true);
+    setup();hw.gap=300u;
+    assert(toy_sci_burst_start_rate(&region,7123u,15u,slab,true)==KUI_SCI_STREAM_PENDING);
+    assert(hw.brr==0u && hw.scr==0x30u && hw.pdtr==0x80u);
+    assert(toy_sci_burst_start_rate(&region,7123u,15u,slab,true)==KUI_SCI_STREAM_OK);
+    assert(hw.starts==1u && hw.brr==1u);
+    assert(toy_sci_burst_stop(&region,slab,15u)==KUI_SCI_STREAM_RESET);
+    assert(region.shared.port.fault && hw.scr==0x30u && hw.brr==0u &&
+        hw.chcr==0x4400u && !hw.stops);
+
+    setup();hw.refuse_slow_rate=true;
+    assert(toy_sci_burst_start_rate(&region,7123u,15u,slab,true)==KUI_SCI_STREAM_RESET);
+    assert(region.shared.port.fault && hw.brr==0u && hw.scr==0x30u &&
+        hw.chcr==0x4400u && hw.pdtr==0x80u);
+
+    setup();hw.refuse_scr_stop=true;
+    assert(toy_sci_burst_start_rate(&region,7123u,15u,slab,true)==KUI_SCI_STREAM_RESET);
+    assert(region.shared.port.fault && hw.brr==0u && hw.chcr==0x4400u);
+#endif
+    setup();hw.gap=600u;
+    assert(toy_sci_burst_start(&region,7123u,15u,slab)==KUI_SCI_STREAM_PENDING);
+    assert(region.shared.stream.state==KUI_TOY_SCI_BURST_TOKEN && hw.pdtr==0x80u);
+    assert(toy_sci_burst_start(&region,7123u,15u,slab)==KUI_SCI_STREAM_PENDING);
+    assert(toy_sci_burst_start(&region,7123u,15u,slab)==KUI_SCI_STREAM_OK);
+    assert(hw.starts==1u);
+    assert(toy_sci_burst_poll(&region,other,15u,&received)==KUI_SCI_STREAM_RESET);
+    assert(!received && region.shared.stream.state==KUI_TOY_SCI_BURST_DMA);
+    finished(1536u,bytes);
+    assert(toy_sci_burst_poll(&region,slab,15u,&received)==KUI_SCI_STREAM_OK);
+    assert(received==1536u);
+    hw.bad_stop=true;
+    assert(toy_sci_burst_stop(&region,slab,15u)==KUI_SCI_STREAM_RESET);
+    assert(region.shared.port.fault && hw.pdtr==0x80u);
+    assert(toy_sci_burst_start(&region,7126u,15u,slab)==KUI_SCI_STREAM_RESET);
+    assert(hw.starts==1u);
+
+    setup();
+    assert(toy_sci_burst_start(&region,7123u,15u,slab)==KUI_SCI_STREAM_OK);
+    finished(1535u,bytes);hw.late_at=4u;
+    assert(toy_sci_burst_poll(&region,slab,15u,&received)==KUI_SCI_STREAM_OK);
+    assert(received==1536u && hw.fences==8u && hw.dar==0x0c040020u);
+    setup();hw.chcr=0x4401u;
+    assert(toy_sci_burst_start(&region,7123u,15u,slab)==KUI_SCI_STREAM_PENDING);
+    assert(!hw.writes && !hw.clocked);
+    setup();
+    assert(toy_sci_burst_start(&region,7123u,16u,slab)==KUI_SCI_STREAM_RESET);
+    assert(!hw.writes && !hw.clocked);
+    setup();
+    assert(toy_sci_burst_start(&region,7123u,15u,slab)==KUI_SCI_STREAM_OK);
+    hw.sar=0x0c0fedccu;hw.chcr=0x6401u;hw.ssr=0xe4u;
+    assert(toy_sci_burst_poll(&region,slab,15u,&received)==KUI_SCI_STREAM_RESET);
+    assert(!received && hw.sar==0x0c0fedccu && hw.chcr==0x6401u && region.shared.port.fault);
+    setup();
+    assert(toy_sci_burst_start(&region,7123u,15u,slab)==KUI_SCI_STREAM_OK);
+    finished(1024u,bytes);++hw.tcr;
+    assert(toy_sci_burst_poll(&region,slab,15u,&received)==KUI_SCI_STREAM_RESET);
+    assert(!received && region.shared.port.fault && !(hw.chcr&1u));
+    setup();
+    assert(toy_sci_burst_start(&region,7123u,15u,slab)==KUI_SCI_STREAM_OK);
+    finished(1024u,bytes);hw.ssr=0xd4u;
+    assert(toy_sci_burst_poll(&region,slab,15u,&received)==KUI_SCI_STREAM_RESET);
+    assert(!received && region.shared.port.fault && !(hw.chcr&1u) && !hw.stops);
+    setup();
+    assert(toy_sci_burst_start(&region,7123u,15u,slab)==KUI_SCI_STREAM_OK);
+    assert(toy_sci_burst_stop(&region,slab,15u)==KUI_SCI_STREAM_RESET);
+    assert(region.shared.port.fault && hw.scr==0x30u && !(hw.chcr&1u) && !hw.stops);
+    puts("Toy SCI burst transport passed all 7,739 prefix cuts, PIO-free IRQ retirement, sliced token, owned restore, bad count/stop, foreign DMA and stalled cancellation");
+#if KUI_TOY_SUITE_MODE == 28
+    puts("6.25 MHz receive passed all 7,739 cuts, token wait, cancellation, and rate-transition refusals");
+#endif
+    return 0;
+}
diff --git a/tests/test_toy_suite_ram_stage.c b/tests/test_toy_suite_ram_stage.c
new file mode 100644
index 00000000..0fe5993d
--- /dev/null
+++ b/tests/test_toy_suite_ram_stage.c
@@ -0,0 +1,74 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include "kui/native_readahead_layout.h"
+#include "kui/retail_image.h"
+#include "kui/toy_movie_trace.h"
+#include "retail_storage.h"
+#include <assert.h>
+#include <string.h>
+
+static struct kui_retail_manifest manifest;
+static struct kui_retail_storage card;
+static struct kui_toy_movie_range toy_movie_ranges[4];
+static struct kui_toy_suite_seed toy_suite_seed;
+static uint8_t toy_suite_data[KUI_NATIVE_RA_DATA_BYTES];
+static uint8_t original[KUI_NATIVE_RA_DATA_BYTES];
+static uint32_t first_block,reads,fail_at;
+
+enum kui_loader_sd_result kui_retail_storage_read_run(struct kui_retail_storage *storage,
+    uint32_t lba,uint32_t available,uint8_t out[512]) {
+    assert(storage==&card);
+    if(++reads==fail_at)return KUI_LOADER_SD_CRC;
+    for(unsigned i=2u;i<=3u;i++) {
+        const struct kui_retail_extent *extent=&manifest.slots[i].extent;
+        uint32_t offset=lba-extent->card_lba;
+        if(offset<extent->blocks) {
+            assert(available<=extent->blocks-offset);
+            memcpy(out,original+(extent->file_block+offset-first_block)*512u,512u);
+            return KUI_LOADER_SD_OK;
+        }
+    }
+    assert(false);
+    return KUI_LOADER_SD_ARGUMENT;
+}
+
+#include "toy_suite_ram_stage.inc"
+
+static void raw_sector(uint8_t *sector,uint32_t lba) {
+    memset(sector,0,KUI_GAME_RAW_BYTES);
+    memset(sector+1u,0xff,10u);
+    uint32_t fad=lba+150u;
+    unsigned fields[3]={fad/4500u,(fad/75u)%60u,fad%75u};
+    for(unsigned i=0u;i<3u;i++)sector[12u+i]=(uint8_t)((fields[i]/10u)*16u+fields[i]%10u);
+    sector[15]=1u;
+    for(unsigned i=16u;i<16u+KUI_GAME_DATA_BYTES;i++)sector[i]=(uint8_t)(lba+i);
+    uint32_t edc=kui_cd_edc(sector,16u+KUI_GAME_DATA_BYTES);
+    for(unsigned i=0u;i<4u;i++)sector[16u+KUI_GAME_DATA_BYTES+i]=(uint8_t)(edc>>(8u*i));
+}
+
+int main(void) {
+    const uint32_t center=KUI_TOY_SUITE_MODE==2?469080u:468128u;
+    const uint32_t first=center-40u,last=center+40u,track_start=45000u;
+    const uint32_t first_byte=(first-track_start)*KUI_GAME_RAW_BYTES+17u;
+    first_block=first_byte/512u;
+    uint32_t blocks=((last-track_start)*KUI_GAME_RAW_BYTES+17u+511u)/512u-first_block;
+    manifest.slots[0].track=(struct kui_retail_track){track_start,last+100u,1u|(17u<<8),3u,4u};
+    manifest.slots[1].extent=(struct kui_retail_extent){0u,1000u,first_block};
+    manifest.slots[2].extent=(struct kui_retail_extent){first_block,2000000u,111u};
+    manifest.slots[3].extent=(struct kui_retail_extent){first_block+111u,3000000u,blocks-111u};
+    toy_movie_ranges[3]=(struct kui_toy_movie_range){452810u,26208u};
+    for(uint32_t n=0u;n<last-first;n++)
+        raw_sector(original+(first_byte&511u)+n*KUI_GAME_RAW_BYTES,first+n);
+    const struct kui_retail_track *track=&manifest.slots[0].track;
+    assert(toy_suite_ram_seed(track));
+    assert(toy_suite_seed.base[0]==2000000u && toy_suite_seed.count[0]==111u);
+    assert(toy_suite_seed.base[1]==3000000u && toy_suite_seed.count[1]==blocks-111u);
+    assert(reads==blocks && !memcmp(toy_suite_data,original,blocks*512u));
+
+    memset(&toy_suite_seed,0,sizeof(toy_suite_seed));
+    reads=0u;fail_at=137u;
+    assert(!toy_suite_ram_seed(track) && !toy_suite_seed.count[0] && reads==fail_at);
+    reads=fail_at=0u;original[(first_byte&511u)+31u]^=1u;
+    assert(!toy_suite_ram_seed(track) && !toy_suite_seed.count[0] && reads==blocks);
+    reads=0u;--toy_movie_ranges[3].count;
+    assert(!toy_suite_ram_seed(track) && !reads);
+}
diff --git a/tests/test_toy_suite_witness.c b/tests/test_toy_suite_witness.c
new file mode 100644
index 00000000..e74f67d9
--- /dev/null
+++ b/tests/test_toy_suite_witness.c
@@ -0,0 +1,114 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include "kui/hash.h"
+#include "kui/native_readahead.h"
+#include "kui/toy_suite_witness.h"
+#include <assert.h>
+#include <string.h>
+
+static struct kui_retail_image image;
+static struct kui_retail_manifest manifest;
+static struct kui_toy_movie_range toy_movie_ranges[4];
+static struct kui_toy_suite_seed toy_suite_seed;
+static _Alignas(32) uint8_t toy_suite_data[KUI_NATIVE_RA_DATA_BYTES];
+static uint8_t raw_boot[16u*KUI_GAME_RAW_BYTES];
+static uint32_t bad_edc_lba,bad_fad_lba;
+static bool cooked;
+
+static uint8_t bcd(unsigned n) { return (uint8_t)((n/10u)*16u+n%10u); }
+static uint8_t data_byte(uint32_t lba,unsigned byte) { return (uint8_t)(lba+byte*7u); }
+enum kui_game_result kui_retail_image_read(struct kui_retail_image *p,
+    uint32_t lba,uint32_t count,enum kui_game_sector_format format,void *out,size_t bytes) {
+    assert(p==&image && count && count<=16u && format==KUI_GAME_SECTOR_RAW &&
+           out==raw_boot && bytes==count*KUI_GAME_RAW_BYTES);
+    if(cooked)return KUI_GAME_UNSUPPORTED;
+    for(uint32_t i=0u;i<count;i++) {
+        uint8_t *raw=raw_boot+i*KUI_GAME_RAW_BYTES;
+        uint32_t here=lba+i,fad=here+150u+(here==bad_fad_lba);
+        memset(raw,0,KUI_GAME_RAW_BYTES);
+        memset(raw+1u,255,10u);
+        raw[12]=bcd(fad/4500u); raw[13]=bcd((fad/75u)%60u); raw[14]=bcd(fad%75u); raw[15]=1u;
+        for(unsigned byte=0u;byte<KUI_GAME_DATA_BYTES;byte++)raw[16u+byte]=data_byte(here,byte);
+        uint32_t edc=kui_cd_edc(raw,16u+KUI_GAME_DATA_BYTES);
+        for(unsigned j=0u;j<4u;j++)raw[16u+KUI_GAME_DATA_BYTES+j]=(uint8_t)(edc>>(j*8u));
+        if(here==bad_edc_lba)raw[16u]^=1u;
+    }
+    return KUI_GAME_OK;
+}
+#include "toy_suite_witness_stage.inc"
+
+static struct {
+    struct kui_native_ra_config config;
+    uint32_t suite[5];
+} C;
+static _Alignas(32) uint8_t guest[4u*KUI_GAME_DATA_BYTES];
+static const uint32_t guest_p1=UINT32_C(0x8c200000);
+static unsigned observed_reads;
+const uint8_t *kui_toy_witness_test_read(uint32_t p2) {
+    uint32_t at=p2-(guest_p1|UINT32_C(0x20000000));
+    assert(at<=sizeof(guest)-KUI_GAME_DATA_BYTES);
+    ++observed_reads;
+    return guest+at;
+}
+#include "toy_suite_witness.inc"
+
+static void completed(kui_retail_async_region_type *r,uint32_t lba,uint32_t count,unsigned align) {
+    memset(r,0,sizeof(*r));
+    struct kui_retail_gd *s=&r->shared.service;
+    struct kui_retail_async *e=&r->engine;
+    s->initialized=1u;s->status=KUI_GD_COMPLETED;s->command=align?KUI_GD_PIOREAD:KUI_GD_DMAREAD;
+    s->lba=lba;s->count=count;s->token=1u;s->sector_bytes=KUI_GAME_DATA_BYTES;
+    s->destination=guest_p1+align;s->guest_begin=guest_p1;s->guest_end=guest_p1+sizeof(guest);
+    s->request_bytes=s->completed_bytes=count*KUI_GAME_DATA_BYTES;
+    e->token=s->token;e->destination=s->destination;e->manifest=e->cursor.manifest=&manifest;
+    e->cursor.lba=lba;e->cursor.count=e->cursor.done=count;
+    for(uint32_t sector=0u;sector<count;sector++)
+        for(unsigned byte=0u;byte<KUI_GAME_DATA_BYTES;byte++)
+            guest[align+sector*KUI_GAME_DATA_BYTES+byte]=data_byte(lba+sector,byte);
+}
+
+int main(void) {
+    toy_movie_ranges[3]=(struct kui_toy_movie_range){460000u,12000u};
+    bad_edc_lba=UINT32_C(0x72858);
+    assert(!toy_suite_witness_seed() && !toy_suite_seed.count[0] && !toy_suite_seed.count[1]);
+    bad_edc_lba=0u;bad_fad_lba=UINT32_C(0x724a0);
+    assert(!toy_suite_witness_seed() && !toy_suite_seed.count[0]);
+    bad_fad_lba=0u;cooked=true;
+    assert(!toy_suite_witness_seed() && !toy_suite_seed.count[0]);
+    cooked=false;assert(toy_suite_witness_seed());
+    assert(toy_suite_seed.count[0]==48u && toy_suite_seed.count[1]==48u);
+    C.config.suite_seed=toy_suite_seed;C.config.data=toy_suite_data;
+    C.config.lease=UINT32_C(0x0c500000);C.config.lease_bytes=KUI_NATIVE_RA_LEASE_BYTES;
+
+    kui_retail_async_region_type region;
+    completed(&region,toy_suite_seed.base[0]-1u,3u,0u);
+    toy_suite_witness_complete(&region);
+    assert(C.suite[1]==2u && observed_reads==2u && !C.suite[2]);
+    completed(&region,toy_suite_seed.base[0]+48u,1u,0u);
+    toy_suite_witness_complete(&region);
+    assert(C.suite[1]==2u && observed_reads==2u);
+
+    const uint32_t lba=toy_suite_seed.base[1]+5u;
+    const unsigned byte=KUI_GAME_DATA_BYTES-7u;
+    completed(&region,lba,2u,2u);
+    guest[2u+byte]^=0xa0u;
+    toy_suite_witness_complete(&region);
+    assert(C.suite[1]==4u && observed_reads==4u && C.suite[2]==lba && C.suite[3]==byte &&
+           C.suite[4]==((uint32_t)data_byte(lba,byte)<<8|guest[2u+byte]));
+
+    for(unsigned invalid=0u;invalid<6u;invalid++) {
+        completed(&region,lba,1u,0u);
+        struct kui_retail_gd *s=&region.shared.service;
+        switch(invalid) {
+        case 0u:s->status=KUI_GD_FAILED;break;
+        case 1u:s->completed_bytes--;break;
+        case 2u:s->token++;break;
+        case 3u:s->guest_end=guest_p1+1u;break;
+        case 4u:C.config.lease=guest_p1&UINT32_C(0x1fffffff);break;
+        case 5u:region.engine.native_loan_state=1u;break;
+        }
+        toy_suite_witness_complete(&region);
+        assert(C.suite[1]==4u && observed_reads==4u);
+        C.config.lease=UINT32_C(0x0c500000);
+    }
+    return 0;
+}
