diff --git a/src/loader/toy_fmv_compare.c b/src/loader/toy_fmv_compare.c
new file mode 100644
index 00000000..6fa63b71
--- /dev/null
+++ b/src/loader/toy_fmv_compare.c
@@ -0,0 +1,139 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include "kui/toy_fmv_compare.h"
+#include "kui/gd_service.h"
+#include <string.h>
+
+static struct kui_toy_fmv_bin *bin_at(struct kui_toy_fmv_movie *movie, uint32_t tick) {
+    uint32_t elapsed=movie->first_tick-tick;
+    unsigned bin=0u;
+    while(bin+1u<KUI_TOY_FMV_BINS && elapsed>=KUI_TOY_FMV_BIN_TICKS) {
+        elapsed-=KUI_TOY_FMV_BIN_TICKS;
+        ++bin;
+    }
+    return &movie->bins[bin];
+}
+
+void kui_toy_fmv_request(struct kui_toy_fmv_trace *trace, const struct kui_toy_movie_range ranges[4],
+    uint32_t token, uint32_t lba, uint32_t sectors, uint32_t tick) {
+    if(!token || !sectors) return;
+    unsigned variant=0u;
+    for(;variant<4u;++variant) {
+        const struct kui_toy_movie_range *range=&ranges[variant];
+        /* Toy reads the AVI headers through sector 385 before streaming. */
+        if(lba>=range->lba && lba-range->lba>=386u && lba-range->lba<range->count) break;
+    }
+    if(variant==4u) return;
+    struct kui_toy_fmv_movie *movie=&trace->movie[variant/2u];
+    if(!movie->requests) movie->first_tick=tick;
+    if(movie->first_tick-tick>=UINT32_C(0x80000000)) {
+        ++trace->clock_lost;
+        return;
+    }
+    ++movie->requests;
+    movie->last_lba=lba;
+    bin_at(movie,tick)->requested+=sectors;
+    struct kui_toy_fmv_pending *slot=NULL;
+    for(unsigned i=0u;i<KUI_TOY_FMV_PENDING;++i) {
+        struct kui_toy_fmv_pending *pending=&trace->pending[i];
+        if(pending->token==token) {
+            slot=pending;
+            ++trace->movie[pending->movie].unmatched;
+            break;
+        }
+        if(!pending->token && !slot) slot=pending;
+    }
+    if(slot) *slot=(struct kui_toy_fmv_pending){token,tick,lba,sectors,variant/2u};
+    else ++movie->unmatched;
+}
+
+void kui_toy_fmv_status(struct kui_toy_fmv_trace *trace, uint32_t token, uint32_t tick,
+    int32_t status, uint32_t bytes) {
+    if(!token || (status!=KUI_GD_COMPLETED && status!=KUI_GD_FAILED)) return;
+    for(unsigned i=0u;i<KUI_TOY_FMV_PENDING;++i) {
+        struct kui_toy_fmv_pending *pending=&trace->pending[i];
+        if(pending->token!=token) continue;
+        pending->token=0u;
+        struct kui_toy_fmv_movie *movie=&trace->movie[pending->movie];
+        uint32_t elapsed=pending->tick-tick;
+        if(elapsed>=UINT32_C(0x80000000) || movie->first_tick-tick>=UINT32_C(0x80000000)) {
+            ++trace->clock_lost;
+            return;
+        }
+        struct kui_toy_fmv_bin *bin=bin_at(movie,tick);
+        if(elapsed>bin->longest) bin->longest=elapsed;
+        if(movie->acks) {
+            uint32_t gap=movie->last_ack-tick;
+            if(gap>bin->gap) bin->gap=gap;
+        }
+        ++movie->acks;
+        movie->last_ack=tick;
+        if(status==KUI_GD_FAILED) ++movie->failed;
+        else {
+            /* Status word 2 is the number of bytes reported by GD CHECK.
+             * DATA reads for this comparison are logical 2048-byte sectors. */
+            uint32_t sectors=bytes/2048u;
+            if(sectors!=pending->sectors || bytes%2048u) ++movie->short_bytes;
+            if(sectors>pending->sectors) sectors=pending->sectors;
+            bin->completed+=sectors;
+            if(sectors) movie->end_lba=pending->lba+sectors;
+        }
+        return;
+    }
+}
+
+static void append(char **at, const char *text) {
+    while(*text) *(*at)++=*text++;
+}
+
+static void hex(char **at, uint32_t value, unsigned digits) {
+    if(digits==4u && value>UINT32_C(0xffff)) value=UINT32_C(0xffff);
+    while(digits) {
+        --digits;
+        *(*at)++="0123456789ABCDEF"[(value>>(digits*4u))&15u];
+    }
+}
+
+static uint32_t milliseconds(uint32_t ticks) {
+    return (ticks/3125u)*4u+((ticks%3125u)*4u+3124u)/3125u;
+}
+
+void kui_toy_fmv_format_bin(char text[KUI_TOY_FMV_BIN_TEXT_BYTES], const struct kui_toy_fmv_bin *bin) {
+    char *at=text;
+    hex(&at,bin->requested,4u);*at++=' ';
+    hex(&at,bin->completed,4u);*at++=' ';
+    hex(&at,milliseconds(bin->longest),4u);*at++=' ';
+    hex(&at,milliseconds(bin->gap),4u);
+}
+
+void kui_toy_fmv_format(char text[KUI_TOY_REPORT_FILE_BYTES], const struct kui_toy_fmv_trace *trace,
+    const char *source, const char *build) {
+    char *at=text;
+    memset(text,' ',KUI_TOY_REPORT_FILE_BYTES);
+    append(&at,"K-UI TOY FMV COMPARE V1 / ");
+    for(unsigned i=0u;i<8u && source[i];++i) *at++=source[i];
+    *at++=' ';
+    for(unsigned i=0u;i<12u && build[i];++i) *at++=build[i];
+    append(&at,"\nHEX / FIRST STREAM REQUEST = 0 / 500 MS BINS / LAST BIN 6S+\n");
+    append(&at,"REQ ACK FAIL SIZE UNMATCHED OPEN LAST_LBA ACK_END_LBA\n");
+    append(&at,"PER BIN: REQ_SECT ACK_SECT MAX_REQ_MS MAX_ACK_GAP_MS\n");
+    for(unsigned i=0u;i<2u;++i) {
+        const struct kui_toy_fmv_movie *movie=&trace->movie[i];
+        append(&at,i?"INTRO\n":"BUMPER\n");
+        uint32_t open=0u;
+        for(unsigned j=0u;j<KUI_TOY_FMV_PENDING;++j)
+            if(trace->pending[j].token && trace->pending[j].movie==i) ++open;
+        const uint32_t values[]={movie->requests,movie->acks,movie->failed,movie->short_bytes,
+            movie->unmatched,open,movie->last_lba,movie->end_lba};
+        for(unsigned j=0u;j<8u;++j) {
+            hex(&at,values[j],j<6u?4u:8u);
+            *at++=j==7u?'\n':' ';
+        }
+        for(unsigned j=0u;j<KUI_TOY_FMV_BINS;++j) {
+            kui_toy_fmv_format_bin(at,&movie->bins[j]);
+            at+=KUI_TOY_FMV_BIN_TEXT_BYTES;
+            *at++='\n';
+        }
+    }
+    append(&at,"CLOCK LOST ");hex(&at,trace->clock_lost,8u);*at++='\n';
+    memcpy(text+KUI_TOY_REPORT_FILE_BYTES-12u,"\nEND REPORT\n",12u);
+}
diff --git a/src/loader/toy_header_replay.inc b/src/loader/toy_header_replay.inc
new file mode 100644
index 00000000..205f48e0
--- /dev/null
+++ b/src/loader/toy_header_replay.inc
@@ -0,0 +1,119 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* This is a one-sector replay of admitted AVI data. It owns neither SCI
+ * nor the guest destination. The normal cursor and GD service still publish
+ * the original read's verified bytes and both requests' terminal status. */
+static void header_invalidate(void) {
+    C.header.token=0u;
+    C.header.valid=false;
+}
+
+static void header_write(void *unused,uint32_t offset,const uint8_t *bytes,uint32_t count) {
+    (void)unused;
+    C.header.write(C.header.context,offset,bytes,count);
+    if(offset!=C.header.written || offset>KUI_GAME_DATA_BYTES || count>KUI_GAME_DATA_BYTES-offset) {
+        C.header.written=UINT16_MAX;
+        return;
+    }
+    if(!offset)C.header.first_chunk=(uint16_t)count;
+    memcpy(C.header.data+offset,bytes,count);
+    C.header.written+=(uint16_t)count;
+}
+
+static unsigned header_request(const kui_retail_async_region_type *r) {
+    const struct kui_retail_gd *s=&r->shared.service;
+    const struct kui_retail_async *e=&r->engine;
+    const struct kui_retail_cursor *c=&e->cursor;
+    /* The matched active native GD token owns the initialized cursor for
+     * this exact request. Its read mode and count come from the same GD state. */
+    if(!e->active || e->failed || !s->pending || !s->token || e->token!=s->token ||
+       !r->shared.port.acquired || r->shared.port.fault ||
+       s->count!=1u || s->sector_bytes!=KUI_GAME_DATA_BYTES)return 0u;
+#if KUI_NATIVE_SESSION_CONTROLS
+    if(s->disc_lid!=KUI_RETAIL_DISC_READY || s->disc_generation!=e->disc_generation)return 0u;
+#endif
+    const struct kui_retail_track *track=&c->manifest->slots[c->track].track;
+    return kui_retail_track_sector_bytes(track)==KUI_GAME_RAW_BYTES &&
+        kui_retail_track_header_bytes(track)==16u?movie_variant(s):0u;
+}
+
+static void header_publish(const kui_retail_async_region_type *r) {
+    const struct kui_retail_gd *s=&r->shared.service;
+    const struct kui_retail_async *e=&r->engine;
+    if(s->token!=C.header.token)return;
+    if(!s->token || s->status!=KUI_GD_COMPLETED || s->pending || s->error ||
+       s->completed_bytes!=KUI_GAME_DATA_BYTES || e->failed || e->token!=s->token ||
+       e->cursor.done!=1u || C.header.written!=KUI_GAME_DATA_BYTES) {
+        header_invalidate();
+        return;
+    }
+    C.header.last_block=e->cursor.block;
+    C.header.stream_position=r->shared.stream.position;
+    C.header.valid=true;
+}
+
+static bool header_replay(kui_retail_async_region_type *r,unsigned variant) {
+    struct kui_retail_async *e=&r->engine;
+    struct kui_retail_cursor *c=&e->cursor;
+    const struct kui_retail_gd *s=&r->shared.service;
+    /* A repeat keeps the parked card stream at its forward position. An
+     * in-flight or uncertain reception belongs to the usual demand path. */
+    if(!C.header.valid || s->token!=C.header.token+1u || s->lba!=C.header.lba ||
+       s->sector_part!=C.header.sector_part ||
+       s->track_type!=C.header.track_type || c->manifest!=C.header.manifest ||
+       c->offset || C.spec_owned || C.quiesced ||
+       r->shared.stream.state!=RA_PAUSED || r->shared.stream.position!=C.header.stream_position ||
+       C.config.ops->busy())return false;
+#if KUI_NATIVE_SESSION_CONTROLS
+    if(s->disc_generation!=C.header.disc_generation)return false;
+#endif
+    C.header.token=s->token;
+    C.header.valid=false;
+    /* The cursor emits payload from one 512-byte card block per callback. */
+    uint32_t count=C.header.first_chunk;
+    for(uint32_t offset=0u;offset<KUI_GAME_DATA_BYTES;count=512u) {
+        if(count>KUI_GAME_DATA_BYTES-offset)count=KUI_GAME_DATA_BYTES-offset;
+        c->write(c->context,offset,C.header.data+offset,count);
+        if(e->failed) {
+            e->active=0u;
+            header_invalidate();
+            return true;
+        }
+        offset+=count;
+    }
+    c->block=C.header.last_block;c->done=1u;
+    demand_complete(r);
+    /* This demand consumed no card blocks. Preserve the existing physical
+     * cache seed and let ordinary progress publish the new GD handle. */
+    C.have_completed=1u;C.completed_token=e->token;
+    ++C.playback[(variant-1u)/2u].replayed;
+    return true;
+}
+
+static void header_deliver(uint32_t wait,kui_retail_async_region_type *r) {
+    const struct kui_retail_gd *s=&r->shared.service;
+    struct kui_retail_cursor *c=&r->engine.cursor;
+    unsigned variant=header_request(r);
+    if(!variant) {
+        /* An accepted unrelated request advances the token. CHECK consumes
+         * the command but leaves COMPLETED; INIT/RESET clears that status. */
+        if(s->status!=KUI_GD_COMPLETED || s->token!=C.header.token || s->pending ||
+           r->engine.failed || r->shared.port.fault)header_invalidate();
+        deliver(wait,r);
+        return;
+    }
+    if(s->token!=C.header.token) {
+        if(header_replay(r,variant))return;
+        C.header.valid=false;C.header.token=s->token;
+        C.header.lba=s->lba;
+        C.header.sector_part=s->sector_part;C.header.track_type=s->track_type;
+        C.header.manifest=c->manifest;
+#if KUI_NATIVE_SESSION_CONTROLS
+        C.header.disc_generation=s->disc_generation;
+#endif
+        C.header.written=0u;
+    }
+    C.header.write=c->write;C.header.context=c->context;
+    c->write=header_write;c->context=NULL;
+    deliver(wait,r);
+    c->write=C.header.write;c->context=C.header.context;
+}
diff --git a/src/loader/toy_movie_exit_hook.inc b/src/loader/toy_movie_exit_hook.inc
new file mode 100644
index 00000000..228e2d16
--- /dev/null
+++ b/src/loader/toy_movie_exit_hook.inc
@@ -0,0 +1,424 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include "kui/toy_movie_exit.h"
+
+#define TOY_INTRO_OPEN_POLICY (KUI_TOY_SUITE_MODE == 54 || KUI_TOY_SUITE_MODE == 56)
+#define TOY_MOVIE_OUTPUT_WITNESS (KUI_TOY_SUITE_MODE >= 49 && KUI_TOY_SUITE_MODE <= 62)
+#define TOY_MOVIE_PRESENT_WITNESS (KUI_TOY_SUITE_MODE >= 60 && KUI_TOY_SUITE_MODE <= 62)
+
+/* Installed at the exact original movie-update pointer. Tail-call the
+ * original for every untracked caller. Capture start and first terminal
+ * results using the existing uncached auxiliary context. The intro-buffer
+ * profiles consider available space only at the original start call. */
+    .section .text.toy_movie_exit,"ax"
+    .balign 4
+    .global C_SYMBOL(kui_toy_movie_exit_hook)
+    .type C_SYMBOL(kui_toy_movie_exit_hook),@function
+C_SYMBOL(kui_toy_movie_exit_hook):
+    movt r7
+    sts pr,r1
+    mov.l .Lexit_start_return,r2
+    cmp/eq r2,r1
+    bf .Lexit_maybe_update
+    mov.w .Lexit_start_cmd,r2
+    cmp/eq r2,r5
+#if TOY_INTRO_OPEN_POLICY
+    bf .Lexit_tail_jump
+    bra .Lexit_opening_buffer
+    nop
+.Lexit_tail_jump:
+#else
+    bt .Lexit_call
+#endif
+    bra .Lexit_tail
+    nop
+.Lexit_maybe_update:
+    mov.l .Lexit_update_return,r2
+    cmp/eq r2,r1
+    bf .Lexit_maybe_followup
+    tst r5,r5
+    bt .Lexit_call
+    bra .Lexit_check_stop
+    nop
+.Lexit_maybe_followup:
+    mov.l .Lexit_followup_return,r2
+    cmp/eq r2,r1
+#if TOY_INTRO_OPEN_POLICY
+    bf .Lexit_tail_jump
+#elif TOY_MOVIE_PRESENT_WITNESS
+    bf .Lexit_tail_short
+#else
+    bf .Lexit_tail
+#endif
+.Lexit_check_stop:
+    mov #4,r2
+    cmp/eq r2,r5
+#if TOY_INTRO_OPEN_POLICY
+    bf .Lexit_tail_jump
+#elif TOY_MOVIE_PRESENT_WITNESS
+    bt .Lexit_call
+.Lexit_tail_short:
+    bra .Lexit_tail
+    nop
+#else
+    bf .Lexit_tail
+#endif
+.Lexit_call:
+#if TOY_INTRO_OPEN_POLICY
+    mov #0,r2
+.Lexit_call_marked:
+#endif
+    mov.l r4,@-r15
+    mov.l r5,@-r15
+    sts.l pr,@-r15
+#if TOY_INTRO_OPEN_POLICY
+    mov.l r2,@-r15
+#else
+    add #-4,r15
+#endif
+    mov.l .Lexit_original,r1
+    jsr @r1
+    shlr r7
+    movt r7
+#if TOY_INTRO_OPEN_POLICY
+    mov.l @r15+,r2
+    or r2,r7
+#else
+    add #4,r15
+#endif
+    lds.l @r15+,pr
+    mov.l @r15+,r5
+    mov.l @r15+,r4
+    mov.w .Lexit_start_cmd,r2
+    cmp/eq r2,r5
+    bt/s .Lexit_name
+    mov #KUI_TOY_MOVIE_EXIT_STARTED,r6
+    mov #KUI_TOY_MOVIE_EXIT_TERMINAL,r6
+    cmp/pz r0
+    bf .Lexit_name
+    mov.w .Lexit_stop_status,r2
+    cmp/eq r2,r0
+    bf .Lexit_done
+.Lexit_name:
+    mov.w .Lexit_name_offset,r1
+    add r4,r1
+    mov.l @r1+,r3
+    mov.l .Lexit_name_ntsc,r2
+    cmp/eq r2,r3
+    bt .Lexit_movie
+    mov.l .Lexit_name_pal,r2
+    cmp/eq r2,r3
+    bf .Lexit_done
+.Lexit_movie:
+    mov.l @r1+,r3
+    mov.l .Lexit_bumper1,r2
+    cmp/eq r2,r3
+    bf .Lexit_intro
+    mov.l @r1+,r3
+    mov.l .Lexit_bumper2,r2
+    cmp/eq r2,r3
+    bf .Lexit_done
+    mov.l @r1+,r3
+    mov.l .Lexit_bumper3,r2
+    cmp/eq r2,r3
+    bf .Lexit_done
+    mov.l @r1+,r3
+    mov.l .Lexit_bumper4,r2
+    cmp/eq r2,r3
+    bf .Lexit_done
+    mov.b @r1,r3
+    tst r3,r3
+    bf .Lexit_done
+    mov.l .Lexit_witness,r2
+    bra .Lexit_record
+    nop
+.Lexit_intro:
+    mov.l .Lexit_intro1,r2
+    cmp/eq r2,r3
+    bf .Lexit_done
+    mov.l @r1+,r3
+    mov.l .Lexit_intro2,r2
+    cmp/eq r2,r3
+    bf .Lexit_done
+    mov.l @r1+,r3
+    mov.l .Lexit_intro3,r2
+    cmp/eq r2,r3
+    bf .Lexit_done
+    mov.l @r1,r3
+    mov.l .Lexit_intro4,r2
+    cmp/eq r2,r3
+    bf .Lexit_done
+    mov.l .Lexit_witness,r2
+    add #KUI_TOY_MOVIE_EXIT_BYTES,r2
+.Lexit_record:
+    mov.l @r2,r1
+    mov #KUI_TOY_MOVIE_EXIT_STARTED,r3
+    cmp/eq r3,r6
+    bf .Lexit_terminal
+    tst r1,r1
+    bf .Lexit_done
+    mov.l r0,@(4,r2)
+#if TOY_INTRO_OPEN_POLICY
+    mov r7,r3
+#if KUI_TOY_SUITE_MODE == 56
+    mov #KUI_TOY_MOVIE_EXIT_MORE_PREFILL,r1
+#else
+    mov #KUI_TOY_MOVIE_EXIT_LARGER_BUFFER,r1
+#endif
+    and r1,r3
+    or r3,r6
+    mov #1,r3
+    and r3,r7
+#endif
+#if !TOY_MOVIE_OUTPUT_WITNESS
+    mov.w .Lexit_frame_offset,r3
+    add r4,r3
+    mov.l @r3,r3
+    mov.l r3,@(8,r2)
+    mov.w .Lexit_sample_offset,r3
+    add r4,r3
+    mov.l @r3,r3
+    mov.l r3,@(12,r2)
+#endif
+#if TOY_MOVIE_PRESENT_WITNESS
+    mov.l r6,@r2
+    bra .Lexit_present_boundary
+    nop
+#else
+    bra .Lexit_done
+    mov.l r6,@r2
+#endif
+.Lexit_terminal:
+    tst r3,r1
+    bt .Lexit_done
+    tst r6,r1
+    bf .Lexit_done
+    or r6,r1
+    mov #KUI_TOY_MOVIE_EXIT_INPUT_STOP,r3
+    cmp/eq r3,r5
+    bf .Lexit_terminal_fields
+    sts pr,r6
+    mov.l .Lexit_followup_return,r3
+    cmp/eq r3,r6
+    bf/s .Lexit_publish_stop_kind
+    mov #KUI_TOY_MOVIE_EXIT_INPUT_STOP,r3
+    mov #KUI_TOY_MOVIE_EXIT_FOLLOWUP_STOP,r3
+.Lexit_publish_stop_kind:
+    or r3,r1
+.Lexit_terminal_fields:
+    mov.l r0,@(16,r2)
+#if TOY_MOVIE_OUTPUT_WITNESS
+    /* These are the owner's output-callback and no-output advance
+     * counters, separate from its overall frame cursor. */
+    mov.w .Lexit_output_offset,r3
+    add r4,r3
+    mov.l @r3,r3
+    mov.l r3,@(8,r2)
+    mov.w .Lexit_skip_offset,r3
+    add r4,r3
+    mov.l @r3,r3
+    mov.l r3,@(12,r2)
+#endif
+    mov.w .Lexit_frame_offset,r3
+    add r4,r3
+    mov.l @r3,r3
+    mov.l r3,@(20,r2)
+    mov.w .Lexit_sample_offset,r3
+    add r4,r3
+    mov.l @r3,r3
+    mov.l r3,@(24,r2)
+    mov.w .Lexit_lag_status,r3
+    cmp/eq r3,r0
+    bf .Lexit_publish
+    mov.l .Lexit_lag,r3
+    mov.l @r3,r3
+    mov.l r3,@(28,r2)
+    mov.w .Lexit_limit_offset,r3
+    add r4,r3
+    mov.l @r3,r3
+    shll r3
+    mov.l r3,@(32,r2)
+.Lexit_publish:
+    mov.l r1,@r2
+#if TOY_MOVIE_PRESENT_WITNESS
+    mov #KUI_TOY_MOVIE_EXIT_TERMINAL,r6
+.Lexit_present_boundary:
+    /* R4 is the exact game owner and R2 the identified witness slot. */
+    add #-16,r15
+    sts pr,r1
+    mov.l r1,@(12,r15)
+    mov.l r7,@(8,r15)
+    mov.l r0,@(4,r15)
+    mov.l .Lexit_present_boundary_handler,r1
+    jsr @r1
+    mov r2,r5
+    mov.l @(12,r15),r1
+    lds r1,pr
+    mov.l @(4,r15),r0
+    mov.l @(8,r15),r7
+    add #16,r15
+#endif
+.Lexit_done:
+    rts
+    shlr r7
+.Lexit_tail:
+    mov.l .Lexit_original,r1
+    jmp @r1
+    shlr r7
+
+#if TOY_INTRO_OPEN_POLICY
+.Lexit_start_cmd: .word 0x0200
+.Lexit_stop_status: .word 0x07dc
+.Lexit_lag_status: .word 0xf843
+.Lexit_name_offset: .word 0x00bc
+.Lexit_frame_offset: .word 0x01c0
+.Lexit_sample_offset: .word 0x0244
+.Lexit_limit_offset: .word 0x00a0
+.Lexit_output_offset: .word 0x00ac
+.Lexit_skip_offset: .word 0x0090
+
+.Lexit_opening_buffer:
+    /* The wrapper passes its local context at SP+4. At the recognized
+     * START dispatch the owner has reserved a further 12 stack bytes. */
+    mov r15,r1
+    add #16,r1
+    cmp/eq r1,r4
+    bf .Lexit_normal_buffer
+    mov.w .Lexit_opening_name_offset,r1
+    add r4,r1
+    mov.l @r1+,r3
+    mov.l .Lexit_name_ntsc,r2
+    cmp/eq r2,r3
+    bt .Lexit_opening_name
+    mov.l .Lexit_name_pal,r2
+    cmp/eq r2,r3
+    bf .Lexit_normal_buffer
+.Lexit_opening_name:
+    mov.l @r1+,r3
+    mov.l .Lexit_intro1,r2
+    cmp/eq r2,r3
+    bf .Lexit_normal_buffer
+    mov.l @r1+,r3
+    mov.l .Lexit_intro2,r2
+    cmp/eq r2,r3
+    bf .Lexit_normal_buffer
+    mov.l @r1+,r3
+    mov.l .Lexit_intro3,r2
+    cmp/eq r2,r3
+    bf .Lexit_normal_buffer
+    mov.l @r1,r3
+    mov.l .Lexit_intro4,r2
+    cmp/eq r2,r3
+    bf .Lexit_normal_buffer
+
+    /* Respect any existing caller overrides. */
+    mov.w .Lexit_buffer_offset,r1
+    add r4,r1
+    mov.l @r1+,r3
+    mov.l .Lexit_buffer_1m,r2
+    cmp/eq r2,r3
+    bf .Lexit_normal_buffer
+    mov.l @r1,r3
+    mov #-1,r2
+    cmp/eq r2,r3
+    bf .Lexit_normal_buffer
+#if KUI_TOY_SUITE_MODE == 56
+    /* 960 KiB gives 192 KiB more lead in the original 1 MiB ring. */
+    mov.l .Lexit_prefill,r3
+    mov #KUI_TOY_MOVIE_EXIT_MORE_PREFILL,r2
+    bra .Lexit_call_marked
+    mov.l r3,@r1
+#else
+    mov.l .Lexit_allocator_slot,r1
+    mov.l @r1,r3
+    mov.l .Lexit_default_allocator,r2
+    cmp/eq r2,r3
+    bf .Lexit_normal_buffer
+
+    /* The SDK query takes pointers to total and largest free sizes.
+     * Keep one further MiB available in the same contiguous free block
+     * for the original player setup, plus the split block header. The
+     * original allocator owns the actual allocation and all cleanup. */
+    mov.l r0,@-r15
+    mov.l r4,@-r15
+    mov.l r5,@-r15
+    mov.l r6,@-r15
+    mov.l r7,@-r15
+    sts.l pr,@-r15
+    add #-8,r15
+    mov r15,r4
+    mov r15,r5
+    add #4,r5
+    mov.l .Lexit_query_allocator,r1
+    jsr @r1
+    nop
+    mov.l @(4,r15),r2
+    add #8,r15
+    lds.l @r15+,pr
+    mov.l @r15+,r7
+    mov.l @r15+,r6
+    mov.l @r15+,r5
+    mov.l @r15+,r4
+    mov.l @r15+,r0
+    mov.l .Lexit_buffer_min_free,r3
+    cmp/hs r3,r2
+    bf .Lexit_normal_buffer
+    mov.w .Lexit_buffer_offset,r1
+    add r4,r1
+    mov.l .Lexit_buffer_2m,r3
+    mov #KUI_TOY_MOVIE_EXIT_LARGER_BUFFER,r2
+    bra .Lexit_call_marked
+    mov.l r3,@r1
+#endif
+.Lexit_normal_buffer:
+    bra .Lexit_call
+    nop
+#endif
+
+    .balign 4
+.Lexit_original: .long 0x8c08d638
+.Lexit_start_return: .long 0x8c06d3f0
+.Lexit_update_return: .long 0x8c06d39a
+.Lexit_followup_return: .long 0x8c06d3c0
+.Lexit_witness: .long C_SYMBOL(kui_native_readahead_aux_context)+KUI_TOY_MOVIE_EXIT_OFFSET
+#if TOY_MOVIE_PRESENT_WITNESS
+.Lexit_present_boundary_handler: .long C_SYMBOL(kui_toy_movie_present_boundary)
+#endif
+.Lexit_lag: .long 0x8c1138c4
+.Lexit_name_ntsc: .ascii "60hz"
+.Lexit_name_pal: .ascii "50hz"
+.Lexit_bumper1: .ascii "_Bum"
+.Lexit_bumper2: .ascii "per_"
+.Lexit_bumper3: .ascii "LRTF"
+.Lexit_bumper4: .ascii ".avi"
+.Lexit_intro1: .ascii "_Int"
+.Lexit_intro2: .ascii "ro_L"
+.Lexit_intro3: .ascii "RTF."
+.Lexit_intro4: .asciz "avi"
+#if !TOY_INTRO_OPEN_POLICY
+.Lexit_start_cmd: .word 0x0200
+.Lexit_stop_status: .word 0x07dc
+.Lexit_lag_status: .word 0xf843
+.Lexit_name_offset: .word 0x00bc
+.Lexit_frame_offset: .word 0x01c0
+.Lexit_sample_offset: .word 0x0244
+.Lexit_limit_offset: .word 0x00a0
+#if TOY_MOVIE_OUTPUT_WITNESS
+.Lexit_output_offset: .word 0x00ac
+.Lexit_skip_offset: .word 0x0090
+#endif
+#else
+.Lexit_opening_name_offset: .word 0x00bc
+.Lexit_buffer_offset: .word 0x01dc
+    .balign 4
+.Lexit_buffer_1m: .long 0x00100000
+#if KUI_TOY_SUITE_MODE == 56
+.Lexit_prefill: .long 0x000f0000
+#else
+.Lexit_buffer_2m: .long 0x00200000
+.Lexit_buffer_min_free: .long 0x00300020
+.Lexit_allocator_slot: .long 0x8c117dbc
+.Lexit_default_allocator: .long 0x8c0c5ac8
+.Lexit_query_allocator: .long 0x8c0b3e6e
+#endif
+#endif
+    .size C_SYMBOL(kui_toy_movie_exit_hook),.-C_SYMBOL(kui_toy_movie_exit_hook)
diff --git a/src/loader/toy_movie_iso_stage.inc b/src/loader/toy_movie_iso_stage.inc
new file mode 100644
index 00000000..c2f4fd19
--- /dev/null
+++ b/src/loader/toy_movie_iso_stage.inc
@@ -0,0 +1,144 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include "kui/vmu_launch_package.h"
+#include "kui/toy_movie_trace.h"
+
+static struct kui_toy_movie_range toy_movie_ranges[4];
+#if defined(KUI_TOY_SUITE_MODE)
+#include "kui/native_readahead_layout.h"
+static struct kui_toy_suite_seed toy_suite_seed;
+static uint32_t toy_suite_source;
+#if KUI_TOY_SUITE_MODE == 1 || KUI_TOY_SUITE_MODE == 2 || KUI_TOY_SUITE_MODE == 6
+static _Alignas(32) uint8_t toy_suite_data[KUI_NATIVE_RA_DATA_BYTES];
+#endif
+#if KUI_TOY_SUITE_MODE == 1
+#include "toy_suite_witness_stage.inc"
+#elif KUI_TOY_SUITE_MODE == 2 || KUI_TOY_SUITE_MODE == 6
+#include "toy_suite_ram_stage.inc"
+#endif
+
+static const struct kui_retail_track *toy_suite_movie_track(void) {
+    const struct kui_toy_movie_range *movie=&toy_movie_ranges[3];
+    if(!movie->count)return NULL;
+    for(uint32_t i=0u;i<manifest.track_count;i++) {
+        const struct kui_retail_track *track=&manifest.slots[i].track;
+        if(movie->lba>=track->start_lba && movie->lba+movie->count<=track->end_lba)return track;
+    }
+    return NULL;
+}
+#endif
+
+static bool movie_iso_dual32(const uint8_t *p, uint32_t *out) {
+    uint32_t lo=0, hi=0;
+    for(unsigned i=0;i<4u;i++) {
+        lo|=(uint32_t)p[i]<<(i*8u);
+        hi=(hi<<8)|p[4u+i];
+    }
+    *out=lo;
+    return lo==hi && lo!=0u;
+}
+
+static bool movie_iso_name(const uint8_t *name, unsigned length, const char *expected) {
+    while(*expected && length) {
+        unsigned ch=*name++;
+        if(ch>='a' && ch<='z')ch-=32u;
+        if(ch!=(unsigned)*expected++)return false;
+        --length;
+    }
+    return !*expected && (!length || (length==2u && name[0]==';' && name[1]=='1'));
+}
+
+/* Only checked data sectors in the already validated image map are read.
+ * An unsupported or incomplete inventory disables this optional trace. */
+static bool movie_iso_read(uint32_t lba) {
+    return lba>=manifest.session_lba &&
+        kui_retail_image_read(&image,lba,1u,KUI_GAME_SECTOR_MODE1,
+            raw_boot,KUI_GAME_DATA_BYTES)==KUI_GAME_OK;
+}
+
+static bool movie_range_mapped(uint32_t lba, uint32_t sectors) {
+    while(sectors) {
+        uint32_t n=sectors>KUI_RETAIL_IMAGE_MAX_SECTORS?KUI_RETAIL_IMAGE_MAX_SECTORS:sectors;
+        if(kui_retail_image_check_validated(&manifest,lba,n,KUI_GAME_SECTOR_MODE1)!=KUI_GAME_OK)
+            return false;
+        lba+=n;sectors-=n;
+    }
+    return true;
+}
+
+static bool movie_iso_ranges(void) {
+    static const char *const names[]={"50HZ_BUMPER_LRTF.AVI","60HZ_BUMPER_LRTF.AVI",
+        "50HZ_INTRO_LRTF.AVI","60HZ_INTRO_LRTF.AVI"};
+    const uint8_t *dir=NULL;
+    for(unsigned n=16;n<32u;n++) {
+        if(!movie_iso_read(manifest.session_lba+n) || memcmp(raw_boot+1,"CD001\1",6u))return false;
+        if(raw_boot[0]==1u) {dir=raw_boot+156u;break;}
+        if(raw_boot[0]==255u)return false;
+    }
+    uint32_t root,bytes;
+    if(!dir || raw_boot[128] || raw_boot[129]!=8u || raw_boot[130]!=8u || raw_boot[131] ||
+       dir[0]!=34u || dir[1] || dir[25]!=2u || dir[26] || dir[27] || dir[32]!=1u || dir[33] ||
+       !movie_iso_dual32(dir+2,&root) || !movie_iso_dual32(dir+10,&bytes) ||
+       root<manifest.session_lba || root>=719850u || bytes>128u*1024u)return false;
+    for(uint32_t at=0;at<bytes;at+=KUI_GAME_DATA_BYTES) {
+        if(!movie_iso_read(root+at/KUI_GAME_DATA_BYTES))return false;
+        uint32_t limit=bytes-at;
+        if(limit>KUI_GAME_DATA_BYTES)limit=KUI_GAME_DATA_BYTES;
+        for(uint32_t pos=0;pos<limit && raw_boot[pos];) {
+            const uint8_t *entry=raw_boot+pos;
+            unsigned length=entry[0];
+            if(length<34u || length>limit-pos || !entry[32] || entry[32]>length-33u)return false;
+            pos+=length;
+            for(unsigned i=0;i<4u;i++) {
+                if(!movie_iso_name(entry+33u,entry[32],names[i]))continue;
+                uint32_t lba,size;
+                if(toy_movie_ranges[i].count || entry[1] || entry[25] || entry[26] || entry[27] ||
+                   !movie_iso_dual32(entry+2,&lba) || !movie_iso_dual32(entry+10,&size) ||
+                   lba<manifest.session_lba || lba>=719850u)return false;
+                uint32_t sectors=(size-1u)/KUI_GAME_DATA_BYTES+1u;
+                if(sectors>719850u-lba || !movie_range_mapped(lba,sectors))return false;
+                for(unsigned j=0;j<4u;j++) {
+                    const struct kui_toy_movie_range *known=&toy_movie_ranges[j];
+                    if(known->count && lba<known->lba+known->count && known->lba<lba+sectors &&
+                       !(i/2u==j/2u && lba==known->lba && sectors==known->count))return false;
+                }
+                toy_movie_ranges[i]=(struct kui_toy_movie_range){lba,sectors};
+            }
+        }
+    }
+    return true;
+}
+
+static void toy_movie_scan(void) {
+    if(manifest.reader!=KUI_RETAIL_READER_ASYNC ||
+       native_runtime_mode()!=KUI_VMU_NATIVE_MODE_READER_ONLY ||
+       manifest.ip_crc32!=KUI_VMU_LAUNCH_TOY_IP_CRC ||
+       boot_crc!=KUI_VMU_LAUNCH_TOY_EXEC_CRC ||
+       exec_bytes!=KUI_VMU_LAUNCH_TOY_EXEC_BYTES ||
+       kui_retail_storage_acquire(&card)!=KUI_LOADER_SD_OK)return;
+    bool ok=movie_iso_ranges();
+#if defined(KUI_TOY_SUITE_MODE)
+    const struct kui_retail_track *track=ok?toy_suite_movie_track():NULL;
+    if(track) {
+        if(kui_retail_track_sector_bytes(track)==KUI_GAME_RAW_BYTES &&
+           kui_retail_track_header_bytes(track)==16u)toy_suite_source=1u;
+        else if(kui_retail_track_sector_bytes(track)==KUI_GAME_DATA_BYTES)toy_suite_source=2u;
+    }
+    if(toy_suite_source==1u && card.transport==KUI_STORAGE_SCI) {
+#if KUI_TOY_SUITE_MODE == 1
+        if(!toy_suite_witness_seed())memset(&toy_suite_seed,0,sizeof(toy_suite_seed));
+#elif KUI_TOY_SUITE_MODE == 2 || KUI_TOY_SUITE_MODE == 6
+        (void)toy_suite_ram_seed(track);
+#endif
+    }
+#endif
+    enum kui_loader_sd_result stopped_stream=kui_retail_storage_stop(&card);
+    kui_retail_storage_release(&card);
+    image.cache_valid=0;
+    if(!ok || stopped_stream!=KUI_LOADER_SD_OK) {
+        memset(toy_movie_ranges,0,sizeof(toy_movie_ranges));
+#if defined(KUI_TOY_SUITE_MODE)
+        memset(&toy_suite_seed,0,sizeof(toy_suite_seed));
+        toy_suite_source=0u;
+#endif
+    }
+}
