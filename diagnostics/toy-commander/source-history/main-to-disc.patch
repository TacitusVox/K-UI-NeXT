+       seed->version!=KUI_TOY_REPORT_VERSION || seed->bytes!=sizeof(*seed)) return false;
+    if(!seed->test) {
+        const uint8_t *blank=(const void *)seed;
+        for(unsigned i=16u;i<sizeof(*seed);i++)if(blank[i])return false;
