diff --git a/src/loader/toy_movie_present_trace.inc b/src/loader/toy_movie_present_trace.inc
new file mode 100644
index 00000000..4770e8d4
--- /dev/null
+++ b/src/loader/toy_movie_present_trace.inc
@@ -0,0 +1,114 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+
+/* Both hooks run on the foreground game thread. The scene hook can run
+ * during UPDATE, but cannot overlap a START or terminal boundary record. */
+static struct {
+    uint32_t owner, start_tick, on_time_limit;
+    struct kui_toy_movie_present_trace *trace;
+    bool start_valid, last_valid;
+#if KUI_TOY_SUITE_MODE >= 61
+    bool render_active;
+#endif
+} toy_present;
+
+static uint32_t toy_present_word(uint32_t address) {
+    return *(volatile const uint32_t *)(uintptr_t)address;
+}
+
+void kui_toy_movie_present_boundary(uint32_t ctx,uintptr_t witness,unsigned phase) {
+    const bool intro=witness==(uintptr_t)&C.movie_exit[1];
+    struct kui_toy_movie_present_trace *trace=&C.present[intro];
+    if(phase==KUI_TOY_MOVIE_EXIT_STARTED) {
+        if(C.movie_exit[intro].start_status!=0x07dbu)return;
+#if KUI_TOY_SUITE_MODE < 62
+        const uint32_t fps=toy_present_word(ctx+0xa0u);
+#endif
+        const struct ra_clock now=clock_read();
+        toy_present.owner=ctx;
+        toy_present.start_tick=now.counter;
+#if KUI_TOY_SUITE_MODE >= 62
+        toy_present.on_time_limit=0u;
+        trace->on_time=UINT32_MAX;
+#else
+        toy_present.on_time_limit=fps>=10u && fps<=60u ? 1171875u/fps : 0u;
+#endif
+        toy_present.trace=trace;
+        toy_present.start_valid=now.valid;
+        toy_present.last_valid=false;
+#if KUI_TOY_SUITE_MODE >= 61
+        toy_present.render_active=false;
+#endif
+        if(!now.valid)++trace->clock_lost;
+        return;
+    }
+    if(ctx!=toy_present.owner || trace!=toy_present.trace)return;
+    const struct ra_clock now=clock_read();
+    const uint32_t gap=trace->last_tick-now.counter;
+    if(!now.valid || (toy_present.last_valid && gap>INT32_MAX))++trace->clock_lost;
+    else if(toy_present.last_valid)trace->tail_gap=gap;
+    toy_present.owner=0u;
+}
+
+#if KUI_TOY_SUITE_MODE >= 61
+static void kui_toy_movie_present_observe(uint32_t ctx) {
+#else
+void kui_toy_movie_present_observe(uint32_t ctx) {
+#endif
+    if(!ctx || ctx!=toy_present.owner)return;
+    const struct ra_clock now=clock_read();
+    const uint32_t frame=toy_present_word(ctx+0x1c0u)+1u;
+    struct kui_toy_movie_present_trace *trace=toy_present.trace;
+#if KUI_TOY_SUITE_MODE >= 62
+    /* Original AVI timing setup fills the rate during the first UPDATE.
+     * START only opens the movie, so read the rate at scene submission. */
+    if(!toy_present.on_time_limit) {
+        const uint32_t fps=toy_present_word(ctx+0xa0u);
+        if(fps>=10u && fps<=60u) {
+            toy_present.on_time_limit=1171875u/fps;
+            trace->on_time=0u;
+        }
+    }
+#endif
+    if(!now.valid)++trace->clock_lost;
+    else if(!trace->submitted && toy_present.start_valid) {
+        const uint32_t gap=toy_present.start_tick-now.counter;
+        if(gap<=INT32_MAX)trace->first_gap=gap;
+        else ++trace->clock_lost;
+    } else if(toy_present.last_valid) {
+        const uint32_t gap=trace->last_tick-now.counter;
+        if(gap>INT32_MAX)++trace->clock_lost;
+        else {
+            if(gap>trace->max_gap) {
+                trace->max_gap=gap;
+                trace->max_gap_frame=trace->last_frame;
+            }
+            if(toy_present.on_time_limit && gap<=toy_present.on_time_limit &&
+               frame==trace->last_frame+1u)++trace->on_time;
+        }
+    }
+    ++trace->submitted;
+    trace->last_frame=frame;
+    trace->last_tick=now.counter;
+    toy_present.last_valid=now.valid;
+}
+
+#if KUI_TOY_SUITE_MODE >= 61
+/* Use the actual callback argument instead of inferring owner or the outer
+ * caller's return address from the renderer's live stack. Keep counts of
+ * both arrivals, including when the exact owner test declines a sample. */
+void kui_toy_movie_render_enter(uint32_t ctx) {
+    if(!toy_present.owner)return;
+    ++toy_present.trace->render_entries;
+    if(ctx==toy_present.owner)toy_present.render_active=true;
+}
+
+void kui_toy_movie_render_leave(uint32_t ctx) {
+    if(ctx==toy_present.owner)toy_present.render_active=false;
+}
+
+void kui_toy_movie_scene_observe(void) {
+    if(!toy_present.owner)return;
+    ++toy_present.trace->scene_hits;
+    if(toy_present.render_active)kui_toy_movie_present_observe(toy_present.owner);
+}
+#endif
diff --git a/src/loader/toy_sci_burst.inc b/src/loader/toy_sci_burst.inc
new file mode 100644
index 00000000..e573f104
--- /dev/null
+++ b/src/loader/toy_sci_burst.inc
@@ -0,0 +1,372 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/*
+ * Bounded receive-only CMD18 bursts for the native Toy trial. This code
+ * runs on the guarded auxiliary stack. The existing low SCI interrupt
+ * route dispatches it while the burst marker is live. The diagnostic
+ * established a contiguous DMA prefix; only the caller's CRC parser
+ * can publish complete blocks from that prefix.
+ */
+#define TOY_BURST_SMR UINT32_C(0xffe00000)
+#define TOY_BURST_BRR UINT32_C(0xffe00004)
+#define TOY_BURST_SCR UINT32_C(0xffe00008)
+#define TOY_BURST_SSR UINT32_C(0xffe00010)
+#define TOY_BURST_RDR UINT32_C(0xffe00014)
+#define TOY_BURST_SCMR UINT32_C(0xffe00018)
+#define TOY_BURST_SPTR UINT32_C(0xffe0001c)
+#define TOY_BURST_STBCR UINT32_C(0xffc00004)
+#define TOY_BURST_PDTR UINT32_C(0xff800030)
+#define TOY_BURST_SAR UINT32_C(0xffa00010)
+#define TOY_BURST_DAR UINT32_C(0xffa00014)
+#define TOY_BURST_TCR UINT32_C(0xffa00018)
+#define TOY_BURST_CHCR UINT32_C(0xffa0001c)
+#define TOY_BURST_DMAOR UINT32_C(0xffa00040)
+#define TOY_BURST_RX_DMA UINT32_C(0x4911)
+#define TOY_BURST_RDRF 0x40u
+#define TOY_BURST_ORER 0x20u
+#define TOY_BURST_FLAGS 0x38u
+#define TOY_BURST_TEND 0x04u
+enum { TOY_BURST_MAX_FRAMES=15u, TOY_BURST_SLAB_BYTES=8192u,
+       TOY_BURST_TOKEN_SLICE=256u, TOY_BURST_TOKEN_LIMIT=8192u,
+       TOY_BURST_STOP_LIMIT=1024u };
+
+#ifdef KUI_TOY_SCI_BURST_HOST_TEST
+extern void kui_toy_sci_burst_test_write(uint32_t,unsigned,uint32_t);
+extern uint32_t kui_toy_sci_burst_test_physical(const void *);
+extern void kui_toy_sci_burst_test_fence(const void *);
+#define toy_burst_write kui_toy_sci_burst_test_write
+#define toy_burst_physical kui_toy_sci_burst_test_physical
+#define toy_burst_fence kui_toy_sci_burst_test_fence
+static void toy_burst_settle(unsigned count) { (void)count; }
+#else
+static inline void toy_burst_write(uint32_t reg,unsigned width,uint32_t value) {
+    if(width==1u) *(volatile uint8_t *)(uintptr_t)reg=(uint8_t)value;
+    else if(width==2u) *(volatile uint16_t *)(uintptr_t)reg=(uint16_t)value;
+    else *(volatile uint32_t *)(uintptr_t)reg=value;
+}
+static uint32_t toy_burst_physical(const void *slab) {
+    /* Only the auxiliary's exclusively owned, uncached receive slabs. */
+    uintptr_t address=(uintptr_t)slab;
+    if((address&31u) || address<UINT32_C(0xac010000) ||
+       address>UINT32_C(0xad000000)-TOY_BURST_SLAB_BYTES) return 0;
+    return (uint32_t)address&UINT32_C(0x1fffffff);
+}
+static void toy_burst_fence(const void *slab) {
+    (void)*(volatile const uint32_t *)slab;
+}
+static void toy_burst_settle(unsigned count) {
+    __asm__ __volatile__("1: dt %0\n\tbf 1b" : "+r"(count) : : "t", "memory");
+}
+#endif
+#define toy_burst_read8(reg) read_hw(reg,1u)
+#define toy_burst_read32(reg) read_hw(reg,4u)
+#define toy_burst_write8(reg,value) toy_burst_write(reg,1u,value)
+#define toy_burst_write32(reg,value) toy_burst_write(reg,4u,value)
+
+static bool toy_burst_bus_valid(const kui_retail_async_region_type *r) {
+    const struct kui_loader_sd *card=&r->shared.card.device.sd;
+    return r->engine.opened && r->shared.port.acquired && !r->shared.port.fault &&
+        r->shared.stream.card==card && card->ready && card->bus.select &&
+        card->bus.transfer && !(toy_burst_read8(TOY_BURST_STBCR)&1u);
+}
+static bool toy_burst_framing(const struct kui_sci_stream_state *stream) {
+    return toy_burst_read8(TOY_BURST_SCR)==0x30u &&
+        toy_burst_read8(TOY_BURST_SMR)==0x80u && !toy_burst_read8(TOY_BURST_BRR) &&
+        !toy_burst_read8(TOY_BURST_SCMR) &&
+        (toy_burst_read8(TOY_BURST_SPTR)&0x8au)==(stream->sptr&0x8au) &&
+        (toy_burst_read8(TOY_BURST_SSR)&0xfcu)==0x84u;
+}
+static uint8_t toy_burst_byte(const struct kui_loader_sd_bus *bus,uint8_t value) {
+    return bus->transfer(bus->ctx,value,false);
+}
+static uint8_t toy_burst_command(const struct kui_loader_sd_bus *bus,
+    const uint8_t packet[6],bool stop) {
+    for(unsigned n=0;n<6u;++n) (void)toy_burst_byte(bus,packet[n]);
+    if(stop) (void)toy_burst_byte(bus,0xffu);
+    uint8_t response=0xffu;
+    for(unsigned n=0;n<20u && (response&0x80u);++n)
+        response=toy_burst_byte(bus,0xffu);
+    return response;
+}
+static uint8_t toy_burst_crc7(const uint8_t packet[6]) {
+    unsigned crc=0;
+    for(unsigned n=0;n<5u;++n) for(unsigned bit=0;bit<8u;++bit) {
+        crc<<=1;
+        if(((packet[n]>>(7u-bit))^(crc>>7))&1u) crc^=9u;
+    }
+    return (uint8_t)((crc<<1)|1u);
+}
+/* Failed cleanup quarantines the lease. No retry may start at an unknown
+ * card position, and no command is ever clocked over an active receive. */
+static enum kui_sci_stream_result toy_burst_close(kui_retail_async_region_type *r) {
+    struct kui_sci_stream_state *stream=&r->shared.stream;
+    if(stream->state==RA_CLOSED) return KUI_SCI_STREAM_OK;
+    if(r->engine.in_irq || stream->state==KUI_TOY_SCI_BURST_DMA ||
+       stream->state==RA_DMA) return KUI_SCI_STREAM_BUSY;
+    if(!toy_burst_bus_valid(r) || !toy_burst_framing(stream)) {
+        r->shared.port.fault=true;
+        return KUI_SCI_STREAM_RESET;
+    }
+    const struct kui_loader_sd_bus *bus=&stream->card->bus;
+    const uint8_t stop[6]={0x4cu,0,0,0,0,0x61u};
+    bus->select(bus->ctx,true);
+    uint8_t response=toy_burst_command(bus,stop,true);
+    unsigned busy=TOY_BURST_STOP_LIMIT;
+    while(busy && toy_burst_byte(bus,0xffu)!=0xffu) --busy;
+    bus->select(bus->ctx,false);
+    (void)toy_burst_byte(bus,0xffu);
+    if(!busy || (response&~0x04u) || r->shared.port.fault ||
+       !(read_hw(TOY_BURST_PDTR,2u)&0x80u)) {
+        r->shared.port.fault=true;
+        return KUI_SCI_STREAM_RESET;
+    }
+    stream->state=RA_CLOSED;
+    return KUI_SCI_STREAM_OK;
+}
+static enum kui_sci_stream_result toy_burst_handoff(
+    kui_retail_async_region_type *r,uint32_t status) {
+    struct kui_sci_stream_state *stream=&r->shared.stream;
+    if(status&TOY_BURST_RDRF) (void)toy_burst_read8(TOY_BURST_RDR);
+    toy_burst_write8(TOY_BURST_SSR,status&~(TOY_BURST_RDRF|TOY_BURST_FLAGS));
+    (void)toy_burst_read8(TOY_BURST_SSR);
+    /* RE is already clear and ORER ended receive clocking. Deselect on
+     * our admitted PA7 lease without invoking the PIO TEND wait in IRQ. */
+    toy_burst_write(TOY_BURST_PDTR,2u,read_hw(TOY_BURST_PDTR,2u)|0x80u);
+    if(r->shared.port.fault || !(read_hw(TOY_BURST_PDTR,2u)&0x80u))
+        return KUI_SCI_STREAM_RESET;
+    if(status&TOY_BURST_ORER) {
+        uint32_t before=toy_burst_read8(TOY_BURST_STBCR);
+        if(before&1u || toy_burst_read8(TOY_BURST_SCR) ||
+           toy_burst_read8(TOY_BURST_SSR)&(TOY_BURST_RDRF|TOY_BURST_FLAGS) ||
+           (toy_burst_read8(TOY_BURST_SPTR)&0x8au)!=0x82u)
+            return KUI_SCI_STREAM_RESET;
+        toy_burst_write8(TOY_BURST_STBCR,before|1u);
+        bool stopped=(toy_burst_read8(TOY_BURST_STBCR)&1u)!=0;
+        toy_burst_settle(64u);
+        toy_burst_write8(TOY_BURST_STBCR,toy_burst_read8(TOY_BURST_STBCR)&~1u);
+        if(toy_burst_read8(TOY_BURST_STBCR)&1u) return KUI_SCI_STREAM_RESET;
+        toy_burst_settle(64u);
+        if(!stopped || toy_burst_read8(TOY_BURST_SCR) ||
+           toy_burst_read8(TOY_BURST_SMR) || toy_burst_read8(TOY_BURST_BRR)!=0xffu ||
+           toy_burst_read8(TOY_BURST_SCMR) ||
+           (toy_burst_read8(TOY_BURST_SSR)&0xfcu)!=0x84u ||
+           (toy_burst_read8(TOY_BURST_SPTR)&0x8au)!=0x82u) return KUI_SCI_STREAM_RESET;
+    }
+    toy_burst_write8(TOY_BURST_SCMR,0);
+    toy_burst_write8(TOY_BURST_SMR,0x80u);
+    toy_burst_write8(TOY_BURST_BRR,0);
+    toy_burst_settle(64u);
+    toy_burst_write8(TOY_BURST_SPTR,stream->sptr);
+    toy_burst_write8(TOY_BURST_SCR,0x30u);
+    return toy_burst_framing(stream)?KUI_SCI_STREAM_OK:KUI_SCI_STREAM_RESET;
+}
+/* Foreground only. Return PENDING for a sliced token search or a channel
+ * owned by the game. A later visit resumes that token, not another CMD18. */
+#if KUI_TOY_SUITE_MODE == 28
+static enum kui_sci_stream_result toy_sci_burst_start_rate(kui_retail_async_region_type *r,
+    uint32_t lba,unsigned frames,uint8_t *slab,bool slow) {
+#else
+static enum kui_sci_stream_result toy_sci_burst_start(kui_retail_async_region_type *r,
+    uint32_t lba,unsigned frames,uint8_t *slab) {
+#endif
+    struct kui_sci_stream_state *stream=&r->shared.stream;
+    const struct kui_loader_sd *card=&r->shared.card.device.sd;
+    uint32_t address=toy_burst_physical(slab);
+    if(r->engine.in_irq || stream->state==KUI_TOY_SCI_BURST_DMA ||
+       stream->state==RA_DMA) return KUI_SCI_STREAM_BUSY;
+    if(!address || !frames || frames>TOY_BURST_MAX_FRAMES ||
+       lba>UINT32_MAX-(frames-1u) || (uint64_t)lba+frames>card->blocks ||
+       (!card->high_capacity && lba>UINT32_MAX/512u) ||
+       !toy_burst_bus_valid(r) || !toy_burst_framing(stream)) return KUI_SCI_STREAM_RESET;
+    if((toy_burst_read32(TOY_BURST_CHCR)&7u) ||
+       (toy_burst_read32(TOY_BURST_DMAOR)&7u)!=1u) return KUI_SCI_STREAM_PENDING;
+    const struct kui_loader_sd_bus *bus=&card->bus;
+    if(stream->state!=KUI_TOY_SCI_BURST_TOKEN || stream->position!=lba) {
+        enum kui_sci_stream_result stop=toy_burst_close(r);
+        if(stop!=KUI_SCI_STREAM_OK) return stop;
+        uint32_t argument=card->high_capacity?lba:lba<<9;
+        uint8_t packet[6]={0x52u,(uint8_t)(argument>>24),(uint8_t)(argument>>16),
+            (uint8_t)(argument>>8),(uint8_t)argument,0};
+        packet[5]=toy_burst_crc7(packet);
+        bus->select(bus->ctx,true);
+        unsigned idle=TOY_BURST_TOKEN_SLICE;
+        while(idle && toy_burst_byte(bus,0xffu)!=0xffu) --idle;
+        if(!idle || r->shared.port.fault) {
+            bus->select(bus->ctx,false);
+            return r->shared.port.fault?KUI_SCI_STREAM_RESET:KUI_SCI_STREAM_COMMAND;
+        }
+        stream->state=RA_LOST;
+        ++stream->stats.starts;
+        if(toy_burst_command(bus,packet,false) || r->shared.port.fault) {
+            bus->select(bus->ctx,false);
+            return r->shared.port.fault?KUI_SCI_STREAM_RESET:KUI_SCI_STREAM_COMMAND;
+        }
+        stream->state=KUI_TOY_SCI_BURST_TOKEN;
+        stream->position=lba;
+        stream->ready_lba[0]=TOY_BURST_TOKEN_LIMIT;
+        stream->ready[0]=stream->ready[1]=stream->kept=0;
+        stream->arrived=0;
+    } else bus->select(bus->ctx,true);
+    unsigned slice=TOY_BURST_TOKEN_SLICE;
+    uint8_t token=0xffu;
+    while(slice && stream->ready_lba[0] && token==0xffu) {
+        token=toy_burst_byte(bus,0xffu);
+        --stream->ready_lba[0];
+        --slice;
+    }
+    if(token!=0xfeu || r->shared.port.fault) {
+        bus->select(bus->ctx,false);
+        if(r->shared.port.fault) return KUI_SCI_STREAM_RESET;
+        if(token==0xffu && stream->ready_lba[0]) return KUI_SCI_STREAM_PENDING;
+        ++stream->stats.token_errors;
+        stream->state=RA_LOST;
+        return KUI_SCI_STREAM_TOKEN;
+    }
+    /* The first token was clocked by PIO. The remaining bytes are raw
+     * LSB-first receive bytes. Leave room for every frame's two CRC bytes. */
+    uint32_t wire_bytes=frames*516u-2u;
+    toy_burst_settle(64u);
+    toy_burst_write8(TOY_BURST_SPTR,0x83u);
+    if((toy_burst_read8(TOY_BURST_SPTR)&0x8au)!=0x82u) {
+        bus->select(bus->ctx,false);
+        r->shared.port.fault=true;
+        stream->state=RA_LOST;
+        return KUI_SCI_STREAM_RESET;
+    }
+    for(unsigned n=0;n<4u;++n)
+        stream->saved[n]=toy_burst_read32(TOY_BURST_SAR+4u*n);
+    stream->ready_lba[0]=address;
+    stream->ready_lba[1]=wire_bytes;
+    toy_burst_write8(TOY_BURST_SCR,0);
+#if KUI_TOY_SUITE_MODE == 28
+    if(slow) {
+        /* CMD18 and token search used the fast command clock. Switch only
+         * this payload, with both SCI directions disabled. As in the CE
+         * slow receive, settle for more than one 6.25 MHz bit time. */
+        if(toy_burst_read8(TOY_BURST_SCR)) {
+            stream->state=RA_LOST;
+            r->shared.port.fault=true;
+            return KUI_SCI_STREAM_RESET;
+        }
+        toy_burst_write8(TOY_BURST_BRR,1u);
+        toy_burst_settle(64u);
+        if(toy_burst_read8(TOY_BURST_BRR)!=1u) {
+            /* DMA was never armed. Restore fast framing if SCI is still
+             * ours, then quarantine the failed rate transition. */
+            (void)toy_burst_handoff(r,toy_burst_read8(TOY_BURST_SSR));
+            stream->state=RA_LOST;
+            r->shared.port.fault=true;
+            return KUI_SCI_STREAM_RESET;
+        }
+    }
+#endif
+    toy_burst_write32(TOY_BURST_CHCR,0);
+    toy_burst_write32(TOY_BURST_SAR,TOY_BURST_RDR&UINT32_C(0x1fffffff));
+    toy_burst_write32(TOY_BURST_DAR,address);
+    toy_burst_write32(TOY_BURST_TCR,wire_bytes);
+    toy_burst_write32(TOY_BURST_CHCR,TOY_BURST_RX_DMA);
+    stream->state=KUI_TOY_SCI_BURST_DMA;
+    toy_burst_write8(TOY_BURST_SCR,0x50u);
+    return KUI_SCI_STREAM_OK;
+}
+#if KUI_TOY_SUITE_MODE == 28
+static inline enum kui_sci_stream_result toy_sci_burst_start(kui_retail_async_region_type *r,
+    uint32_t lba,unsigned frames,uint8_t *slab) {
+    return toy_sci_burst_start_rate(r,lba,frames,slab,false);
+}
+#endif
+/* Wait only for a hardware event during ordinary visits. Retire a bounded
+ * burst prefix after the same trailing or premature ORER that the single
+ * block reader uses. Never treat RDR or a byte clocked after ORER as part
+ * of the prefix, and never touch a channel taken over by the game. */
+static enum kui_sci_stream_result toy_burst_retire(kui_retail_async_region_type *r,
+    const uint8_t *slab,unsigned frames,uint32_t *received,bool cancel) {
+    struct kui_sci_stream_state *stream=&r->shared.stream;
+    *received=0;
+    uint32_t start=toy_burst_physical(slab);
+    uint32_t wire_bytes=frames*516u-2u;
+    if(stream->state!=KUI_TOY_SCI_BURST_DMA || !start || !frames ||
+       frames>TOY_BURST_MAX_FRAMES || start!=stream->ready_lba[0] ||
+       wire_bytes!=stream->ready_lba[1]) return KUI_SCI_STREAM_RESET;
+    bool bus_ok=toy_burst_bus_valid(r);
+    uint32_t control=toy_burst_read32(TOY_BURST_CHCR);
+    uint32_t next=toy_burst_read32(TOY_BURST_DAR);
+    bool channel_owned=(control&~2u)==TOY_BURST_RX_DMA &&
+        toy_burst_read32(TOY_BURST_SAR)==(TOY_BURST_RDR&UINT32_C(0x1fffffff)) &&
+        next>=start && next<=start+wire_bytes;
+    bool sci_owned=bus_ok && toy_burst_read8(TOY_BURST_SCR)==0x50u &&
+        (toy_burst_read8(TOY_BURST_SPTR)&0x8au)==0x82u &&
+        !(read_hw(TOY_BURST_PDTR,2u)&0x80u);
+    bool dma_ok=(toy_burst_read32(TOY_BURST_DMAOR)&7u)==1u;
+    uint32_t status=sci_owned?toy_burst_read8(TOY_BURST_SSR):0;
+    if(!cancel && channel_owned && sci_owned && dma_ok && !(status&TOY_BURST_FLAGS))
+        return KUI_SCI_STREAM_PENDING;
+    if(sci_owned) toy_burst_write8(TOY_BURST_SCR,0);
+    uint32_t remaining=wire_bytes;
+    if(channel_owned) {
+        toy_burst_fence(slab);
+        toy_burst_write32(TOY_BURST_CHCR,control&~5u);
+        (void)toy_burst_read32(TOY_BURST_CHCR);
+        toy_burst_fence(slab);
+        remaining=toy_burst_read32(TOY_BURST_TCR);
+        /* An incomplete receive can still have a byte accepted on the bus
+         * after DE is clear. Use the diagnostic's bounded stability check
+         * before restoring the guest tuple or exposing the stopped prefix. */
+        uint32_t first=remaining, stable=remaining?0u:4u;
+        for(unsigned n=0;n<16u && stable<4u;++n) {
+            toy_burst_fence(slab);
+            toy_burst_settle(256u);
+            uint32_t count=toy_burst_read32(TOY_BURST_TCR);
+            if(count>first || first-count>2u || (toy_burst_read32(TOY_BURST_CHCR)&5u)) break;
+            if(count==remaining && toy_burst_read32(TOY_BURST_DAR)==start+wire_bytes-count)
+                ++stable;
+            else stable=0;
+            remaining=count;
+        }
+        control=toy_burst_read32(TOY_BURST_CHCR);
+        channel_owned=stable==4u && remaining<=wire_bytes &&
+            toy_burst_read32(TOY_BURST_DAR)==start+wire_bytes-remaining &&
+            (control&7u)==(remaining?0u:2u);
+        if(channel_owned) {
+            toy_burst_write32(TOY_BURST_CHCR,0);
+            for(unsigned n=0;n<4u;++n)
+                toy_burst_write32(TOY_BURST_SAR+4u*n,stream->saved[n]);
+        }
+    }
+    stream->state=RA_LOST;
+    enum kui_sci_stream_result result=KUI_SCI_STREAM_RESET;
+    if(sci_owned) result=toy_burst_handoff(r,toy_burst_read8(TOY_BURST_SSR));
+    if(!channel_owned || !dma_ok || !(status&TOY_BURST_ORER) || result!=KUI_SCI_STREAM_OK) {
+        r->shared.port.fault=true;
+        return KUI_SCI_STREAM_RESET;
+    }
+    if(remaining) ++stream->stats.overruns;
+    *received=wire_bytes-remaining;
+    return KUI_SCI_STREAM_OK;
+}
+static enum kui_sci_stream_result toy_sci_burst_poll(kui_retail_async_region_type *r,
+    const uint8_t *slab,unsigned frames,uint32_t *received) {
+    return toy_burst_retire(r,slab,frames,received,false);
+}
+static enum kui_sci_stream_result toy_sci_burst_stop(kui_retail_async_region_type *r,
+    const uint8_t *slab,unsigned frames) {
+    if(r->engine.in_irq) return KUI_SCI_STREAM_BUSY;
+    if(r->shared.stream.state==KUI_TOY_SCI_BURST_DMA) {
+        uint32_t ignored;
+        enum kui_sci_stream_result result=KUI_SCI_STREAM_PENDING;
+        /* Quiesce only, never a movie poll. Prefer a whole-byte stop. A
+         * nonresponsive receiver is fenced and quarantined without CMD12. */
+        for(unsigned n=0;n<200000u && result==KUI_SCI_STREAM_PENDING;++n) {
+            if(!toy_burst_bus_valid(r) || (toy_burst_read8(TOY_BURST_SSR)&TOY_BURST_FLAGS) ||
+               (toy_burst_read32(TOY_BURST_DMAOR)&7u)!=1u ||
+               !(toy_burst_read32(TOY_BURST_CHCR)&1u))
+                result=toy_sci_burst_poll(r,slab,frames,&ignored);
+        }
+        if(result==KUI_SCI_STREAM_PENDING) {
+            (void)toy_burst_retire(r,slab,frames,&ignored,true);
+            r->shared.port.fault=true;
+            return KUI_SCI_STREAM_RESET;
+        }
+        if(result!=KUI_SCI_STREAM_OK) return result;
+    }
+    return toy_burst_close(r);
+}
diff --git a/src/loader/toy_suite_burst.inc b/src/loader/toy_suite_burst.inc
new file mode 100644
index 00000000..04a086f2
--- /dev/null
+++ b/src/loader/toy_suite_burst.inc
@@ -0,0 +1,516 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* A movie request remains owned by the original GD cursor. The
+ * separately received wire bytes cannot become guest bytes until checked. */
+enum {
+    TOY_BURST_WIRE = 8192u,
+    TOY_BURST_FRAMES = 15u,
+    TOY_BURST_HISTORY = 32u,
+    TOY_BURST_LEAD = 312u,
+    TOY_BURST_EMPTY_LIMIT = 3u,
+    TOY_BURST_MAX_GAP = 64u,
+    TOY_BURST_IRQ_CHECKS = 4u,
+    TOY_BURST_CALL_CHECKS = 8u,
+    TOY_BURST_TIMEOUT_TICKS = 39063u,
+    TOY_BURST_MAX_POLLS = 16384u,
+#if KUI_TOY_SUITE_MODE == 28
+    TOY_BURST_RECOVERY_ATTEMPTS = 2u,
+#endif
+};
+_Static_assert(KUI_NATIVE_RA_CACHE_BYTES + 2u * TOY_BURST_WIRE == KUI_NATIVE_RA_DATA_BYTES,
+    "burst staging uses the existing data lease");
+_Static_assert(TOY_BURST_LEAD + TOY_BURST_HISTORY == KUI_NATIVE_RA_CACHE_BLOCKS,
+    "burst ring lead and history fit");
+#define B C.burst
+#define METRIC C.diagnostics.stage_result[KUI_NATIVE_RA_STAGE_NONE]
+static uint8_t *burst_slab(void) { return C.config.data + KUI_NATIVE_RA_CACHE_BYTES; }
+
+#if KUI_TOY_SUITE_MODE == 28
+static struct kui_toy_burst_rate *burst_rate(void) {
+    return B.slow_rx ? &C.burst_slow : &C.burst_fast;
+}
+#endif
+
+#if KUI_TOY_SUITE_MODE == 27 || KUI_TOY_SUITE_MODE == 28
+static struct kui_toy_burst_metrics *burst_metrics(void) {
+    return B.calibration ? &C.burst_quiet : &C.burst_live;
+}
+
+#define BURST_METRIC_ADD(field, value) do { \
+    const uint32_t increment = (value); \
+    burst_metrics()->field += increment; \
+    if(B.matched) C.burst_match.field += increment; \
+} while(0)
+
+static bool burst_in_window(uint32_t first, uint32_t end) {
+    return B.lba >= first && B.lba < end && B.frames <= end - B.lba;
+}
+
+static void burst_record_arm(uint32_t wanted) {
+    B.wanted = wanted;
+    /* A comparable live receive must lie entirely in the physical span
+     * covered by the quiet requests, including its last programmed frame. */
+    B.matched = !B.calibration && (burst_in_window(C.burst_quiet_lba, C.burst_quiet_end) ||
+        burst_in_window(C.burst_quiet_late_lba, C.burst_quiet_late_end));
+    BURST_METRIC_ADD(arms, 1u);
+    BURST_METRIC_ADD(requested, wanted);
+#if KUI_TOY_SUITE_MODE == 28
+    if(!B.calibration) ++burst_rate()->arms;
+#endif
+    if(!B.calibration) ++C.suite[0];
+}
+
+static void burst_record_start_error(enum kui_sci_stream_result result) {
+    /* These attempts never armed a burst and are not paired retirements. */
+    struct kui_toy_burst_metrics *m = burst_metrics();
+    if(result == KUI_SCI_STREAM_TOKEN) ++m->bad_token;
+    else if(result == KUI_SCI_STREAM_COMMAND) ++m->command_error;
+    else if(result == KUI_SCI_STREAM_RESET) ++m->reset;
+}
+
+static void burst_record_short(struct kui_toy_burst_metrics *m,
+    const struct kui_toy_burst_cut *cut) {
+    if(!m->first_short.tcr) m->first_short = *cut;
+    m->last_short = *cut;
+}
+
+static void burst_record_received(uint32_t bytes) {
+    B.bytes = bytes;
+    B.offset = B.parsed = 0;
+    B.pending = true;
+    BURST_METRIC_ADD(received, bytes);
+    if(!B.calibration) METRIC[3] += bytes;
+    if(bytes == B.wanted) {
+        BURST_METRIC_ADD(dma_full, 1u);
+#if KUI_TOY_SUITE_MODE == 28
+        if(!B.calibration) ++burst_rate()->dma_full;
+#endif
+    } else {
+        BURST_METRIC_ADD(dma_short, 1u);
+        if(!B.calibration) {
+#if KUI_TOY_SUITE_MODE == 28
+            /* Retire and parse the stable prefix before the next arm.
+             * A short fast receive gets two lower-rate attempts followed
+             * by a fast probe. Only a new short fast receive renews them. */
+            if(!B.slow_rx) B.slow_attempts = TOY_BURST_RECOVERY_ATTEMPTS;
+#endif
+            const struct kui_toy_burst_cut cut = {
+                .tcr = B.wanted - bytes,
+                .chcr2 = read_hw(UINT32_C(0xffa0002c), 4u),
+                .c2dst = read_hw(UINT32_C(0xa05f6808), 4u),
+                .g2adst = read_hw(UINT32_C(0xa05f7818), 4u),
+            };
+            burst_record_short(&C.burst_live, &cut);
+            if(B.matched) burst_record_short(&C.burst_match, &cut);
+        }
+    }
+}
+#endif
+
+static bool burst_release(kui_retail_async_region_type *r) {
+    if(B.owned) {
+        if(r->engine.in_irq) return false;
+        enum kui_sci_stream_result result = toy_sci_burst_stop(r, burst_slab(), B.frames);
+        if(result != KUI_SCI_STREAM_OK || C.config.ops->busy()) {
+            r->engine.failed = KUI_GD_ERROR_IO;
+            return false;
+        }
+        B.owned = false;
+        if(!r->engine.active) C.config.ops->unhook();
+    }
+    B.pending = false;
+    B.variant = 0u;
+    return true;
+}
+
+/* The cold stage has authenticated the retained map. Limit read-ahead to
+ * the current track's file span, physical extent, and mapped movie end. */
+static uint32_t burst_extent_end(const struct kui_retail_cursor *c, unsigned variant) {
+    const struct kui_retail_manifest *m = c->manifest;
+    const struct kui_retail_track *t = &m->slots[c->track].track;
+    const struct kui_toy_movie_range *movie = &C.config.movie_ranges[variant - 1u];
+    uint32_t movie_end = movie->lba + movie->count;
+    if(movie_end > t->end_lba) movie_end = t->end_lba;
+    if(movie_end <= t->start_lba) return 0;
+    uint32_t file_end = (kui_retail_track_file_offset(t) +
+        (movie_end - t->start_lba) * KUI_GAME_RAW_BYTES + 511u) >> 9;
+    uint32_t first = kui_retail_track_first_extent(t);
+    for(unsigned i = 0; i < t->extent_count; ++i) {
+        const struct kui_retail_extent *x = &m->slots[first + i].extent;
+        if(c->block - x->card_lba >= x->blocks || file_end <= x->file_block) continue;
+        uint32_t blocks = file_end - x->file_block;
+        if(blocks > x->blocks) blocks = x->blocks;
+        if(c->block - x->card_lba < blocks && blocks <= UINT32_MAX - x->card_lba)
+            return x->card_lba + blocks;
+    }
+    return 0;
+}
+
+static bool burst_anchor(kui_retail_async_region_type *r, unsigned variant) {
+    const struct kui_retail_cursor *c = &r->engine.cursor;
+    uint32_t end = burst_extent_end(c, variant);
+    if(!end || !burst_release(r)) return false;
+    const struct kui_native_ra_low_ops *o = C.config.ops;
+    /* Opening and nonmovie reads used the ordinary transport. It may have
+     * left a checked-ready block or an open command; release that before
+     * admitting the separate slab receiver. No DMA is drained from IRQ. */
+    if(o->busy() || o->stop() != KUI_SCI_STREAM_OK) return false;
+    if(!kui_native_ra_cache_rebase(&C.cache, c->block, end)) return false;
+    B.variant = variant;
+    B.frontier = c->block;
+    B.empty = 0;
+#if KUI_TOY_SUITE_MODE == 28
+    /* A seek or stock fallback in this movie does not erase pending
+     * recovery. A different movie starts with its own fast probe. */
+    if(B.rate_variant != variant) {
+        B.rate_variant = (uint8_t)variant;
+        B.slow_attempts = 0u;
+    }
+    B.slow_tried = false;
+#endif
+    return true;
+}
+
+static void burst_trim(uint32_t block) {
+    if(block >= B.frontier) B.frontier = block + 1u;
+    uint32_t used = B.frontier - C.cache.base;
+    if(used <= TOY_BURST_HISTORY) return;
+    uint32_t drop = used - TOY_BURST_HISTORY;
+    if(drop > C.cache.count) drop = C.cache.count;
+    C.cache.base += drop;
+    C.cache.count -= drop;
+    C.cache.head += drop;
+    if(C.cache.head >= KUI_NATIVE_RA_CACHE_BLOCKS)
+        C.cache.head -= KUI_NATIVE_RA_CACHE_BLOCKS;
+}
+
+static bool burst_ready(uint32_t block) { return block - C.cache.base < C.cache.count; }
+
+static unsigned burst_feed(kui_retail_async_region_type *r, unsigned limit) {
+    struct kui_retail_async *e = &r->engine;
+    unsigned fed = 0;
+    while(fed < limit && e->active && !e->failed && burst_ready(e->cursor.block)) {
+        uint32_t block = e->cursor.block, slot = C.cache.head + block - C.cache.base;
+        if(slot >= KUI_NATIVE_RA_CACHE_BLOCKS) slot -= KUI_NATIVE_RA_CACHE_BLOCKS;
+        if(C.config.ops->feed(&e->cursor, C.cache.data + (slot << 9)) != KUI_GAME_OK) {
+            e->failed = KUI_GD_ERROR_IO;
+            break;
+        }
+        e->retries = 0;
+        ++e->since;
+        ++fed;
+        if(e->in_irq) ++e->stats.irq_blocks;
+        else ++e->stats.call_blocks;
+        burst_trim(block);
+        demand_complete(r);
+    }
+    return fed;
+}
+
+static uint8_t burst_reverse(uint8_t x) {
+    uint32_t y = x;
+    y = ((y & 0x55u) << 1) | ((y >> 1) & 0x55u);
+    y = ((y & 0x33u) << 2) | ((y >> 2) & 0x33u);
+    return (uint8_t)((y << 4) | (y >> 4));
+}
+
+static bool burst_check_block(const uint8_t *wire, uint8_t *out) {
+    uint16_t crc = 0;
+    for(unsigned i = 0; i < 512u; ++i) {
+        uint8_t b = burst_reverse(wire[i]);
+        out[i] = b;
+        uint32_t x = (crc >> 8) ^ b;
+        x ^= x >> 4;
+        crc = (uint16_t)((crc << 8) ^ (x << 12) ^ (x << 5) ^ x);
+    }
+    return crc == ((unsigned)burst_reverse(wire[512]) << 8 | burst_reverse(wire[513]));
+}
+
+static void burst_parse_done(void) {
+    if(B.parsed < B.frames) {
+#if KUI_TOY_SUITE_MODE == 27 || KUI_TOY_SUITE_MODE == 28
+        if(B.bytes == B.wanted) BURST_METRIC_ADD(parse_full_cut, 1u);
+        if(!B.calibration)
+#endif
+            ++C.suite[2];
+    }
+    if(B.parsed) {
+        B.empty = 0;
+#if KUI_TOY_SUITE_MODE == 28
+        B.slow_tried = false;
+#endif
+    } else {
+        ++B.empty;
+#if KUI_TOY_SUITE_MODE == 28
+        /* If the third empty was the first hardware cut since any good
+         * data, give the first slower attempt a chance before stock. */
+        if(!B.calibration && !B.slow_rx && B.bytes < B.wanted &&
+           !B.slow_tried && B.empty == TOY_BURST_EMPTY_LIMIT) --B.empty;
+#endif
+    }
+    B.pending = false;
+}
+
+/* Bound retirement work even in the SCI interrupt. Only whole contiguous
+ * checked frames become visible. Token search cannot resync into payload. */
+static void burst_parse(unsigned budget) {
+#if KUI_TOY_SUITE_MODE == 27 || KUI_TOY_SUITE_MODE == 28
+    uint32_t before = B.parsed;
+#endif
+    while(B.pending && budget--) {
+        const uint8_t *slab = burst_slab();
+        uint32_t at = B.offset;
+        if(B.parsed) {
+            unsigned gap = 0;
+            while(at < B.bytes && gap < TOY_BURST_MAX_GAP && slab[at] == 0xffu) {
+                ++at;
+                ++gap;
+            }
+#if KUI_TOY_SUITE_MODE == 27 || KUI_TOY_SUITE_MODE == 28
+            bool token_available = at < B.bytes;
+#endif
+            if(at >= B.bytes || slab[at++] != 0x7fu) {
+#if KUI_TOY_SUITE_MODE == 27 || KUI_TOY_SUITE_MODE == 28
+                /* Running out of bytes and seeing an invalid token are
+                 * distinct. An overlong gap is an invalid token here. */
+                if(token_available) BURST_METRIC_ADD(bad_token, 1u);
+#endif
+                burst_parse_done();
+                break;
+            }
+        }
+        if(B.bytes - at < 514u) {
+            burst_parse_done();
+            break;
+        }
+        uint32_t lba;
+        if(!kui_native_ra_cache_next(&C.cache, &lba) || lba != B.lba + B.parsed) {
+            ++C.stats.guard_faults;
+            burst_parse_done();
+            break;
+        }
+        uint32_t slot = C.cache.head + C.cache.count;
+        if(slot >= KUI_NATIVE_RA_CACHE_BLOCKS) slot -= KUI_NATIVE_RA_CACHE_BLOCKS;
+        /* Decode and check into the next unowned cache slot. Its bytes
+         * remain unreachable on bad CRC because count has not advanced. */
+        if(!burst_check_block(slab + at, C.cache.data + (slot << 9))) {
+            ++C.stats.crc_errors;
+#if KUI_TOY_SUITE_MODE == 27 || KUI_TOY_SUITE_MODE == 28
+            BURST_METRIC_ADD(bad_crc, 1u);
+#endif
+            burst_parse_done();
+            break;
+        }
+        ++C.cache.count;
+#if KUI_TOY_SUITE_MODE == 27 || KUI_TOY_SUITE_MODE == 28
+        if(!B.calibration)
+#endif
+        {
+            ++C.suite[1];
+            uint32_t lead = C.cache.base + C.cache.count - B.frontier;
+            if(lead > METRIC[2]) METRIC[2] = lead;
+        }
+        B.offset = at + 514u;
+        if(++B.parsed == B.frames) burst_parse_done();
+    }
+#if KUI_TOY_SUITE_MODE == 27 || KUI_TOY_SUITE_MODE == 28
+    if(B.parsed > before) {
+        BURST_METRIC_ADD(checked, B.parsed - before);
+#if KUI_TOY_SUITE_MODE == 28
+        if(!B.calibration) burst_rate()->checked += B.parsed - before;
+#endif
+        if(!before) BURST_METRIC_ADD(usable, 1u);
+    }
+#endif
+}
+
+static void burst_retire(kui_retail_async_region_type *r) {
+    if(r->shared.stream.state == KUI_TOY_SCI_BURST_DMA) {
+        uint32_t bytes = 0;
+        enum kui_sci_stream_result result = toy_sci_burst_poll(r, burst_slab(), B.frames, &bytes);
+        if(result == KUI_SCI_STREAM_PENDING) {
+            if(r->engine.in_irq) return;
+            struct ra_clock now = clock_read();
+            uint32_t elapsed = B.started - now.counter;
+            if(++B.polls < TOY_BURST_MAX_POLLS && (!now.valid ||
+               elapsed < TOY_BURST_TIMEOUT_TICKS || elapsed >= UINT32_C(0x80000000))) return;
+#if KUI_TOY_SUITE_MODE == 27 || KUI_TOY_SUITE_MODE == 28
+            BURST_METRIC_ADD(timeout, 1u);
+#endif
+            ++C.suite[2];
+            if(burst_release(r)) B.empty = TOY_BURST_EMPTY_LIMIT;
+            return;
+        }
+        if(result != KUI_SCI_STREAM_OK || bytes > TOY_BURST_WIRE
+#if KUI_TOY_SUITE_MODE == 27 || KUI_TOY_SUITE_MODE == 28
+           || bytes > B.wanted
+#endif
+          ) {
+#if KUI_TOY_SUITE_MODE == 27 || KUI_TOY_SUITE_MODE == 28
+            BURST_METRIC_ADD(reset, 1u);
+#endif
+            ++C.suite[2];
+            r->engine.failed = KUI_GD_ERROR_IO;
+            return;
+        }
+#if KUI_TOY_SUITE_MODE == 27 || KUI_TOY_SUITE_MODE == 28
+        burst_record_received(bytes);
+#else
+        B.bytes = bytes;
+        B.offset = B.parsed = 0;
+        B.pending = true;
+        METRIC[3] += bytes;
+#endif
+    }
+    if(B.pending) burst_parse(r->engine.in_irq ? TOY_BURST_IRQ_CHECKS : TOY_BURST_CALL_CHECKS);
+}
+
+static void burst_arm(kui_retail_async_region_type *r) {
+    struct kui_retail_async *e = &r->engine;
+    if(!B.variant || B.pending || e->failed || e->in_irq || C.quiesced ||
+       C.config.ops->busy() || !dma_idle()) return;
+    uint32_t lba;
+    if(!kui_native_ra_cache_next(&C.cache, &lba)) return;
+    uint32_t lead = lba - B.frontier;
+    if(lead >= TOY_BURST_LEAD) return;
+    unsigned frames = TOY_BURST_LEAD - lead;
+    if(frames > C.cache.end - lba) frames = C.cache.end - lba;
+    if(frames > KUI_NATIVE_RA_CACHE_BLOCKS - C.cache.count)
+        frames = KUI_NATIVE_RA_CACHE_BLOCKS - C.cache.count;
+    if(frames > TOY_BURST_FRAMES) frames = TOY_BURST_FRAMES;
+    if(r->shared.stream.state == KUI_TOY_SCI_BURST_TOKEN) {
+        if(!B.owned || B.lba != lba) {e->failed=KUI_GD_ERROR_IO;return;}
+        frames = B.frames;
+    }
+    C.config.ops->hook();
+    if(!e->hooked || e->release.armed != 0x10u ||
+       (read_hw(UINT32_C(0xffd00008), 2u) & 0xf0u) != 0x10u) {
+        ++B.empty;
+        return;
+    }
+#if KUI_TOY_SUITE_MODE == 28
+    bool slow = B.slow_attempts != 0u;
+    enum kui_sci_stream_result result = toy_sci_burst_start_rate(r, lba, frames, burst_slab(), slow);
+    /* A sliced token search keeps the selected rate until it finishes. */
+    if(slow && result != KUI_SCI_STREAM_BUSY && result != KUI_SCI_STREAM_PENDING) {
+        --B.slow_attempts;
+        B.slow_tried = true;
+    }
+#else
+    enum kui_sci_stream_result result = toy_sci_burst_start(r, lba, frames, burst_slab());
+#endif
+    uint32_t state = r->shared.stream.state;
+    if(state == KUI_TOY_SCI_BURST_DMA || state == KUI_TOY_SCI_BURST_TOKEN || state == RA_LOST) {
+        B.lba = lba;
+        B.frames = frames;
+        B.owned = true;
+    }
+    if(result == KUI_SCI_STREAM_OK) {
+#if KUI_TOY_SUITE_MODE == 28
+        B.slow_rx = slow;
+#endif
+        B.started = read_hw(UINT32_C(0xffd8000c), 4u);
+        B.polls = 0;
+#if KUI_TOY_SUITE_MODE == 27 || KUI_TOY_SUITE_MODE == 28
+        burst_record_arm(r->shared.stream.ready_lba[1]);
+#else
+        ++C.suite[0];
+#endif
+    } else if(result != KUI_SCI_STREAM_BUSY && result != KUI_SCI_STREAM_PENDING) {
+#if KUI_TOY_SUITE_MODE == 27 || KUI_TOY_SUITE_MODE == 28
+        burst_record_start_error(result);
+#endif
+        ++B.empty;
+        if(result == KUI_SCI_STREAM_RESET) e->failed = KUI_GD_ERROR_IO;
+    }
+}
+
+static void burst_request_stats(const struct kui_retail_cursor *c, unsigned variant) {
+    ++METRIC[0];
+    if(B.variant != variant || !burst_ready(c->block)) return;
+    ++METRIC[1];
+    /* A cursor run ending inside the movie extent covers the whole
+     * request. Exclude runs at the boundary rather than count a partial
+     * request that continues in a different physical extent. */
+    if(c->run < C.cache.end - c->block &&
+       C.cache.count - (c->block - C.cache.base) >= c->run)
+        ++C.suite[4];
+}
+
+static void burst_service(uint32_t wait, kui_retail_async_region_type *r) {
+    struct kui_retail_async *e = &r->engine;
+    unsigned variant = suite_movie(r);
+    if(variant && r->shared.service.lba - C.config.movie_ranges[variant - 1u].lba < 386u)
+        variant = 0;
+    if(!variant) {
+        /* An SCI callback can finish the cursor before the next GD call
+         * publishes status. Pending with the same token remains our film. */
+        if(B.variant && (e->active || e->failed ||
+           (r->shared.service.pending && r->shared.service.token != e->token) ||
+           r->shared.service.status == KUI_GD_NOT_FOUND ||
+           r->shared.service.command == KUI_RETAIL_GD_PAUSE)) {
+            if(e->in_irq || C.current_event == KUI_NATIVE_RA_TICK) {
+                burst_retire(r);
+                return;
+            }
+            if(!burst_release(r)) return;
+        }
+        if(B.variant) {
+            burst_retire(r);
+            if(B.empty < TOY_BURST_EMPTY_LIMIT) burst_arm(r);
+        } else if(C.current_event == KUI_NATIVE_RA_DELIVER) suite_demand(wait, r);
+        return;
+    }
+    C.quiesced = 0;
+    if(!B.have_token || B.token != e->token) {
+        B.have_token = true;
+        B.token = e->token;
+        B.fallback = false;
+        burst_request_stats(&e->cursor, variant);
+    }
+    if(B.fallback && B.fallback_token == e->token) {
+        if(C.current_event == KUI_NATIVE_RA_DELIVER) suite_demand(wait ? 1u : 0u, r);
+        return;
+    }
+    uint32_t block = e->cursor.block;
+    uint32_t admitted = C.cache.count;
+    if(B.pending || r->shared.stream.state == KUI_TOY_SCI_BURST_DMA ||
+       r->shared.stream.state == KUI_TOY_SCI_BURST_TOKEN) admitted += B.frames;
+    if(B.variant != variant || block < C.cache.base || block >= C.cache.end ||
+       block - C.cache.base > admitted) {
+        if(e->in_irq) {
+            if(B.owned) burst_retire(r);
+            else suite_demand(wait, r);
+            return;
+        }
+        if(!burst_anchor(r, variant)) {
+            if(!e->failed && !B.owned && C.current_event == KUI_NATIVE_RA_DELIVER)
+                suite_demand(wait ? 1u : 0u, r);
+            return;
+        }
+    }
+    unsigned limit = e->in_irq ? KUI_RETAIL_NATIVE_IRQ_BATCH_LIMIT : e->target;
+    if(limit > 25u) limit = 25u;
+    /* Serve already-checked demand first, independently of any in-flight
+     * speculative transfer. No movie visit polls in a wait loop. */
+    unsigned fed = burst_feed(r, limit);
+    burst_retire(r);
+    if(fed < limit) fed += burst_feed(r, limit - fed);
+    if(e->failed) return;
+    if(!e->in_irq && e->active && !fed && !B.pending &&
+       (B.empty >= TOY_BURST_EMPTY_LIMIT ||
+        (!C.config.ops->busy() && !dma_idle()))) {
+        if(!burst_release(r)) return;
+        B.fallback = true;
+        B.fallback_token = e->token;
+        ++C.suite[3];
+        if(C.current_event == KUI_NATIVE_RA_DELIVER) suite_demand(wait ? 1u : 0u, r);
+        return;
+    }
+    if(B.empty < TOY_BURST_EMPTY_LIMIT) burst_arm(r);
+}
+
+#undef METRIC
+#undef B
+#if KUI_TOY_SUITE_MODE == 27 || KUI_TOY_SUITE_MODE == 28
+#undef BURST_METRIC_ADD
+#endif
diff --git a/src/loader/toy_suite_quiet_burst.inc b/src/loader/toy_suite_quiet_burst.inc
new file mode 100644
index 00000000..a14ccf1e
--- /dev/null
+++ b/src/loader/toy_suite_quiet_burst.inc
@@ -0,0 +1,161 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* Run before the game continues, through the same transport and CRC parser.
+ * Quiet data never reaches the guest or seeds the live cache. */
+enum {
+    TOY_QUIET_SAMPLED = 1u,
+    TOY_QUIET_UNMAPPED = 2u,
+    TOY_QUIET_UNAVAILABLE = 3u,
+    TOY_QUIET_STOPPED = 4u,
+    TOY_QUIET_UNSAFE = 5u,
+    TOY_QUIET_BURSTS = 16u,
+    TOY_QUIET_OPENING = 386u,
+    TOY_QUIET_LAG_WINDOW = 638u,
+    TOY_QUIET_TOKEN_POLLS = 32u,
+    TOY_QUIET_DMA_POLLS = 16384u,
+};
+
+/* Use the same raw-sector first block as an admitted 2048-byte game read.
+ * The cold stage already validated the map and the entire movie range. */
+static bool burst_quiet_window(const struct kui_retail_manifest *m, uint32_t offset,
+    uint32_t *first, uint32_t *end) {
+    const struct kui_toy_movie_range *intro = &C.config.movie_ranges[3];
+    if(!m || intro->count <= offset) return false;
+    uint32_t sector = intro->lba + offset;
+    for(unsigned track = 0; track < m->track_count; ++track) {
+        const struct kui_retail_track *t = &m->slots[track].track;
+        if(sector < t->start_lba || sector >= t->end_lba) continue;
+        if(kui_retail_track_sector_bytes(t) != KUI_GAME_RAW_BYTES ||
+           kui_retail_track_header_bytes(t) != 16u) return false;
+        uint32_t file_block = (kui_retail_track_file_offset(t) +
+            (sector - t->start_lba) * KUI_GAME_RAW_BYTES) >> 9;
+        uint32_t extent = kui_retail_track_first_extent(t);
+        for(unsigned i = 0; i < t->extent_count; ++i) {
+            const struct kui_retail_extent *x = &m->slots[extent + i].extent;
+            uint32_t delta = file_block - x->file_block;
+            if(delta >= x->blocks) continue;
+            struct kui_retail_cursor cursor = {
+                .manifest = m,
+                .track = track,
+                .block = x->card_lba + delta,
+            };
+            uint32_t limit = burst_extent_end(&cursor, 4u);
+            if(limit <= cursor.block) return false;
+            *first = cursor.block;
+            *end = cursor.block + (limit - cursor.block < TOY_QUIET_BURSTS * TOY_BURST_FRAMES ?
+                limit - cursor.block : TOY_QUIET_BURSTS * TOY_BURST_FRAMES);
+            return true;
+        }
+        return false;
+    }
+    return false;
+}
+
+static enum kui_sci_stream_result burst_quiet_one(kui_retail_async_region_type *r,
+    uint32_t lba, unsigned frames, uint32_t *covered_end) {
+    C.burst.lba = lba;
+    C.burst.frontier = lba;
+    C.burst.frames = frames;
+    enum kui_sci_stream_result result = KUI_SCI_STREAM_PENDING;
+    for(unsigned n = 0; n < TOY_QUIET_TOKEN_POLLS && result == KUI_SCI_STREAM_PENDING; ++n)
+        result = toy_sci_burst_start(r, lba, frames, burst_slab());
+    if(result != KUI_SCI_STREAM_OK) {
+        burst_record_start_error(result);
+        if(result == KUI_SCI_STREAM_PENDING) ++C.burst_quiet.timeout;
+        return result;
+    }
+    burst_record_arm(r->shared.stream.ready_lba[1]);
+    *covered_end = lba + frames;
+    uint32_t bytes = 0;
+    result = KUI_SCI_STREAM_PENDING;
+    for(unsigned n = 0; n < TOY_QUIET_DMA_POLLS && result == KUI_SCI_STREAM_PENDING; ++n) {
+#ifndef KUI_TOY_BURST_PRODUCER_TEST
+        toy_burst_settle(128u);
+#endif
+        result = toy_sci_burst_poll(r, burst_slab(), frames, &bytes);
+    }
+    if(result == KUI_SCI_STREAM_OK && bytes <= TOY_BURST_WIRE) {
+        burst_record_received(bytes);
+        burst_parse(TOY_BURST_FRAMES);
+    } else if(result == KUI_SCI_STREAM_PENDING) {
+        ++C.burst_quiet.timeout;
+    } else {
+        ++C.burst_quiet.reset;
+        result = KUI_SCI_STREAM_RESET;
+    }
+    return result;
+}
+
+static uint32_t __attribute__((noipa)) burst_quiet_calibrate(kui_retail_async_region_type *r) {
+    /* The cold stage invokes this once, even for a skipped sample. No
+     * subsequent game call can start calibration via the published entry. */
+    if(C.burst_quiet_status) return 0u;
+    const struct kui_native_ra_low_ops *o = C.config.ops;
+    struct kui_retail_async *e = &r->engine;
+    struct kui_sci_stream_state *stream = &r->shared.stream;
+    C.burst_quiet_status = TOY_QUIET_UNMAPPED;
+    if(C.suite_source != 1u) return 1u;
+    uint32_t first[2] = {0u, 0u}, end[2] = {0u, 0u};
+    bool early = burst_quiet_window(e->manifest, TOY_QUIET_OPENING, &first[0], &end[0]);
+    bool late = burst_quiet_window(e->manifest, TOY_QUIET_LAG_WINDOW, &first[1], &end[1]);
+    if(!early && !late) return 1u;
+    C.burst_quiet_status = TOY_QUIET_UNAVAILABLE;
+    if(!r->shared.service.initialized || r->shared.service.pending ||
+       r->shared.service.executing || e->active || e->in_irq || e->hooked ||
+       e->release.armed || e->release.depth || e->native_loan_state ||
+       stream->state > RA_PAUSED || o->busy() ||
+       r->shared.card.transport != KUI_STORAGE_SCI || !r->shared.card.device.sd.ready ||
+       r->shared.card.device.sd.slow || r->shared.card.stream.active || !dma_idle())
+        return 1u;
+    bool opened = e->opened != 0u;
+    if(e->opened != (uint32_t)r->shared.port.acquired || r->shared.port.fault) goto unsafe;
+    struct kui_sci_stream_state prior_stream = *stream;
+    struct kui_sci_sd_port prior_port = r->shared.port;
+    uint32_t guard_faults = C.stats.guard_faults, crc_errors = C.stats.crc_errors;
+    if(opened) {
+        if(o->stop() != KUI_SCI_STREAM_OK) goto unsafe;
+    } else if(!o->cold_bus(true)) {
+        if(e->opened || r->shared.port.acquired || r->shared.port.fault) goto unsafe;
+        return 1u;
+    }
+    C.burst_quiet_lba = first[0];
+    C.burst_quiet_end = first[0];
+    C.burst_quiet_late_lba = first[1];
+    C.burst_quiet_late_end = first[1];
+    C.burst.calibration = true;
+    C.burst_quiet_status = TOY_QUIET_SAMPLED;
+    for(unsigned band = 0; band < 2u && C.burst_quiet_status == TOY_QUIET_SAMPLED; ++band) {
+        uint32_t *covered_end = band ? &C.burst_quiet_late_end : &C.burst_quiet_end;
+        for(uint32_t lba = first[band]; lba < end[band];) {
+            uint32_t frames = end[band] - lba;
+            if(frames > TOY_BURST_FRAMES) frames = TOY_BURST_FRAMES;
+            if(!kui_native_ra_cache_rebase(&C.cache, lba, lba + frames)) goto unsafe;
+            enum kui_sci_stream_result result = burst_quiet_one(r, lba, frames, covered_end);
+            if(toy_sci_burst_stop(r, burst_slab(), frames) != KUI_SCI_STREAM_OK ||
+               o->busy() || stream->state || r->shared.port.fault ||
+               result == KUI_SCI_STREAM_RESET || C.stats.guard_faults != guard_faults)
+                goto unsafe;
+            if(result != KUI_SCI_STREAM_OK) {
+                C.burst_quiet_status = TOY_QUIET_STOPPED;
+                break;
+            }
+            lba += frames;
+        }
+    }
+    if(!opened && !o->cold_bus(false)) goto unsafe;
+    /* CMD12 retired the pre-existing paused command as well. Preserve its
+     * statistics and context, but invalidate its now-retired ready data. */
+    if(prior_stream.state) {
+        prior_stream.state = RA_CLOSED;
+        prior_stream.ready[0] = prior_stream.ready[1] = prior_stream.kept = 0u;
+        prior_stream.arrived = 0u;
+    }
+    *stream = prior_stream;
+    r->shared.port = prior_port;
+    C.stats.crc_errors = crc_errors;
+    memset(&C.burst, 0, sizeof(C.burst));
+    (void)kui_native_ra_cache_init(&C.cache, C.config.data, KUI_NATIVE_RA_CACHE_BYTES);
+    return 1u;
+unsafe:
+    C.burst_quiet_status = TOY_QUIET_UNSAFE;
+    return 0u;
+}
diff --git a/src/loader/toy_suite_ram_stage.inc b/src/loader/toy_suite_ram_stage.inc
new file mode 100644
index 00000000..681abd06
--- /dev/null
+++ b/src/loader/toy_suite_ram_stage.inc
@@ -0,0 +1,45 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include "kui/hash.h"
+/* Load a narrow original-data window while the cold stage owns the card. */
+static bool toy_suite_ram_seed(const struct kui_retail_track *track) {
+    const struct kui_toy_movie_range *movie=&toy_movie_ranges[3];
+    uint32_t center=KUI_TOY_SUITE_MODE==2?469080u:468128u;
+    uint32_t first=center-40u,last=center+40u;
+    if(movie->lba!=452810u || movie->count!=26208u ||
+       first<movie->lba || last>movie->lba+movie->count)return false;
+    uint32_t offset=kui_retail_track_file_offset(track);
+    uint32_t first_byte=offset+(first-track->start_lba)*KUI_GAME_RAW_BYTES;
+    uint32_t block=first_byte/512u;
+    uint32_t end=(offset+(last-track->start_lba)*KUI_GAME_RAW_BYTES+511u)/512u;
+    if(end-block>KUI_NATIVE_RA_DATA_BYTES/512u)return false;
+
+    /* The checked manifest maps each physical run; the window may cross
+     * one allocation boundary even when the two card runs are fragmented. */
+    struct kui_toy_suite_seed seed={{0},{0}};
+    uint32_t extent=kui_retail_track_first_extent(track),used=0u;
+    for(unsigned i=0u;i<track->extent_count && block<end;i++) {
+        const struct kui_retail_extent *e=&manifest.slots[extent+i].extent;
+        if(block<e->file_block || block-e->file_block>=e->blocks)continue;
+        if(used==2u)return false;
+        uint32_t count=e->blocks-(block-e->file_block);
+        if(count>end-block)count=end-block;
+        seed.base[used]=e->card_lba+block-e->file_block;
+        seed.count[used++]=count;
+        block+=count;
+    }
+    if(block!=end)return false;
+
+    uint8_t *out=toy_suite_data;
+    for(unsigned i=0u;i<used;i++) {
+        for(uint32_t j=0u;j<seed.count[i];j++,out+=512u) {
+            if(kui_retail_storage_read_run(&card,seed.base[i]+j,seed.count[i]-j,out)!=
+               KUI_LOADER_SD_OK)return false;
+        }
+    }
+    const uint8_t *raw=toy_suite_data+(first_byte&511u);
+    for(uint32_t sector=first;sector<last;sector++,raw+=KUI_GAME_RAW_BYTES) {
+        if(raw[15]!=1u || !kui_sector_edc_valid_at(raw,sector+150u))return false;
+    }
+    toy_suite_seed=seed;
+    return true;
+}
diff --git a/src/loader/toy_suite_report_save.inc b/src/loader/toy_suite_report_save.inc
new file mode 100644
index 00000000..d234af70
--- /dev/null
+++ b/src/loader/toy_suite_report_save.inc
@@ -0,0 +1,124 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* Terminal-only: the private issued Maple chain is retired before this
+ * code borrows its first three sectors. Gameplay has no SD write path. */
+#if !KUI_TOY_FMV_COMPARE
+static void toy_report_string(char **at,const char *text) {
+    while(*text)*(*at)++=*text++;
+}
+
+static void toy_report_row(char **at,const char *label,const uint32_t *values,unsigned count) {
+    toy_report_string(at,label);
+    *(*at)++='\n';
+    for(unsigned i=0;i<count;i++) {
+        if(i)*(*at)++=' ';
+        for(unsigned shift=32u;shift;shift-=4u)
+            *(*at)++="0123456789ABCDEF"[(values[i]>>(shift-4u))&15u];
+    }
+    *(*at)++='\n';
+}
+
+#if KUI_TOY_SUITE_MODE == 27 || KUI_TOY_SUITE_MODE == 28
+static void toy_report_burst(char **at,const char *label,const struct kui_toy_burst_metrics *m) {
+    toy_report_row(at,label,(uint32_t[]){m->arms,m->requested,m->received,m->dma_short,
+        m->dma_full,m->checked,m->parse_full_cut,m->bad_token,m->bad_crc,m->timeout,
+        m->reset,m->usable,m->command_error},13u);
+}
+
+static void toy_report_short(char **at,const char *label,const struct kui_toy_burst_cut *cut) {
+    toy_report_row(at,label,(uint32_t[]){cut->tcr,cut->chcr2,cut->c2dst,cut->g2adst},4u);
+}
+
+#if KUI_TOY_SUITE_MODE == 28
+static void toy_report_rate(char **at,const char *label,const struct kui_toy_burst_rate *rate) {
+    toy_report_row(at,label,(uint32_t[]){rate->arms,rate->dma_full,rate->checked},3u);
+}
+#endif
+
+static void toy_report_compare(char **at,const struct kui_native_ra_public *ra) {
+    toy_report_row(at,"MAPPED SOURCE",(uint32_t[]){ra->movie_mask,ra->suite_source},2u);
+    toy_report_row(at,"BUMPER SECT SPAN END FAIL CLK",ra->playback[0].progress,5u);
+    const struct kui_toy_playback_stats *intro=&ra->playback[1];
+    toy_report_row(at,"INTRO SECT SPAN END FAIL CLK",intro->progress,5u);
+    toy_report_row(at,"INTRO GD WAIT SCI MAXREQ",(uint32_t[]){intro->costs[0],
+        intro->costs[1],intro->costs[2],intro->reads[4]},4u);
+    toy_report_row(at,"QUIET STATUS START END LATESTART LATEEND",(uint32_t[]){ra->burst_quiet_status,
+        ra->burst_quiet_lba,ra->burst_quiet_end,ra->burst_quiet_late_lba,ra->burst_quiet_late_end},5u);
+    toy_report_string(at,"ARM REQB RXB SHORT FULL OK PCUT TOK CRC TIMEOUT RESET USE CMD\n");
+    toy_report_burst(at,"QUIET",&ra->burst_quiet);
+#if KUI_TOY_SUITE_MODE == 27
+    toy_report_burst(at,"MATCH",&ra->burst_match);
+#endif
+    toy_report_burst(at,"LIVE",&ra->burst_live);
+#if KUI_TOY_SUITE_MODE == 28
+    toy_report_rate(at,"FAST ARM FULL CHECKED",&ra->burst_fast);
+    toy_report_rate(at,"SLOW ARM FULL CHECKED",&ra->burst_slow);
+#endif
+    toy_report_short(at,"LAST LIVE SHORT TCR CHCR2 C2DST G2ADST",&ra->burst_live.last_short);
+    const uint32_t *burst=ra->diagnostics.stage_result[KUI_NATIVE_RA_STAGE_NONE];
+    toy_report_row(at,"LIVE REQ FIRST READY FALLBACK LEAD",(uint32_t[]){burst[0],burst[1],
+        ra->suite[4],ra->suite[3],burst[2]},5u);
+}
+#endif
+
+static void toy_report_format(char *text,const struct kui_native_ra_public *ra,
+    const struct kui_sci_stream_stats *sd,unsigned test) {
+    /* The terminal format tests also exercise every field at full width. */
+    memset(text,' ',KUI_TOY_REPORT_FILE_BYTES);
+    char *at=text;
+    toy_report_string(&at,"K-UI TOY COMMANDER REPORT\nTEST ");
+    if(test>=10u)*at++=(char)('0'+test/10u);
+    *at++=(char)('0'+test%10u);
+    toy_report_string(&at,"\nBUILD " KUI_BUILD_ID "\nVALUES HEX / TIMER 781250 HZ\n");
+#if KUI_TOY_SUITE_MODE == 27 || KUI_TOY_SUITE_MODE == 28
+    (void)sd;
+    toy_report_compare(&at,ra);
+#else
+    toy_report_row(&at,"MAPPED SEEN",&ra->movie_mask,1u);
+    for(unsigned i=0;i<2u;i++) {
+        const struct kui_toy_playback_stats *p=&ra->playback[i];
+        toy_report_row(&at,i?"INTRO SECT SPAN END FAIL CLK":"BUMPER SECT SPAN END FAIL CLK",p->progress,5u);
+        toy_report_row(&at,"GD WAIT SCI MAX-GD MAX-SCI",p->costs,5u);
+        toy_report_row(&at,"GAP LBA GD-BLOCKS SCI-BLOCKS MAX-REQ",p->reads,5u);
+    }
+#if KUI_TOY_SUITE_MODE == 1
+    toy_report_row(&at,"LOADED CHECKED BAD-LBA BYTE DATA",ra->suite,5u);
+#elif KUI_TOY_SUITE_MODE == 2 || KUI_TOY_SUITE_MODE == 6
+    toy_report_row(&at,"RAM-BLOCKS HITS FIRST LAST MISS",ra->suite,5u);
+#elif KUI_TOY_SUITE_MODE == 3
+    toy_report_row(&at,"GUARDED PIO BUMPER INTRO",ra->suite,2u);
+#elif KUI_TOY_SUITE_MODE == 4
+    toy_report_row(&at,"BUDGET YIELDS BUMPER INTRO",ra->suite,2u);
+#elif KUI_TOY_SUITE_MODE == 7
+    toy_report_row(&at,"SERIAL BLOCKS BUMPER INTRO",ra->suite,2u);
+#elif KUI_TOY_SUITE_MODE == 26
+    toy_report_row(&at,"BURST ARM CHECKED CUT FALLBACK READY",ra->suite,5u);
+    const uint32_t *burst=ra->diagnostics.stage_result[KUI_NATIVE_RA_STAGE_NONE];
+    toy_report_row(&at,"BURST REQUEST FIRST LEAD WIRE",burst,4u);
+    toy_report_row(&at,"BURST TICK SUM MAX",burst+4u,2u);
+#endif
+    toy_report_row(&at,"SD-BLOCKS PIO START OVR CRC",(uint32_t[5]){
+        sd->blocks,sd->polled,sd->starts,sd->overruns,sd->crc_errors},5u);
+    toy_report_row(&at,"SOURCE TOKEN REPAIR AHEAD DEFER",(uint32_t[5]){
+        ra->suite_source,sd->token_errors,sd->repaired,sd->ahead,sd->deferred},5u);
+    toy_report_string(&at,"SOURCE 1=RAW2352 2=COOKED2048\n");
+#endif
+    /* End marker follows the second physical block even for short reports. */
+    memcpy(text+KUI_TOY_REPORT_FILE_BYTES-12u,"\nEND REPORT\n",12u);
+}
+#endif
+
+static bool toy_suite_save_report(const struct kui_native_ra_public *ra,
+    const kui_retail_async_region_type *r) {
+    if(!config.toy_report.test || !state.armed || state.pending ||
+       state.submitted!=state.completed || !reader_only() ||
+       (current_sr()&0xf0u)!=0xf0u || !lease_valid() || !stack_valid())return false;
+    _Static_assert(sizeof(issued_chain)>=3u*KUI_TOY_REPORT_SECTOR_BYTES,"terminal report workspace");
+#if KUI_TOY_FMV_COMPARE
+    (void)r;
