+static void wake_first_cut_pio(unsigned receives) {
+    for(unsigned n = 0u; payload_calls < receives; ++n) {
+        CHECK(n < 24u && !kui_sci_stream_busy());
+        CHECK(independent_demand_wake());
+        CHECK(!m.brr && !m.rx_brr);
+    }
+    CHECK(payload_calls == receives);
+}
