diff --git a/src/loader/disc_toy_trace.ld b/src/loader/disc_toy_trace.ld
new file mode 100644
index 00000000..92198db2
--- /dev/null
+++ b/src/loader/disc_toy_trace.ld
@@ -0,0 +1,23 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+OUTPUT_FORMAT("elf32-shl")
+OUTPUT_ARCH(sh)
+ENTRY(_kui_disc_toy_gd_proxy)
+PHDRS { image PT_LOAD FLAGS(7); }
+SECTIONS {
+ . = 0xacfd0000;
+ .exports : { KEEP(*(.exports)) } :image
+ ASSERT(SIZEOF(.exports)==24,"physical Toy trace exports ABI")
+ .text : { *(.text .text.*) } :image
+ .rodata : { *(.rodata .rodata.*) } :image
+ .data : { *(.data .data.*) } :image
+ . = ALIGN(32);
+ __disc_toy_trace_binary_end = .;
+ .bss (NOLOAD) : {
+  *(.bss .bss.* COMMON)
+  . = ALIGN(32);
+  __disc_toy_trace_bss_end = .;
+ } :image
+ .stack (NOLOAD) : { . += 4096; __disc_toy_trace_stack_top = .; } :image
+ ASSERT(.<=0xacfe0000,"physical Toy trace overlaps game scratch RAM")
+ /DISCARD/ : { *(.comment) *(.note*) *(.eh_frame*) }
+}
diff --git a/src/loader/disc_toy_trace_asm.S b/src/loader/disc_toy_trace_asm.S
new file mode 100644
index 00000000..57de5a7f
--- /dev/null
+++ b/src/loader/disc_toy_trace_asm.S
@@ -0,0 +1,136 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#define JOIN_(a,b) a##b
+#define JOIN(a,b) JOIN_(a,b)
+#define C(name) JOIN(__USER_LABEL_PREFIX__,name)
+
+    .section .exports,"a"
+    .long C(kui_disc_toy_gd_proxy),C(kui_disc_toy_finish),C(kui_disc_toy_config)
+    .long __disc_toy_trace_binary_end,__disc_toy_trace_bss_end,C(kui_disc_toy_finish)
+
+/* Keep the firmware call on its original stack and with the complete caller
+ * context. Only the outermost tracked call gets a return-address relay. */
+    .macro TRACE_SAVE
+    mov.l r0,@-r15
+    mov.l r1,@-r15
+    mov.l r2,@-r15
+    mov.l r3,@-r15
+    mov.l r4,@-r15
+    mov.l r5,@-r15
+    mov.l r6,@-r15
+    mov.l r7,@-r15
+    mov.l r8,@-r15
+    mov.l r9,@-r15
+    mov.l r10,@-r15
+    mov.l r11,@-r15
+    mov.l r12,@-r15
+    mov.l r13,@-r15
+    mov.l r14,@-r15
+    sts.l pr,@-r15
+    stc.l sr,@-r15
+    stc.l vbr,@-r15
+    stc.l gbr,@-r15
+    sts.l mach,@-r15
+    sts.l macl,@-r15
+    stc sr,r0
+    or #0xf0,r0
+    ldc r0,sr
+    .endm
+
+    .macro TRACE_RESTORE
+    mov r8,r15
+    lds.l @r15+,macl
+    lds.l @r15+,mach
+    ldc.l @r15+,gbr
+    ldc.l @r15+,vbr
+    add #4,r15
+    lds.l @r15+,pr
+    mov.l @r15+,r14
+    mov.l @r15+,r13
+    mov.l @r15+,r12
+    mov.l @r15+,r11
+    mov.l @r15+,r10
+    mov.l @r15+,r9
+    mov.l @r15+,r8
+    mov.l @r15+,r7
+    mov.l @r15+,r6
+    mov.l @r15+,r5
+    mov.l @r15+,r4
+    mov.l @r15+,r3
+    mov.l @r15+,r2
+    mov.l @r15+,r1
+    mov r15,r0
+    add #-64,r0
+    mov.l @r0,r0
+    ldc r0,sr
+    .endm
+
+    .text
+    .align 2
+    .global C(kui_disc_toy_gd_proxy)
+C(kui_disc_toy_gd_proxy):
+    /* EXEC and every unrelated operation tail-delegate with only two
+     * temporary words. Native firmware still receives the original SR. */
+    mov.l r0,@-r15
+    stc.l sr,@-r15
+    mov r7,r0
+    cmp/eq #0,r0
+    bt .Ltrack
+    cmp/eq #1,r0
+    bt .Ltrack
+    ldc.l @r15+,sr
+    mov.l .Lconfig,r0
+    mov.l @r0,r0
+    jmp @r0
+    mov.l @r15+,r0
+.Ltrack:
+    ldc.l @r15+,sr
+    mov.l @r15+,r0
+    TRACE_SAVE
+    mov r15,r8
+    mov.l .Lactive,r9
+    mov.l @r9,r0
+    tst r0,r0
+    bf .Ldelegate
+    mov.l .Lstack,r15
+    mov r8,r4
+    mov.l .Lbefore,r0
+    jsr @r0
+    nop
+.Ldelegate:
+    TRACE_RESTORE
+    mov.l .Lconfig,r0
+    mov.l @r0,r0
+    jmp @r0
+    mov.l @r15+,r0
+
+    .align 2
+    .global C(kui_disc_toy_gd_return)
+C(kui_disc_toy_gd_return):
+    TRACE_SAVE
+    mov r15,r8
+    mov.l .Lstack,r15
+    mov r8,r4
+    mov.l .Lafter,r0
+    jsr @r0
+    nop
+    TRACE_RESTORE
+    rts
+    mov.l @r15+,r0
+
+    .align 2
+    .global C(kui_disc_toy_finish)
+C(kui_disc_toy_finish):
+    stc sr,r0
+    or #0xf0,r0
+    ldc r0,sr
+    mov.l .Lstack,r15
+    mov.l .Lterminal,r0
+    jmp @r0
+    nop
+    .align 2
+.Lactive: .long C(kui_disc_toy_gd_active)
+.Lconfig: .long C(kui_disc_toy_config)
+.Lstack: .long __disc_toy_trace_stack_top
+.Lbefore: .long C(kui_disc_toy_gd_before)
+.Lafter: .long C(kui_disc_toy_gd_after)
+.Lterminal: .long C(kui_disc_toy_terminal)
diff --git a/src/loader/disc_toy_trace_stage.S b/src/loader/disc_toy_trace_stage.S
new file mode 100644
index 00000000..d84822bf
--- /dev/null
+++ b/src/loader/disc_toy_trace_stage.S
@@ -0,0 +1,63 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#define JOIN_(a,b) a##b
+#define JOIN(a,b) JOIN_(a,b)
+#define C(name) JOIN(__USER_LABEL_PREFIX__,name)
+#include "kui/toy_pilot_boot.h"
+
+/* Bootstrap has reached the verified original heap-init call. The known
+ * caller has IMASK15. Run the native initializer on its original stack,
+ * then keep its post-call state while our installer uses a high stack. */
+    .text
+    .align 2
+    .global C(kui_disc_toy_heap_hook)
+C(kui_disc_toy_heap_hook):
+    mov.l .Lsaved,r0
+    mov.l r4,@(4,r0)
+    mov.l r5,@(8,r0)
+    mov.l r15,@(12,r0)
+    sts pr,r1
+    mov.l r1,@r0
+    mov.l .Lnative,r3
+    jsr @r3
+    nop
+    sts.l mach,@-r15
+    sts.l macl,@-r15
+    stc.l sr,@-r15
+    mov.l r0,@-r15
+    mov.l r1,@-r15
+    mov.l r2,@-r15
+    mov.l r3,@-r15
+    mov.l r4,@-r15
+    mov.l r5,@-r15
+    mov.l r6,@-r15
+    mov.l r7,@-r15
+    mov.l r8,@-r15
+    mov.l .Lsaved,r4
+    mov.l @r4,r0
+    mov.l r0,@-r15
+    mov r15,r8
+    mov.l .Lstage_stack,r15
+    mov.l .Linstall,r0
+    jsr @r0
+    nop
+    mov r8,r15
+    lds.l @r15+,pr
+    mov.l @r15+,r8
+    mov.l @r15+,r7
+    mov.l @r15+,r6
+    mov.l @r15+,r5
+    mov.l @r15+,r4
+    mov.l @r15+,r3
+    mov.l @r15+,r2
+    mov.l @r15+,r1
+    mov.l @r15+,r0
+    ldc.l @r15+,sr
+    lds.l @r15+,macl
+    lds.l @r15+,mach
+    rts
+    nop
+    .align 2
+.Lsaved: .long C(kui_disc_toy_heap_call)
+.Lnative: .long KUI_TOY_BOOT_HEAP_INIT
+.Linstall: .long C(kui_disc_toy_install)
+.Lstage_stack: .long 0x8cff0000
diff --git a/src/loader/disc_toy_trace_stage.inc b/src/loader/disc_toy_trace_stage.inc
new file mode 100644
index 00000000..4a7e7b4f
--- /dev/null
+++ b/src/loader/disc_toy_trace_stage.inc
@@ -0,0 +1,137 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include "disc_toy_trace.h"
+#include "kui/gd_service.h"
+#include "kui/toy_pilot_boot.h"
+#include "kui/vmu_launch_package.h"
+
+/* Bound only by the explicit physical Toy diagnostic GUI action. Keep blank
+ * module markers distinct from all literal code and verify before use. */
+__asm__(".section .rodata.disc_toy_trace_seeds,\"a\"\n.balign 4\n"
+        ".global __disc_toy_report_seed\n__disc_toy_report_seed:\n"
+        ".ascii \"KUITRS01\"\n.long 1,64\n.zero 48\n"
+        ".global __disc_toy_range_seed\n__disc_toy_range_seed:\n"
+        ".ascii \"KUITFR01\"\n.zero 32\n.previous\n"
+        ".section .rodata.disc_toy_trace_worker,\"a\"\n.balign 4\n"
+        ".global __disc_toy_worker_begin\n__disc_toy_worker_begin:\n"
+        ".incbin \"" KUI_DISC_TOY_TRACE_BIN "\"\n"
+        ".global __disc_toy_worker_end\n__disc_toy_worker_end:\n.previous\n");
+extern const uint8_t disc_toy_worker_begin[] __asm__("__disc_toy_worker_begin");
+extern const uint8_t disc_toy_worker_end[] __asm__("__disc_toy_worker_end");
+extern const struct kui_toy_report_wire disc_toy_report_seed __asm__("__disc_toy_report_seed");
+struct disc_toy_range_seed {
+    uint32_t magic[2];
+    struct kui_toy_movie_range movie[4];
+};
+extern const struct disc_toy_range_seed disc_toy_ranges __asm__("__disc_toy_range_seed");
+_Static_assert(sizeof(struct disc_toy_range_seed)==40u,"physical movie ranges ABI");
+
+void kui_disc_toy_heap_hook(void);
+static uint32_t disc_toy_firmware;
+uint32_t kui_disc_toy_heap_call[4];
+
+static uint32_t toy_word(uint32_t address) {
+    return *(volatile const uint32_t *)(uintptr_t)address;
+}
+
+static void toy_publish(uint32_t address, uint32_t value) {
+    *(volatile uint32_t *)(uintptr_t)address=value;
+    __asm__ volatile("ocbp @%0"::"r"(address&~31u):"memory");
+}
+
+static bool toy_ranges_valid(void) {
+    if(disc_toy_ranges.magic[0]!=0x5449554bu || disc_toy_ranges.magic[1]!=0x31305246u)
+        return false;
+    for(unsigned i=0;i<4u;i++) {
+        struct kui_toy_movie_range current=disc_toy_ranges.movie[i];
+        if(current.lba<45000u || current.lba>=719850u ||
+           !current.count || current.count>719850u-current.lba) return false;
+        for(unsigned j=0;j<i;j++) {
+            struct kui_toy_movie_range other=disc_toy_ranges.movie[j];
+            if(current.lba<other.lba+other.count && other.lba<current.lba+current.count &&
+               (i/2u!=j/2u || current.lba!=other.lba || current.count!=other.count)) return false;
+        }
+    }
+    return true;
+}
+
+static bool toy_report_valid(void) {
+    const struct kui_toy_report_wire *seed=&disc_toy_report_seed;
+    return seed->magic[0]==KUI_TOY_REPORT_MAGIC0 && seed->magic[1]==KUI_TOY_REPORT_MAGIC1 &&
+        seed->version==KUI_TOY_REPORT_VERSION && seed->bytes==sizeof(*seed) &&
+        seed->test==KUI_DISC_TOY_TRACE_TEST && !seed->reserved && seed->high_capacity<=1u &&
+        seed->lba[0] && seed->lba[1] && seed->lba[0]!=seed->lba[1] &&
+        kui_stage_crc32(0u,seed,KUI_TOY_REPORT_CRC_OFFSET)==seed->crc32;
+}
+
+static void toy_trace_prepare(uint32_t firmware) {
+    static const uint8_t toy_sha[32]={
+        0xee,0x68,0xa3,0x26,0xda,0x96,0x4f,0xec,0x58,0x92,0xb7,0x22,0x63,0x11,0xf2,0x29,
+        0x3f,0xd3,0xa0,0xbb,0xf5,0xba,0xc4,0x96,0xec,0x82,0x99,0x19,0x64,0xd4,0x9b,0xbd};
+    if(plan.ip_crc32!=KUI_VMU_LAUNCH_TOY_IP_CRC ||
+       plan.exec_crc32!=KUI_VMU_LAUNCH_TOY_EXEC_CRC ||
+       plan.exec_bytes!=KUI_VMU_LAUNCH_TOY_EXEC_BYTES || memcmp(plan.exec_sha256,toy_sha,sizeof(toy_sha)) ||
+       !toy_ranges_valid() || !toy_report_valid()) stopped("TOY RELEASE OR REPORT REFUSED",5u);
+    if(toy_word(KUI_TOY_BOOT_HEAP_POOL)!=KUI_TOY_BOOT_HEAP_INIT ||
+       toy_word(KUI_TOY_BOOT_RESET_CALLBACK_POOL)!=KUI_TOY_BOOT_RESET_CALLBACK_NATIVE ||
+       *(volatile const uint16_t *)KUI_TOY_BOOT_RESET_REGISTER_SITE!=KUI_TOY_BOOT_RESET_REGISTER_WORD ||
+       *(volatile const uint16_t *)KUI_TOY_BOOT_RESET_INVOKE_SITE!=KUI_TOY_BOOT_RESET_INVOKE_WORD)
+        stopped("TOY HEAP OR RESET HOOK REFUSED",6u);
+    disc_toy_firmware=firmware;
+    toy_publish(KUI_TOY_BOOT_HEAP_POOL,(uint32_t)(uintptr_t)kui_disc_toy_heap_hook);
+}
+
+static bool worker_entry(uint32_t address, uint32_t binary_end) {
+    return !(address&1u) && address>=KUI_DISC_TOY_TRACE_LINK+sizeof(struct kui_disc_toy_trace_exports) &&
+        address<binary_end;
+}
+
+void kui_disc_toy_install(const uint32_t call[4]) {
+    uint32_t sr;
