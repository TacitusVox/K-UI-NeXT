new file mode 100644
index 00000000..d87bfadc
--- /dev/null
+++ b/tests/test_toy_original_movie_chunk.py
@@ -0,0 +1,198 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-only
+"""Execute the original AVI selection and linked Test 42 call-site witness.
+
+The fixture supplies only stream objects and entries. The native call site,
+selection and return paths execute the supplied original SH instructions. The
+division helper and observer ABI boundary are modeled. No game bytes are embedded.
+"""
+
+import argparse
+from hashlib import sha256
+from itertools import product
+from pathlib import Path
+import struct
+
+from test_toy_original_gd_poll import (
+    MASK, SH, SOURCE_BYTES, SOURCE_SHA256, STACK, ReleaseSH, read_elf,
+    signed, symbol_bytes, validate_delay_slot,
+)
+
+
+IMAGE_BASE = 0x8C010000
+CALL_PREPARE = 0x8C08D884
+CALL_RETURN = 0x8C08D898
+CALL_LITERAL = 0x8C08D950
+ACQUIRE = 0x8C08EDBC
+RING_MODULO = 0x8C081B74
+OTHER_RETURN = 0x8C008A00
+CTX, STREAM, CHANNEL, AVI, ENTRIES, RING = (0x8C200000 + n * 0x400 for n in range(6))
+CASES = {
+    "ready": (5, 128, 7, 1),
+    "empty-ready": (1, 0, 7, 1),
+    "pending": (0, 128, 7, -2),
+    "unavailable": (2, 128, 7, -4),
+    "missing": (1, 128, 8, -1),
+}
+
+
+class ChunkReplay(ReleaseSH):
+    def __init__(self, image, aux, case, tracked, initial_t):
+        SH.__init__(self, image)
+        self.active = False
+        self.macl = 0
+        self.hook = self.observer = None
+        self.observations = []
+        self.original_entries = []
+        self.tracked = tracked
+        self.initial_t = initial_t
+        self.return_pc = CALL_RETURN if tracked else OTHER_RETURN
+        self.expected_stack_arg = 1 if tracked else 2
+        self.write(CTX + 8, STREAM)
+        self.write(STREAM + 4, CHANNEL)
+        self.write(STREAM + 12, 30)
+        self.write(CHANNEL + 4, 7)
+        self.write(CHANNEL + 68, AVI)
+        self.write(AVI + 20, 2048)
+        self.write(AVI + 28, RING)
+        self.write(AVI + 56, ENTRIES)
+        self.write(AVI + 68, 3)
+        flags, count, kind, _ = CASES[case]
+        for index in (1, 2):
+            entry = ENTRIES + index * 12
+            self.write(entry, 0x811 + 4 * (index - 1))
+            self.write(entry + 4, count)
+            self.write(entry + 8, kind, 1)
+            self.write(entry + 9, flags, 1)
+        if aux:
+            data, _, segments, _, symbols = aux
+            self.hook = symbols["_kui_toy_movie_chunk_hook"][0]
+            self.observer = symbols["_kui_toy_movie_chunk_observe"][0]
+            for kind, offset, address, _, stored, memory, _, _ in segments:
+                if kind == 1:
+                    self.store_block(address, data[offset:offset + stored] + bytes(memory - stored))
+            self.write(CALL_LITERAL, self.hook)
+
+    def plain(self, op, pc):
+        n, m = (op >> 8) & 15, (op >> 4) & 15
+        if op & 0xF0FF == 0x002A:  # sts PR,Rn
+            self.r[n] = self.pr
+        elif op & 0xF0FF == 0x402A:  # lds Rn,PR
+            self.pr = self.r[n]
+        elif op & 0xF0FF == 0x4011:  # cmp/pz Rn
+            self.flag(signed(self.r[n], 32) >= 0)
+        elif op & 0xF0FF == 0x4015:  # cmp/pl Rn
+            self.flag(signed(self.r[n], 32) > 0)
+        elif op & 0xF00F in (0x3003, 0x3007):  # cmp/ge and cmp/gt
+            left, right = signed(self.r[n], 32), signed(self.r[m], 32)
+            self.flag(left >= right if op & 15 == 3 else left > right)
+        elif op & 0xF00F == 0x000C:  # mov.b @(R0,Rm),Rn
+            self.r[n] = signed(self.read((self.r[0] + self.r[m]) & MASK, 1), 8) & MASK
+        elif op & 0xFF00 == 0x8400:  # mov.b @(disp,Rm),R0
+            self.r[0] = signed(self.read(self.r[m] + (op & 15), 1), 8) & MASK
+        else:
+            return super().plain(op, pc)
+        self.executing = pc
+        self.instructions += 1
+
+    def run_chunk(self):
+        self.flag(self.initial_t)
+        self.r[14] = CTX
+        saved = self.r[8:15]
+        args = (STREAM, CTX + 0x84, CTX + 0x7C, 1)
+        if self.tracked:
+            self.pc, self.r[15] = CALL_PREPARE, STACK + 4
+        else:
+            self.pc, self.r[15] = self.hook or ACQUIRE, STACK
+            self.pr = OTHER_RETURN
+            self.r[4:8] = args
+            self.write(STACK, self.expected_stack_arg)
+        for _ in range(512):
+            pc = self.pc
+            if pc == self.return_pc:
+                assert self.pr == pc and self.r[15] == STACK and self.r[8:15] == saved
+                assert self.read(STACK) == self.expected_stack_arg
+                assert len(self.original_entries) == 1
+                return self.r[0], self.sr, self.block(CTX, 0x250), self.block(STREAM, 0x40)
+            if pc == ACQUIRE:
+                assert tuple(self.r[4:8]) == args and self.sr & 1 == self.initial_t
+                assert self.read(self.r[15]) == self.expected_stack_arg
+                assert self.r[15] == STACK - (16 if self.hook and self.tracked else 0)
+                if not self.tracked:
+                    assert self.pr == OTHER_RETURN
+                self.original_entries.append(pc)
+            if pc == RING_MODULO:
+                assert self.pr == 0x8C08EF06 and self.r[0] == 2048
+                self.r[0] = self.r[1] % self.r[0]
+                self.pc = self.pr
+                continue
+            if pc == self.observer:
+                assert self.tracked and self.r[4] == CTX and self.r[15] == STACK - 16
+                self.observations.append(self.r[5])
+                self.flag(not self.sr & 1)
+                self.r[:8] = [0xDEAD0000 + i for i in range(8)]
+                self.pc = self.pr
+                continue
+            self.step()
+        raise AssertionError("AVI acquisition exceeded its bounded path")
+
+    def step(self):
+        pc = self.pc
+        op = self.read(pc, 2)
+        target, delay = pc + 2, False
+        if op >> 12 == 0xA:  # bra
+            target, delay = pc + 4 + 2 * signed(op & 0xFFF, 12), True
+        elif op & 0xF0FF in (0x400B, 0x402B):  # jsr and jmp
+            target, delay = self.r[(op >> 8) & 15], True
+            if op & 0xF0FF == 0x400B:
+                self.pr = pc + 4
+        elif op == 0x000B:  # rts
+            target, delay = self.pr, True
+        elif op >> 8 in (0x89, 0x8B, 0x8D, 0x8F):
+            delay = op >> 8 in (0x8D, 0x8F)
+            if bool(self.sr & 1) == (op >> 8 in (0x89, 0x8D)):
+                target = pc + 4 + 2 * signed(op & 255, 8)
+            else:
+                target = pc + (4 if delay else 2)
+        else:
+            self.plain(op, pc)
+        if delay:
+            slot = self.read(pc + 2, 2)
+            validate_delay_slot(slot, pc)
+            self.plain(slot, pc + 2)
+        self.pc = target & MASK
+
+
+def verify_case(image, aux, case, tracked, initial_t):
+    baseline = ChunkReplay(image, None, case, tracked, initial_t)
+    expected = CASES[case][3]
+    if expected >= 0 and not tracked:
+        expected = 2
+    result = baseline.run_chunk()
+    assert signed(result[0], 32) == expected, (case, result[0], expected)
+    linked = ChunkReplay(image, aux, case, tracked, initial_t)
+    assert linked.run_chunk() == result, (case, tracked, initial_t)
+    assert linked.observations == ([expected & MASK] if tracked else [])
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("original", type=Path)
+    parser.add_argument("aux", type=Path, help="Linked Test 42 auxiliary ELF")
+    args = parser.parse_args()
+    image = args.original.read_bytes()
+    assert len(image) == SOURCE_BYTES and sha256(image).hexdigest() == SOURCE_SHA256
+    assert struct.unpack_from("<I", image, CALL_LITERAL - IMAGE_BASE) == (ACQUIRE,)
+    aux = read_elf(args.aux)
+    entry, _, section = symbol_bytes(aux, "_kui_toy_movie_chunk_hook", 2)
+    _, exports, _ = symbol_bytes(aux, "_kui_native_readahead_aux_exports", 1)
+    assert section[2] & 7 == 6 and not entry & 1
+    words = struct.unpack("<16I", exports)
+    assert words[11:] == (entry, 0, 0, 0, 0) and words[10] != entry
+    for case, tracked, initial_t in product(CASES, (True, False), (0, 1)):
+        verify_case(image, aux, case, tracked, initial_t)
+    print("Original AVI acquisition plus linked witness: 20 return, T and fifth-argument cases.")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/test_toy_pio_payload.c b/tests/test_toy_pio_payload.c
new file mode 100644
index 00000000..f9aa69ca
--- /dev/null
+++ b/tests/test_toy_pio_payload.c
@@ -0,0 +1,189 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* Exercise the real Test 41 helper with delayed SCI flags and strict credit. */
+#include "sci_sd_bus.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+#define SMR 0xffe00000u
+#define BRR 0xffe00004u
+#define SCR 0xffe00008u
+#define TDR 0xffe0000cu
+#define SSR 0xffe00010u
+#define RDR 0xffe00014u
+#define PTR 0xffe00018u
+#define STB 0xffc00004u
+#define PCTR 0xff80002cu
+#define PDTR 0xff800030u
+enum { TDRE = 0x80u, RDRF = 0x40u, ORER = 0x20u, TEND = 0x04u, CARD_OFF = 0x80u };
+enum { PAYLOAD = 512u, WIRE = PAYLOAD + 2u, GUARD = 16u };
+
+static struct {
+    uint8_t smr, brr, scr, tdr, ssr, rdr, ptr, stb;
+    uint16_t pdtr;
+    uint32_t pctr;
+    unsigned reads, writes, scr_enables, tdr_writes, launched, drained, polls, delay;
+    unsigned timeout_at, overrun_at;
+    bool shifting, saw_tdre, saw_rdrf;
+} hw;
+
+static uint8_t expected(unsigned index) {
+    if(index >= PAYLOAD) return index == PAYLOAD ? 0x96u : 0x3du;
+    return (uint8_t)(11u + index * 37u);
+}
+
+static uint8_t reverse_reference(uint8_t value) {
+    uint8_t reversed = 0u;
+    for(unsigned i = 0u; i < 8u; ++i) {
+        reversed = (uint8_t)((reversed << 1) | (value & 1u));
+        value >>= 1;
+    }
+    return reversed;
+}
+
+static void progress(void) {
+    if(!hw.shifting) return;
+    /* The transmit holding register clears before the pending wire byte
+     * reaches RDR. TDRE on its own must never grant another receive. */
+    hw.ssr |= TDRE;
+    if(hw.launched == hw.timeout_at) return;
+    if(--hw.delay) return;
+    hw.shifting = false;
+    hw.ssr |= TEND;
+    if(hw.launched == hw.overrun_at) {
+        hw.ssr |= ORER;
+        return;
+    }
+    assert(!(hw.ssr & RDRF));
+    hw.rdr = reverse_reference(expected(hw.launched - 1u));
+    hw.ssr |= RDRF;
+}
+
+uint32_t kui_sci_sd_test_read(uint32_t address, unsigned width) {
+    ++hw.reads;
+    switch(address) {
+    case SMR: assert(width == 1u); return hw.smr;
+    case BRR: assert(width == 1u); return hw.brr;
+    case SCR: assert(width == 1u); return hw.scr;
+    case SSR:
+        assert(width == 1u);
+        ++hw.polls;
+        progress();
+        if(hw.ssr & TDRE) hw.saw_tdre = true;
+        if(hw.ssr & RDRF) hw.saw_rdrf = true;
+        return hw.ssr;
+    case RDR:
+        assert(width == 1u && hw.saw_rdrf && (hw.ssr & RDRF));
+        assert(hw.launched == hw.drained + 1u && !hw.shifting);
+        ++hw.drained;
+        return hw.rdr;
+    case PTR: assert(width == 1u); return hw.ptr;
+    case STB: assert(width == 1u); return hw.stb;
+    case PDTR: assert(width == 2u); return hw.pdtr;
+    case PCTR: assert(width == 4u); return hw.pctr;
+    default: assert(!"unexpected SCI read (DMA and other MMIO are forbidden)"); return 0u;
+    }
+}
+
+void kui_sci_sd_test_write(uint32_t address, uint32_t value, unsigned width) {
+    ++hw.writes;
+    switch(address) {
+    case SMR: assert(width == 1u); hw.smr = (uint8_t)value; return;
+    case BRR: assert(width == 1u && !hw.shifting); hw.brr = (uint8_t)value; return;
+    case SCR:
+        assert(width == 1u && (value == 0u || value == 0x30u));
+        hw.scr = (uint8_t)value;
+        if(value) ++hw.scr_enables;
+        else if(hw.shifting) {
+            assert(hw.launched == hw.timeout_at);
+            hw.shifting = false;
+            hw.ssr |= TDRE | TEND;
+        }
+        return;
+    case TDR:
+        assert(width == 1u && value == 0xffu && (hw.ssr & TDRE) && hw.saw_tdre);
+        ++hw.tdr_writes;
+        hw.tdr = (uint8_t)value;
+        return;
+    case SSR: {
+        assert(width == 1u);
+        bool launch = (hw.scr & 0x20u) && (hw.ssr & TDRE) && !(value & TDRE);
+        if((hw.ssr & RDRF) && !(value & RDRF)) {
+            assert(hw.saw_rdrf && hw.launched == hw.drained);
+            hw.saw_rdrf = false;
+        }
+        hw.ssr = (uint8_t)((hw.ssr & value & 0xf8u) | (hw.ssr & 7u));
+        if(launch) {
+            assert(hw.saw_tdre && hw.tdr == 0xffu && hw.scr == 0x30u && !hw.brr);
+            assert(!(hw.pdtr & CARD_OFF));
+            assert(!hw.shifting && hw.launched == hw.drained && !(hw.ssr & RDRF));
+            ++hw.launched;
+            hw.saw_tdre = false;
+            hw.shifting = true;
+            hw.delay = 4u + hw.launched % 5u;
+            hw.ssr &= (uint8_t)~TEND;
+        }
+        return;
+    }
+    case PTR: assert(width == 1u); hw.ptr = (uint8_t)value; return;
+    case STB: assert(width == 1u); hw.stb = (uint8_t)value; return;
+    case PDTR:
+        assert(width == 2u && (!(value & CARD_OFF) || !hw.shifting));
+        hw.pdtr = (uint16_t)value;
+        return;
+    case PCTR: assert(width == 4u); hw.pctr = value; return;
+    default: assert(!"unexpected SCI write (DMA and other MMIO are forbidden)");
+    }
+}
+
+void kui_sci_sd_test_delay(uint32_t count) { assert(count >= 64u); }
+
+static void run_payload(unsigned timeout_at, unsigned overrun_at) {
+    uint8_t guarded[GUARD + WIRE + GUARD];
+    memset(guarded, 0xa5, sizeof(guarded));
+    memset(&hw, 0, sizeof(hw));
+    hw.ssr = TDRE | TEND;
+    hw.pdtr = 0x1256u;
+    assert(!kui_sci_sd_pio_payload(guarded + GUARD) && !hw.reads && !hw.writes);
+    assert(kui_sci_sd_acquire() == KUI_LOADER_SD_OK);
+    const struct kui_loader_sd_bus *bus = kui_sci_sd_bus();
+    assert(bus && !bus->transfer_block);
+    bus->select(bus->ctx, true);
+    unsigned reads = hw.reads, writes = hw.writes;
+    assert(!kui_sci_sd_pio_payload(guarded + GUARD));
+    assert(hw.reads == reads && hw.writes == writes && !hw.launched);
+    /* The real caller has already read its data token through fast PIO. */
+    assert(bus->transfer(bus->ctx, 0xffu, false) == expected(0u));
+    hw.tdr_writes = hw.scr_enables = hw.launched = hw.drained = hw.polls = 0u;
+    hw.timeout_at = timeout_at;
+    hw.overrun_at = overrun_at;
+    bool fault = timeout_at || overrun_at;
+    assert(kui_sci_sd_pio_payload(guarded + GUARD) == !fault);
+    assert(hw.tdr_writes == 1u && hw.scr_enables == 1u);
+    assert(hw.launched == (timeout_at ? timeout_at : overrun_at ? overrun_at : WIRE));
+    assert(hw.drained == hw.launched - (unsigned)fault);
+    assert(kui_sci_sd_healthy() == !fault && !hw.shifting);
+    for(unsigned i = 0u; i < sizeof(guarded); ++i) {
+        unsigned at = i - GUARD;
+        assert(guarded[i] == (at < hw.drained ? expected(at) : 0xa5u));
+    }
+    if(fault) {
+        assert(!hw.scr && hw.polls < 14000u);
+        unsigned clocks = hw.launched;
+        assert(!kui_sci_sd_pio_payload(guarded + GUARD) && hw.launched == clocks);
+    } else {
+        assert(!(hw.ssr & (RDRF | ORER)) && (hw.ssr & TEND));
+        assert(guarded[GUARD + PAYLOAD] == 0x96u && guarded[GUARD + PAYLOAD + 1u] == 0x3du);
+    }
+    bus->select(bus->ctx, false);
+    kui_sci_sd_release();
+    assert(hw.pdtr == 0x1256u && !hw.scr);
+}
+
+int main(void) {
+    run_payload(0u, 0u);
+    run_payload(77u, 0u);
+    run_payload(0u, WIRE);
+    puts("Test 41 real SCI PIO helper: one-byte credit, 514 exact bytes, CRC tail and bounded faults passed");
+    return 0;
+}
diff --git a/tests/test_toy_resume_integration.c b/tests/test_toy_resume_integration.c
new file mode 100644
index 00000000..236632a3
--- /dev/null
+++ b/tests/test_toy_resume_integration.c
@@ -0,0 +1,211 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* The real GD service, asynchronous DMA stream and raw-sector verifier
+ * against the shared card and register model. */
+#include "kui/hash.h"
+
+#define KUI_TOY_SDK_LIVENESS_MAIN toy_retained_sdk_tests
+#include "test_toy_sdk_liveness.c"
+
+#if !KUI_TOY_SUITE_VERIFIED_RESUME
+#error "Toy resume integration fixture requires the verified-resume mode"
+#endif
+
+static uint8_t bcd_field(uint32_t n) { return (uint8_t)((n / 10u) * 16u + n % 10u); }
+
+static void install_raw_sector(uint32_t lba) {
+    uint8_t raw[KUI_GAME_RAW_BYTES];
+    const struct kui_retail_track *track = &manifest.slots[2].track;
+    const uint32_t first = (lba - track->start_lba) * KUI_GAME_RAW_BYTES;
+    for(unsigned i = 0u; i < sizeof(raw); ++i) raw[i] = source(2u, first + i);
+    const uint32_t fad = lba + 150u;
+    raw[12] = bcd_field(fad / 4500u);
+    raw[13] = bcd_field((fad / 75u) % 60u);
+    raw[14] = bcd_field(fad % 75u);
+    const uint32_t edc = kui_cd_edc(raw, 16u + KUI_GAME_DATA_BYTES);
+    for(unsigned i = 0u; i < 4u; ++i) raw[16u + KUI_GAME_DATA_BYTES + i] = (uint8_t)(edc >> (8u * i));
+    CHECK(kui_sector_edc_valid_at(raw, fad));
+    for(unsigned i = 0u; i < sizeof(raw); ++i) {
+        const uint32_t file_block = (first + i) / 512u;
+        const struct kui_retail_extent *extent = &manifest.slots[track->first_extent].extent;
+        CHECK(file_block >= extent->file_block && file_block - extent->file_block < extent->blocks);
+        const uint32_t lba_on_card = extent->card_lba + file_block - extent->file_block;
+        image_card[lba_on_card * 512u + (first + i) % 512u] = raw[i];
+    }
+}
+
+static void verify_no_guest_data(void) {
+    CHECK(!hw.writes && !R.engine.cursor.done && !R.shared.service.completed_bytes);
+    for(unsigned i = 0u; i < MOVIE_SECTORS * KUI_GAME_DATA_BYTES; ++i)
+        CHECK(ram[OUTPUT - BEGIN + i] == 0xa5u);
+}
+
+static uint32_t start_verified_movie(bool guest_dma) {
+    setup_movie_card(1u, 128u);
+    for(uint32_t i = 0u; i < MOVIE_SECTORS; ++i) install_raw_sector(MOVIE_LBA + i);
+    struct kui_native_ra_config config = movie_configuration();
+    config.movie_ranges[3] = (struct kui_toy_movie_range){MOVIE_LBA - 386u, 420u};
+    bind_movie_configuration(&config);
+    fixture_movie_started(KUI_TOY_MOVIE_EXIT_STARTED, 0x07dbu);
+    if(guest_dma) m.chcr = 1u;
+    uint32_t token = (uint32_t)request(MOVIE_LBA, MOVIE_SECTORS, OUTPUT);
+    CHECK(kui_native_readahead_aux_context.resume.token == token);
+    CHECK(kui_sci_stream_busy() != guest_dma && m.dma_starts == (unsigned)!guest_dma);
+    CHECK(card.cmd18 == 1u && !card.cmd12);
+    CHECK(!R.engine.cursor.raw);
+    verify_no_guest_data();
+    return token;
+}
+
+static void run_verified_resume(bool corrupt) {
+    uint32_t token = start_verified_movie(false);
+
+    m.overrun_after = 250u;
+    independent_sdk_irq();
+    CHECK(!kui_sci_stream_busy() && m.cs_high && m.dma_starts == 1u);
+    CHECK(card.cmd18 == 1u && !card.cmd12);
+#if KUI_TOY_SUITE_RESUME_WAKE
+    const unsigned parked_clocks = card.clocks;
+    kui_retail_hook_active = 1u;
+    CHECK(!independent_demand_wake());
+    kui_retail_hook_active = 0u;
+    R.shared.service.token = token + 1u;
+    CHECK(!independent_demand_wake());
+    R.shared.service.token = token;
+
+    /* DMA1 can change ownership while the card is parked. */
+    m.chcr = 1u;
+    (void)independent_demand_wake();
+    CHECK(m.chcr == 1u && m.cs_high && card.clocks == parked_clocks);
+    CHECK(!kui_sci_stream_busy() && m.dma_starts == 1u);
+    CHECK(card.cmd18 == 1u && !card.cmd12);
+    verify_no_guest_data();
+    m.chcr = 0u;
+
+    /* A foreground-only polled retry also leaves the parked command alone. */
+    R.engine.retries = 2u;
+    (void)independent_demand_wake();
+    CHECK(m.cs_high && card.clocks == parked_clocks);
+    CHECK(!kui_sci_stream_busy() && m.dma_starts == 1u);
+    CHECK(card.cmd18 == 1u && !card.cmd12);
+    verify_no_guest_data();
+    R.engine.retries = 0u;
+
+    const unsigned call_blocks = R.engine.stats.call_blocks;
+    const unsigned irq_blocks = R.engine.stats.irq_blocks;
+    CHECK(independent_demand_wake());
+    CHECK(R.engine.stats.call_blocks == call_blocks && R.engine.stats.irq_blocks == irq_blocks);
+    CHECK(kui_native_readahead_aux_context.demand.movie[1].wake_resumes == 1u);
+    verify_no_guest_data();
+#else
+    CHECK(independent_demand_wake());
+    CHECK(!kui_sci_stream_busy() && m.dma_starts == 1u);
+    verify_no_guest_data();
+
+#if KUI_TOY_SUITE_RESUME_SLICE
+    /* Observe the exact suffix arm before a later visit can consume it. */
+    refill_clock_valid = false;
+#endif
+    CHECK(sdk_poll(KUI_GD_EXEC, 0u, movie_async_poll) == 0);
+#if KUI_TOY_SUITE_RESUME_SLICE
+    refill_clock_valid = true;
+#endif
+#endif
+    CHECK(kui_sci_stream_busy() && m.dma_starts == 2u && (m.dar & 0xfffu) == 252u);
+    CHECK(card.cmd18 == 1u && !card.cmd12);
+    if(corrupt) {
+        /* This error pattern has zero SD CRC16 residue. Apply it only to
+         * this DMA copy; the card's uncorrupted original remains readable. */
+        const uint8_t delta[3] = {0x01u, 0x10u, 0x21u};
+        CHECK(crc16(delta, sizeof(delta)) == 0u);
+        elapse();
+        CHECK(kui_sci_stream_test_read(SSR, 1u) & ORER);
+        uint8_t *area = R.shared.stream.area[R.shared.stream.fill];
+        for(unsigned i = 0u; i < sizeof(delta); ++i) area[400u + i] ^= rev8(delta[i]);
+    }
+
+    for(unsigned n = 0u; R.shared.service.pending; ++n) {
+        CHECK(n < 512u && !R.engine.failed);
+        if(!kui_native_readahead_aux_context.suite[3]) verify_no_guest_data();
+        if(kui_sci_stream_busy()) independent_sdk_irq();
+        else CHECK(sdk_poll(KUI_GD_EXEC, 0u, movie_async_poll) == 0);
+        CHECK(!R.engine.cursor.raw);
+        if(!corrupt) CHECK(card.cmd18 == 1u && !card.cmd12);
+    }
+    CHECK(sdk_poll(KUI_GD_CHECK, token, movie_async_poll) == KUI_GD_COMPLETED);
+    CHECK(get(STATUS + 8u) == MOVIE_SECTORS * KUI_GAME_DATA_BYTES && !get(STATUS + 4u));
+    compare(MOVIE_LBA, MOVIE_SECTORS, OUTPUT);
+    CHECK(kui_sci_stream_stats()->toy_resumed_blocks == 1u);
+    if(corrupt) {
+        CHECK(!kui_native_readahead_aux_context.suite[1]);
+        CHECK(kui_native_readahead_aux_context.suite[3] == 1u);
+        CHECK(card.cmd18 == 2u && card.cmd12 == 1u);
+    } else {
+        CHECK(kui_native_readahead_aux_context.suite[1] == 1u);
+        CHECK(!kui_native_readahead_aux_context.suite[3]);
+    }
+}
+
+#if KUI_TOY_SUITE_RESUME_SLICE
+static void run_resume_slice(uint32_t caller, bool valid_clock, uint32_t extra_ticks,
+    bool guest_dma, unsigned expected_blocks) {
+    uint32_t token = start_verified_movie(guest_dma);
+    const struct kui_toy_demand_movie_trace *movie = &kui_native_readahead_aux_context.demand.movie[1];
+    const struct kui_sci_stream_stats *sd = kui_sci_stream_stats();
+    CHECK(!movie->slice_visits && !movie->slice_blocks);
+    m.delay = 0u;
+    elapse();
+    refill_clock_valid = valid_clock;
+    refill_clock_extra_ticks = extra_ticks;
+    status_only_poll(token, caller);
+    verify_no_guest_data();
+    const unsigned blocks = R.engine.stats.call_blocks;
+    const unsigned polled = sd->polled;
+    CHECK(sdk_poll(KUI_GD_EXEC, 0u, caller) == 0);
+    CHECK(R.engine.stats.call_blocks - blocks == expected_blocks);
+    CHECK(movie->slice_blocks == expected_blocks - 1u);
+    CHECK(sd->polled - polled == (unsigned)guest_dma);
+    if(guest_dma) CHECK(m.chcr == 1u && !m.dma_starts);
+    CHECK(!R.engine.cursor.raw && card.cmd18 == 1u && !card.cmd12);
+    verify_no_guest_data();
+    status_only_poll(token, caller);
+    verify_no_guest_data();
+    refill_clock_valid = true;
+    refill_clock_extra_ticks = 0u;
+    if(guest_dma) m.chcr = 0u;
+    m.delay = RECEIVE_POLLS;
+
+    /* IRQ work remains a single checked block per dispatch. */
+    for(unsigned n = 0u; R.shared.service.pending; ++n) {
+        CHECK(n < 512u && !R.engine.failed);
+        verify_no_guest_data();
+        if(kui_sci_stream_busy()) {
+            const unsigned before = R.engine.stats.irq_blocks;
+            independent_sdk_irq();
+            CHECK(R.engine.stats.irq_blocks - before <= 1u);
+        } else CHECK(sdk_poll(KUI_GD_EXEC, 0u, caller) == 0);
+        CHECK(!R.engine.cursor.raw && card.cmd18 == 1u && !card.cmd12);
+    }
+    CHECK(sdk_poll(KUI_GD_CHECK, token, caller) == KUI_GD_COMPLETED);
+    CHECK(get(STATUS + 8u) == MOVIE_SECTORS * KUI_GAME_DATA_BYTES && !get(STATUS + 4u));
+    compare(MOVIE_LBA, MOVIE_SECTORS, OUTPUT);
+    CHECK(!sd->toy_resumed_blocks && !kui_native_readahead_aux_context.suite[3]);
+}
+#endif
+
+int main(void) {
+    movie_chunk_classification();
+    run_verified_resume(false);
+    run_verified_resume(true);
+#if KUI_TOY_SUITE_RESUME_SLICE
+    run_resume_slice(event900_poll, true, 0u, false, 3u);
+    run_resume_slice(movie_async_poll, true, 0u, false, 3u);
+    run_resume_slice(movie_async_poll, false, 0u, false, 1u);
+    run_resume_slice(event900_poll, true, 1172u, false, 1u);
+    run_resume_slice(event900_poll, true, 0u, true, 1u);
+    printf("Mode %u: staged SDK refill caps, status-only checks, and IRQ/PIO bounds passed\n",
+        KUI_TOY_SUITE_MODE);
+#endif
+    printf("Mode %u: real GD/SCI same-CMD18 resume, EDC quarantine, and clean strict fallback passed\n",
+        KUI_TOY_SUITE_MODE);
+    return 0;
+}
diff --git a/tests/test_toy_sci_burst.c b/tests/test_toy_sci_burst.c
new file mode 100644
index 00000000..16c77346
--- /dev/null
+++ b/tests/test_toy_sci_burst.c
@@ -0,0 +1,242 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* Hardware model for the auxiliary transport, not a timing emulation. */
+#include "retail_async.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+enum { RA_CLOSED, RA_PAUSED, RA_DMA, RA_LOST, RA_RESUME };
+static uint32_t read_hw(uint32_t address,unsigned width);
+#include "../src/loader/toy_sci_burst.inc"
+
+static struct {
+    uint32_t smr,brr,scr,ssr,rdr,scmr,sptr,stbcr,pdtr;
+    uint32_t sar,dar,tcr,chcr,dmaor;
+    unsigned fences,writes,starts,stops,clocked,phase,command,bytes,gap,late_at;
+    bool bad_stop;
+#if KUI_TOY_SUITE_MODE == 28
+    bool refuse_slow_rate,refuse_scr_stop;
+#endif
+} hw;
+static kui_retail_async_region_type region;
+static uint8_t slab[TOY_BURST_SLAB_BYTES] __attribute__((aligned(32)));
+static uint8_t other[TOY_BURST_SLAB_BYTES] __attribute__((aligned(32)));
+
+static uint32_t *reg(uint32_t address) {
+    switch(address) {
+    case TOY_BURST_SMR: return &hw.smr;
+    case TOY_BURST_BRR: return &hw.brr;
+    case TOY_BURST_SCR: return &hw.scr;
+    case TOY_BURST_SSR: return &hw.ssr;
+    case TOY_BURST_RDR: return &hw.rdr;
+    case TOY_BURST_SCMR: return &hw.scmr;
+    case TOY_BURST_SPTR: return &hw.sptr;
+    case TOY_BURST_STBCR: return &hw.stbcr;
+    case TOY_BURST_PDTR: return &hw.pdtr;
+    case TOY_BURST_SAR: return &hw.sar;
+    case TOY_BURST_DAR: return &hw.dar;
+    case TOY_BURST_TCR: return &hw.tcr;
+    case TOY_BURST_CHCR: return &hw.chcr;
+    case TOY_BURST_DMAOR: return &hw.dmaor;
+    default: assert(false);return NULL;
+    }
+}
+static uint32_t read_hw(uint32_t address,unsigned width) {
+    (void)width;
+    return *reg(address);
+}
+void kui_toy_sci_burst_test_write(uint32_t address,unsigned width,uint32_t value) {
+    (void)width;
+    ++hw.writes;
+#if KUI_TOY_SUITE_MODE == 28
+    if(address==TOY_BURST_BRR) {
+        assert(!hw.scr);
+        if(value==1u && hw.refuse_slow_rate)return;
+    }
+    if(address==TOY_BURST_SCR && !value && hw.refuse_scr_stop)return;
+#endif
+    *reg(address)=value;
+    if(address==TOY_BURST_STBCR && (value&1u)) {
+        hw.smr=hw.scr=hw.scmr=0;
+        hw.brr=0xffu;
+        hw.ssr=0x84u;
+    }
+}
+uint32_t kui_toy_sci_burst_test_physical(const void *buffer) {
+    return buffer==slab?0x0c100000u:buffer==other?0x0c102000u:0;
+}
+void kui_toy_sci_burst_test_fence(const void *buffer) {
+    assert(buffer==slab || buffer==other);
+    ++hw.fences;
+    if(hw.fences==hw.late_at) {--hw.tcr;++hw.dar;}
+}
+
+enum { CARD_IDLE,CARD_COMMAND,CARD_STUFF,CARD_REPLY,CARD_TOKEN,CARD_PAYLOAD };
+static void card_select(void *unused,bool selected) {
+    (void)unused;
+    assert(hw.scr!=0x50u && region.engine.in_irq==0);
+    hw.pdtr=selected?0u:0x80u;
+}
+static uint8_t card_byte(void *unused,uint8_t byte,bool slow) {
+    (void)unused;
+    assert(!slow && hw.scr==0x30u && hw.brr==0u && region.engine.in_irq==0);
+    ++hw.clocked;
+    if(hw.pdtr&0x80u) return 0xffu;
+    if(hw.phase!=CARD_COMMAND && (byte==0x52u || byte==0x4cu)) {
+        hw.command=byte;
+        hw.phase=CARD_COMMAND;
+        hw.bytes=1;
+        return 0xffu;
+    }
+    switch(hw.phase) {
+    case CARD_COMMAND:
+        if(++hw.bytes==6u) {
+            if(hw.command==0x4cu) {++hw.stops;hw.phase=CARD_STUFF;}
+            else {++hw.starts;hw.phase=CARD_REPLY;}
+        }
+        return 0xffu;
+    case CARD_STUFF:
+        hw.phase=CARD_REPLY;
+        return 0xffu;
+    case CARD_REPLY:
+        hw.phase=hw.command==0x52u?CARD_TOKEN:CARD_IDLE;
+        return hw.command==0x4cu && hw.bad_stop?0x08u:0u;
+    case CARD_TOKEN:
+        if(hw.gap) {--hw.gap;return 0xffu;}
+        hw.phase=CARD_PAYLOAD;
+        return 0xfeu;
+    default:
+        return 0xffu;
+    }
+}
+static void setup(void) {
+    memset(&hw,0,sizeof(hw));
+    memset(&region,0,sizeof(region));
+    memset(slab,0,sizeof(slab));
+    hw.smr=0x80u;hw.scr=0x30u;hw.ssr=0x84u;hw.pdtr=0x80u;hw.dmaor=1u;
+    hw.sar=0x0c0a1120u;hw.dar=0x0c040020u;hw.tcr=23u;hw.chcr=0x4400u;
+    struct kui_loader_sd *card=&region.shared.card.device.sd;
+    card->blocks=1u<<19;
+    card->ready=card->high_capacity=true;
+    card->bus.select=card_select;
+    card->bus.transfer=card_byte;
+    region.shared.stream.card=card;
+    region.shared.port.acquired=true;
+    region.engine.opened=1u;
+}
+static void finished(unsigned received,unsigned planned) {
+    assert(received<=planned);
+    memset(slab,0x6c,received);
+    hw.dar=kui_toy_sci_burst_test_physical(slab)+received;
+    hw.tcr=planned-received;
+    hw.chcr=TOY_BURST_RX_DMA|(received==planned?2u:0u);
+    hw.ssr=0xe4u;
+}
+
+static void test_receive_cuts(bool slow) {
+    const unsigned bytes=15u*516u-2u;
+    uint32_t received;
+    for(unsigned length=0;length<=bytes;++length) {
+        setup();
+#if KUI_TOY_SUITE_MODE == 28
+        assert(toy_sci_burst_start_rate(&region,7123u,15u,slab,slow)==KUI_SCI_STREAM_OK);
+#else
+        assert(toy_sci_burst_start(&region,7123u,15u,slab)==KUI_SCI_STREAM_OK);
+#endif
+        assert(hw.starts==1u && hw.scr==0x50u && hw.tcr==bytes &&
+            hw.brr==(uint32_t)slow &&
+            region.shared.stream.state==KUI_TOY_SCI_BURST_DMA);
+        unsigned writes=hw.writes,clocked=hw.clocked;
+        region.engine.in_irq=1u;
+        assert(toy_sci_burst_poll(&region,slab,15u,&received)==KUI_SCI_STREAM_PENDING);
+        assert(!received && hw.writes==writes);
+        assert(toy_sci_burst_stop(&region,slab,15u)==KUI_SCI_STREAM_BUSY);
+        finished(length,bytes);
+        assert(toy_sci_burst_poll(&region,slab,15u,&received)==KUI_SCI_STREAM_OK);
+        assert(received==length && hw.fences==(length==bytes?2u:6u) && hw.clocked==clocked &&
+            hw.sar==0x0c0a1120u && hw.dar==0x0c040020u && hw.tcr==23u &&
+            hw.chcr==0x4400u && hw.scr==0x30u && hw.brr==0u && hw.pdtr==0x80u);
+        assert(region.shared.stream.stats.overruns==(length!=bytes));
+        region.engine.in_irq=0;
+        assert(toy_sci_burst_stop(&region,slab,15u)==KUI_SCI_STREAM_OK);
+        assert(hw.stops==1u && region.shared.stream.state==RA_CLOSED);
+    }
+}
+
+int main(void) {
+    const unsigned bytes=15u*516u-2u;
+    uint32_t received;
+    test_receive_cuts(false);
+#if KUI_TOY_SUITE_MODE == 28
+    test_receive_cuts(true);
+    setup();hw.gap=300u;
+    assert(toy_sci_burst_start_rate(&region,7123u,15u,slab,true)==KUI_SCI_STREAM_PENDING);
+    assert(hw.brr==0u && hw.scr==0x30u && hw.pdtr==0x80u);
+    assert(toy_sci_burst_start_rate(&region,7123u,15u,slab,true)==KUI_SCI_STREAM_OK);
+    assert(hw.starts==1u && hw.brr==1u);
+    assert(toy_sci_burst_stop(&region,slab,15u)==KUI_SCI_STREAM_RESET);
+    assert(region.shared.port.fault && hw.scr==0x30u && hw.brr==0u &&
+        hw.chcr==0x4400u && !hw.stops);
+
+    setup();hw.refuse_slow_rate=true;
+    assert(toy_sci_burst_start_rate(&region,7123u,15u,slab,true)==KUI_SCI_STREAM_RESET);
+    assert(region.shared.port.fault && hw.brr==0u && hw.scr==0x30u &&
+        hw.chcr==0x4400u && hw.pdtr==0x80u);
+
+    setup();hw.refuse_scr_stop=true;
+    assert(toy_sci_burst_start_rate(&region,7123u,15u,slab,true)==KUI_SCI_STREAM_RESET);
+    assert(region.shared.port.fault && hw.brr==0u && hw.chcr==0x4400u);
+#endif
+    setup();hw.gap=600u;
+    assert(toy_sci_burst_start(&region,7123u,15u,slab)==KUI_SCI_STREAM_PENDING);
+    assert(region.shared.stream.state==KUI_TOY_SCI_BURST_TOKEN && hw.pdtr==0x80u);
+    assert(toy_sci_burst_start(&region,7123u,15u,slab)==KUI_SCI_STREAM_PENDING);
+    assert(toy_sci_burst_start(&region,7123u,15u,slab)==KUI_SCI_STREAM_OK);
+    assert(hw.starts==1u);
+    assert(toy_sci_burst_poll(&region,other,15u,&received)==KUI_SCI_STREAM_RESET);
+    assert(!received && region.shared.stream.state==KUI_TOY_SCI_BURST_DMA);
+    finished(1536u,bytes);
+    assert(toy_sci_burst_poll(&region,slab,15u,&received)==KUI_SCI_STREAM_OK);
+    assert(received==1536u);
+    hw.bad_stop=true;
+    assert(toy_sci_burst_stop(&region,slab,15u)==KUI_SCI_STREAM_RESET);
+    assert(region.shared.port.fault && hw.pdtr==0x80u);
+    assert(toy_sci_burst_start(&region,7126u,15u,slab)==KUI_SCI_STREAM_RESET);
+    assert(hw.starts==1u);
+
+    setup();
+    assert(toy_sci_burst_start(&region,7123u,15u,slab)==KUI_SCI_STREAM_OK);
+    finished(1535u,bytes);hw.late_at=4u;
+    assert(toy_sci_burst_poll(&region,slab,15u,&received)==KUI_SCI_STREAM_OK);
+    assert(received==1536u && hw.fences==8u && hw.dar==0x0c040020u);
+    setup();hw.chcr=0x4401u;
+    assert(toy_sci_burst_start(&region,7123u,15u,slab)==KUI_SCI_STREAM_PENDING);
+    assert(!hw.writes && !hw.clocked);
+    setup();
+    assert(toy_sci_burst_start(&region,7123u,16u,slab)==KUI_SCI_STREAM_RESET);
+    assert(!hw.writes && !hw.clocked);
+    setup();
+    assert(toy_sci_burst_start(&region,7123u,15u,slab)==KUI_SCI_STREAM_OK);
+    hw.sar=0x0c0fedccu;hw.chcr=0x6401u;hw.ssr=0xe4u;
+    assert(toy_sci_burst_poll(&region,slab,15u,&received)==KUI_SCI_STREAM_RESET);
+    assert(!received && hw.sar==0x0c0fedccu && hw.chcr==0x6401u && region.shared.port.fault);
+    setup();
+    assert(toy_sci_burst_start(&region,7123u,15u,slab)==KUI_SCI_STREAM_OK);
+    finished(1024u,bytes);++hw.tcr;
+    assert(toy_sci_burst_poll(&region,slab,15u,&received)==KUI_SCI_STREAM_RESET);
+    assert(!received && region.shared.port.fault && !(hw.chcr&1u));
+    setup();
+    assert(toy_sci_burst_start(&region,7123u,15u,slab)==KUI_SCI_STREAM_OK);
+    finished(1024u,bytes);hw.ssr=0xd4u;
+    assert(toy_sci_burst_poll(&region,slab,15u,&received)==KUI_SCI_STREAM_RESET);
+    assert(!received && region.shared.port.fault && !(hw.chcr&1u) && !hw.stops);
+    setup();
+    assert(toy_sci_burst_start(&region,7123u,15u,slab)==KUI_SCI_STREAM_OK);
+    assert(toy_sci_burst_stop(&region,slab,15u)==KUI_SCI_STREAM_RESET);
+    assert(region.shared.port.fault && hw.scr==0x30u && !(hw.chcr&1u) && !hw.stops);
+    puts("Toy SCI burst transport passed all 7,739 prefix cuts, PIO-free IRQ retirement, sliced token, owned restore, bad count/stop, foreign DMA and stalled cancellation");
+#if KUI_TOY_SUITE_MODE == 28
+    puts("6.25 MHz receive passed all 7,739 cuts, token wait, cancellation, and rate-transition refusals");
+#endif
+    return 0;
+}
