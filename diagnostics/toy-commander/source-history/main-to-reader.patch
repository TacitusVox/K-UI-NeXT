+static void pio_window_cancel_replaces_request(bool seek) {
+    uint32_t token = cut_first_movie_dma();
+    uint32_t damaged = R.engine.cursor.block;
+    fail_slow_movie_retry(false);
+    advance_to_pio(1u);
