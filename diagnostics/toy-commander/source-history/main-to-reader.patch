+    uint32_t replacement = (uint32_t)request(lba, MOVIE_SECTORS, OUTPUT);
+    for(unsigned n = 0u; !kui_sci_stream_busy(); ++n) {
+        CHECK(n < 16u && kui_sci_stream_stats()->polled == polled);
