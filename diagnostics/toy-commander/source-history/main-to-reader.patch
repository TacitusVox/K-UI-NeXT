--- /dev/null
+++ b/src/loader/toy_dma_priority_stage.inc
@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* Only the SHA-verified Toy owner calls this during the masked cold bind.
+ * Both original C2 DMA setup literals select CH2 ahead of the SCI's CH1.
+ * Keep the owner's CHCR2 and DDT programming. The original experiment gave
+ * CH1 fixed priority over CH2. The round-robin test rotates priority after
+ * a transfer unit (SH7750 hardware manual section 14.3.3). */
+static bool toy_dma_priority_install(void) {
+    static const uint32_t address[2]={UINT32_C(0x8c094f98),UINT32_C(0x8c095a6c)};
+    const uint32_t uncached=UINT32_C(0x20000000);
+    const uint32_t before=UINT32_C(0x8201);
+#if KUI_TOY_SUITE_DMA_ROUND_ROBIN
+    const uint32_t after=UINT32_C(0x8301);
+#else
+    const uint32_t after=UINT32_C(0x8001);
+#endif
+    for(unsigned i=0;i<2u;i++)
+        if(native_word(address[i]|uncached)!=before)return false;
+    for(unsigned i=0;i<2u;i++) {
+        *(volatile uint32_t *)(uintptr_t)address[i]=after;
+        native_publish(address[i]);
+    }
+    for(unsigned i=0;i<2u;i++)
+        if(native_word(address[i]|uncached)!=after)return false;
+    return true;
+}
diff --git a/src/loader/toy_fmv_compare.c b/src/loader/toy_fmv_compare.c
new file mode 100644
index 00000000..4c91e4b2
--- /dev/null
+++ b/src/loader/toy_fmv_compare.c
@@ -0,0 +1,133 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include "kui/toy_fmv_compare.h"
+#include "kui/gd_service.h"
+#include <string.h>
+
+static struct kui_toy_fmv_bin *bin_at(struct kui_toy_fmv_movie *movie, uint32_t tick) {
+    uint32_t elapsed=movie->first_tick-tick;
+    unsigned bin=0u;
+    while(bin+1u<KUI_TOY_FMV_BINS && elapsed>=KUI_TOY_FMV_BIN_TICKS) {
+        elapsed-=KUI_TOY_FMV_BIN_TICKS;
+        ++bin;
+    }
+    return &movie->bins[bin];
+}
+
+void kui_toy_fmv_request(struct kui_toy_fmv_trace *trace, const struct kui_toy_movie_range ranges[4],
+    uint32_t token, uint32_t lba, uint32_t sectors, uint32_t tick) {
+    if(!token || !sectors) return;
+    unsigned variant=0u;
+    for(;variant<4u;++variant) {
+        const struct kui_toy_movie_range *range=&ranges[variant];
+        /* Toy reads the AVI headers through sector 385 before streaming. */
+        if(lba>=range->lba && lba-range->lba>=386u && lba-range->lba<range->count) break;
+    }
+    if(variant==4u) return;
+    struct kui_toy_fmv_movie *movie=&trace->movie[variant/2u];
+    if(!movie->requests) movie->first_tick=tick;
+    if(movie->first_tick-tick>=UINT32_C(0x80000000)) {
+        ++trace->clock_lost;
+        return;
+    }
+    ++movie->requests;
+    movie->last_lba=lba;
+    bin_at(movie,tick)->requested+=sectors;
+    struct kui_toy_fmv_pending *slot=NULL;
+    for(unsigned i=0u;i<KUI_TOY_FMV_PENDING;++i) {
+        struct kui_toy_fmv_pending *pending=&trace->pending[i];
+        if(pending->token==token) {
+            slot=pending;
+            ++trace->movie[pending->movie].unmatched;
+            break;
+        }
+        if(!pending->token && !slot) slot=pending;
+    }
+    if(slot) *slot=(struct kui_toy_fmv_pending){token,tick,lba,sectors,variant/2u};
+    else ++movie->unmatched;
+}
+
+void kui_toy_fmv_status(struct kui_toy_fmv_trace *trace, uint32_t token, uint32_t tick,
+    int32_t status, uint32_t bytes) {
+    if(!token || (status!=KUI_GD_COMPLETED && status!=KUI_GD_FAILED)) return;
+    for(unsigned i=0u;i<KUI_TOY_FMV_PENDING;++i) {
+        struct kui_toy_fmv_pending *pending=&trace->pending[i];
+        if(pending->token!=token) continue;
+        pending->token=0u;
+        struct kui_toy_fmv_movie *movie=&trace->movie[pending->movie];
+        uint32_t elapsed=pending->tick-tick;
+        if(elapsed>=UINT32_C(0x80000000) || movie->first_tick-tick>=UINT32_C(0x80000000)) {
+            ++trace->clock_lost;
+            return;
+        }
+        struct kui_toy_fmv_bin *bin=bin_at(movie,tick);
+        if(elapsed>bin->longest) bin->longest=elapsed;
+        if(movie->acks) {
+            uint32_t gap=movie->last_ack-tick;
+            if(gap>bin->gap) bin->gap=gap;
+        }
+        ++movie->acks;
+        movie->last_ack=tick;
+        if(status==KUI_GD_FAILED) ++movie->failed;
+        else {
+            /* Status word 2 is the number of bytes reported by GD CHECK.
+             * DATA reads for this comparison are logical 2048-byte sectors. */
+            uint32_t sectors=bytes/2048u;
+            if(sectors!=pending->sectors || bytes%2048u) ++movie->short_bytes;
+            if(sectors>pending->sectors) sectors=pending->sectors;
+            bin->completed+=sectors;
+            if(sectors) movie->end_lba=pending->lba+sectors;
+        }
+        return;
+    }
+}
+
+static void append(char **at, const char *text) {
+    while(*text) *(*at)++=*text++;
+}
+
+static void hex(char **at, uint32_t value, unsigned digits) {
+    if(digits==4u && value>UINT32_C(0xffff)) value=UINT32_C(0xffff);
+    while(digits) {
+        --digits;
+        *(*at)++="0123456789ABCDEF"[(value>>(digits*4u))&15u];
+    }
+}
+
+static uint32_t milliseconds(uint32_t ticks) {
+    return (ticks/3125u)*4u+((ticks%3125u)*4u+3124u)/3125u;
+}
+
+void kui_toy_fmv_format(char text[KUI_TOY_REPORT_FILE_BYTES], const struct kui_toy_fmv_trace *trace,
+    const char *source, const char *build) {
+    char *at=text;
+    memset(text,' ',KUI_TOY_REPORT_FILE_BYTES);
+    append(&at,"K-UI TOY FMV COMPARE V1 / ");
+    for(unsigned i=0u;i<8u && source[i];++i) *at++=source[i];
+    *at++=' ';
+    for(unsigned i=0u;i<12u && build[i];++i) *at++=build[i];
+    append(&at,"\nHEX / FIRST STREAM REQUEST = 0 / 500 MS BINS / LAST BIN 6S+\n");
+    append(&at,"REQ ACK FAIL SIZE UNMATCHED OPEN LAST_LBA ACK_END_LBA\n");
+    append(&at,"PER BIN: REQ_SECT ACK_SECT MAX_REQ_MS MAX_ACK_GAP_MS\n");
+    for(unsigned i=0u;i<2u;++i) {
+        const struct kui_toy_fmv_movie *movie=&trace->movie[i];
+        append(&at,i?"INTRO\n":"BUMPER\n");
+        uint32_t open=0u;
+        for(unsigned j=0u;j<KUI_TOY_FMV_PENDING;++j)
+            if(trace->pending[j].token && trace->pending[j].movie==i) ++open;
+        const uint32_t values[]={movie->requests,movie->acks,movie->failed,movie->short_bytes,
+            movie->unmatched,open,movie->last_lba,movie->end_lba};
+        for(unsigned j=0u;j<8u;++j) {
+            hex(&at,values[j],j<6u?4u:8u);
+            *at++=j==7u?'\n':' ';
+        }
+        for(unsigned j=0u;j<KUI_TOY_FMV_BINS;++j) {
+            const struct kui_toy_fmv_bin *bin=&movie->bins[j];
+            hex(&at,bin->requested,4u);*at++=' ';
+            hex(&at,bin->completed,4u);*at++=' ';
+            hex(&at,milliseconds(bin->longest),4u);*at++=' ';
+            hex(&at,milliseconds(bin->gap),4u);*at++='\n';
+        }
+    }
+    append(&at,"CLOCK LOST ");hex(&at,trace->clock_lost,8u);*at++='\n';
+    memcpy(text+KUI_TOY_REPORT_FILE_BYTES-12u,"\nEND REPORT\n",12u);
+}
diff --git a/src/loader/toy_header_replay.inc b/src/loader/toy_header_replay.inc
new file mode 100644
index 00000000..205f48e0
--- /dev/null
+++ b/src/loader/toy_header_replay.inc
@@ -0,0 +1,119 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* This is a one-sector replay of admitted AVI data. It owns neither SCI
+ * nor the guest destination. The normal cursor and GD service still publish
+ * the original read's verified bytes and both requests' terminal status. */
+static void header_invalidate(void) {
+    C.header.token=0u;
+    C.header.valid=false;
+}
+
+static void header_write(void *unused,uint32_t offset,const uint8_t *bytes,uint32_t count) {
+    (void)unused;
+    C.header.write(C.header.context,offset,bytes,count);
+    if(offset!=C.header.written || offset>KUI_GAME_DATA_BYTES || count>KUI_GAME_DATA_BYTES-offset) {
+        C.header.written=UINT16_MAX;
+        return;
+    }
+    if(!offset)C.header.first_chunk=(uint16_t)count;
+    memcpy(C.header.data+offset,bytes,count);
+    C.header.written+=(uint16_t)count;
+}
+
+static unsigned header_request(const kui_retail_async_region_type *r) {
+    const struct kui_retail_gd *s=&r->shared.service;
+    const struct kui_retail_async *e=&r->engine;
+    const struct kui_retail_cursor *c=&e->cursor;
+    /* The matched active native GD token owns the initialized cursor for
+     * this exact request. Its read mode and count come from the same GD state. */
+    if(!e->active || e->failed || !s->pending || !s->token || e->token!=s->token ||
+       !r->shared.port.acquired || r->shared.port.fault ||
+       s->count!=1u || s->sector_bytes!=KUI_GAME_DATA_BYTES)return 0u;
+#if KUI_NATIVE_SESSION_CONTROLS
+    if(s->disc_lid!=KUI_RETAIL_DISC_READY || s->disc_generation!=e->disc_generation)return 0u;
+#endif
+    const struct kui_retail_track *track=&c->manifest->slots[c->track].track;
+    return kui_retail_track_sector_bytes(track)==KUI_GAME_RAW_BYTES &&
+        kui_retail_track_header_bytes(track)==16u?movie_variant(s):0u;
+}
+
+static void header_publish(const kui_retail_async_region_type *r) {
+    const struct kui_retail_gd *s=&r->shared.service;
+    const struct kui_retail_async *e=&r->engine;
+    if(s->token!=C.header.token)return;
+    if(!s->token || s->status!=KUI_GD_COMPLETED || s->pending || s->error ||
+       s->completed_bytes!=KUI_GAME_DATA_BYTES || e->failed || e->token!=s->token ||
+       e->cursor.done!=1u || C.header.written!=KUI_GAME_DATA_BYTES) {
+        header_invalidate();
+        return;
+    }
+    C.header.last_block=e->cursor.block;
+    C.header.stream_position=r->shared.stream.position;
+    C.header.valid=true;
+}
+
+static bool header_replay(kui_retail_async_region_type *r,unsigned variant) {
+    struct kui_retail_async *e=&r->engine;
+    struct kui_retail_cursor *c=&e->cursor;
+    const struct kui_retail_gd *s=&r->shared.service;
+    /* A repeat keeps the parked card stream at its forward position. An
+     * in-flight or uncertain reception belongs to the usual demand path. */
+    if(!C.header.valid || s->token!=C.header.token+1u || s->lba!=C.header.lba ||
+       s->sector_part!=C.header.sector_part ||
+       s->track_type!=C.header.track_type || c->manifest!=C.header.manifest ||
+       c->offset || C.spec_owned || C.quiesced ||
+       r->shared.stream.state!=RA_PAUSED || r->shared.stream.position!=C.header.stream_position ||
+       C.config.ops->busy())return false;
+#if KUI_NATIVE_SESSION_CONTROLS
+    if(s->disc_generation!=C.header.disc_generation)return false;
+#endif
+    C.header.token=s->token;
+    C.header.valid=false;
+    /* The cursor emits payload from one 512-byte card block per callback. */
+    uint32_t count=C.header.first_chunk;
+    for(uint32_t offset=0u;offset<KUI_GAME_DATA_BYTES;count=512u) {
+        if(count>KUI_GAME_DATA_BYTES-offset)count=KUI_GAME_DATA_BYTES-offset;
+        c->write(c->context,offset,C.header.data+offset,count);
+        if(e->failed) {
+            e->active=0u;
+            header_invalidate();
+            return true;
+        }
+        offset+=count;
+    }
+    c->block=C.header.last_block;c->done=1u;
+    demand_complete(r);
+    /* This demand consumed no card blocks. Preserve the existing physical
+     * cache seed and let ordinary progress publish the new GD handle. */
+    C.have_completed=1u;C.completed_token=e->token;
+    ++C.playback[(variant-1u)/2u].replayed;
+    return true;
+}
+
+static void header_deliver(uint32_t wait,kui_retail_async_region_type *r) {
+    const struct kui_retail_gd *s=&r->shared.service;
+    struct kui_retail_cursor *c=&r->engine.cursor;
+    unsigned variant=header_request(r);
+    if(!variant) {
+        /* An accepted unrelated request advances the token. CHECK consumes
+         * the command but leaves COMPLETED; INIT/RESET clears that status. */
+        if(s->status!=KUI_GD_COMPLETED || s->token!=C.header.token || s->pending ||
+           r->engine.failed || r->shared.port.fault)header_invalidate();
+        deliver(wait,r);
+        return;
+    }
+    if(s->token!=C.header.token) {
+        if(header_replay(r,variant))return;
+        C.header.valid=false;C.header.token=s->token;
+        C.header.lba=s->lba;
+        C.header.sector_part=s->sector_part;C.header.track_type=s->track_type;
+        C.header.manifest=c->manifest;
+#if KUI_NATIVE_SESSION_CONTROLS
+        C.header.disc_generation=s->disc_generation;
+#endif
+        C.header.written=0u;
+    }
+    C.header.write=c->write;C.header.context=c->context;
+    c->write=header_write;c->context=NULL;
+    deliver(wait,r);
+    c->write=C.header.write;c->context=C.header.context;
+}
diff --git a/src/loader/toy_movie_ahead.inc b/src/loader/toy_movie_ahead.inc
new file mode 100644
index 00000000..784bd78f
--- /dev/null
+++ b/src/loader/toy_movie_ahead.inc
@@ -0,0 +1,414 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+
+/* This private cursor reads forward from an accepted movie request. A raw
+ * sector becomes eligible only after its FAD and EDC pass. The game keeps
+ * its original one-command queue, cursor, destination and completion. */
+#define A C.movie_ahead
+enum { AHEAD_SLOTS=80u, AHEAD_TOKEN_WAIT=5u, AHEAD_TOKEN_LIMIT=65536u };
+_Static_assert(AHEAD_SLOTS*KUI_GAME_RAW_BYTES<=KUI_NATIVE_RA_DATA_BYTES,
+    "Verified movie window must fit the private reader arena");
+#if KUI_TOY_SUITE_MODE == 65
+enum { AHEAD_RETRY_LIMIT=3u };
+#define AHEAD_TRACE C.diagnostics.stage_result[KUI_NATIVE_RA_STAGE_NONE]
+
+static void toy_ahead_fault(unsigned stage,enum kui_sci_stream_result result,uint32_t block) {
+    struct kui_native_ra_failure_snapshot *first=&C.diagnostics.first;
+    if(!first->stage) {
+        first->stage=stage;
+        first->result=result;
+        first->operation_lba=block;
+    }
+    ++C.diagnostics.stage_result[stage][result];
+    if(stage==KUI_NATIVE_RA_STAGE_APPEND || result==KUI_SCI_STREAM_RESET ||
+       ++A.retry>AHEAD_RETRY_LIMIT) A.error=true;
+    else A.receiving=true;
+}
+#endif
+
+static uint8_t *toy_ahead_sector(uint32_t lba) {
+    uint32_t slot=A.head+lba-A.first;
+    if(slot>=AHEAD_SLOTS)slot-=AHEAD_SLOTS;
+    return toy_resume_data()+slot*KUI_GAME_RAW_BYTES;
+}
+
+static void toy_ahead_write(void *unused,uint32_t offset,const uint8_t *data,uint32_t bytes) {
+#if KUI_TOY_SUITE_MODE == 66
+    struct kui_retail_async *e=unused;
+    const struct kui_retail_cursor *cursor=&e->cursor;
+    if(A.error || e->failed)return;
+#else
+    (void)unused;
+    const struct kui_retail_cursor *cursor=&A.cursor;
+    if(A.error)return;
+#endif
+    const uint32_t lba=cursor->lba+cursor->done;
+    const uint32_t part=cursor->offset;
+    if(lba!=A.verified || lba-A.first>=AHEAD_SLOTS ||
+       offset!=cursor->done*KUI_GAME_RAW_BYTES+part || !bytes || bytes>KUI_GAME_RAW_BYTES-part) {
+        A.error=true;
+#if KUI_TOY_SUITE_MODE == 66
+        e->failed=KUI_GD_ERROR_IO;
+#endif
+        return;
+    }
+    uint8_t *raw=toy_ahead_sector(lba);
+    memcpy(raw+part,data,bytes);
+    if(part+bytes!=KUI_GAME_RAW_BYTES)return;
+    if(raw[15]!=1u || !kui_sector_edc_valid_at(raw,lba+150u)) {
+        A.error=true;
+#if KUI_TOY_SUITE_MODE == 66
+        e->failed=KUI_GD_ERROR_IO;
+#endif
+    } else ++A.verified;
+}
+
+static bool toy_ahead_live(void) {
+    if(!A.variant)return false;
+    const volatile struct kui_toy_movie_exit_witness *w=&C.movie_exit[(A.variant-1u)/2u];
+    return (w->flags&(KUI_TOY_MOVIE_EXIT_STARTED|KUI_TOY_MOVIE_EXIT_TERMINAL))==
+        KUI_TOY_MOVIE_EXIT_STARTED && w->start_status==0x07dbu;
+}
+
+static bool toy_ahead_clear(kui_retail_async_region_type *r) {
+    if(A.receiving) {
+        if(r->engine.in_irq)return false;
+        if(C.config.ops->stop()!=KUI_SCI_STREAM_OK || C.config.ops->busy())return false;
+        if(!r->engine.active)C.config.ops->unhook();
+    }
+    A.variant=0u;
+    A.receiving=false;
+    A.receive_token=0u;
+    return true;
+}
+
+static bool toy_ahead_begin(const struct kui_retail_async *e,unsigned variant) {
+    const struct kui_toy_movie_range *range=&C.config.movie_ranges[variant-1u];
+    const struct kui_retail_track *track=&e->manifest->slots[e->cursor.track].track;
+    const uint32_t end=range->lba+range->count;
+    if(end>track->end_lba || e->cursor.done || e->cursor.offset || !e->cursor.write ||
+       kui_retail_cursor_begin(&A.cursor,e->manifest,e->cursor.lba,end-e->cursor.lba,
+           KUI_GAME_SECTOR_RAW,toy_ahead_write,
+#if KUI_TOY_SUITE_MODE == 66
+           (void *)e
+#else
+           NULL
+#endif
+           )!=KUI_GAME_OK)return false;
+    A.variant=(uint8_t)variant;
+    A.first=A.verified=e->cursor.lba;
+    A.head=0u;
+    A.error=false;
+#if KUI_TOY_SUITE_MODE >= 65
+    A.retry=0u;
+#endif
+    return true;
+}
+
+#if KUI_TOY_SUITE_MODE != 66
+static bool toy_ahead_dma_idle(void) {
+    return !(read_hw(UINT32_C(0xffa0001c),4u)&7u) &&
+        (read_hw(UINT32_C(0xffa00040),4u)&7u)==1u;
+}
+
+static enum kui_sci_stream_result toy_ahead_arm(kui_retail_async_region_type *r,uint32_t block,bool demand) {
+    struct kui_sci_stream_state *stream=&r->shared.stream;
+    /* Only foreground demand may seek/reopen. A wake or SCI callback can
+     * continue a sequential token without a blocking CMD18/CMD12. */
+    if((!demand || r->engine.in_irq) &&
+       ((stream->state!=RA_PAUSED && stream->state!=AHEAD_TOKEN_WAIT &&
+         !(stream->state==RA_RESUME && A.receive_token &&
+           A.receive_token==r->engine.token)) ||
+        stream->position!=block || !toy_ahead_dma_idle()))return KUI_SCI_STREAM_PENDING;
+    if(r->engine.in_irq==1u && stream->state==RA_RESUME)return KUI_SCI_STREAM_PENDING;
+    C.config.ops->hook();
+    if(!r->engine.release.armed && !demand) {
+        C.config.ops->unhook();
+        return KUI_SCI_STREAM_PENDING;
+    }
+    const enum kui_sci_stream_result result=C.config.ops->fetch(block,AHEAD_TOKEN_LIMIT,false);
+    A.receiving=true;
+    A.receive_token=r->engine.token;
+    return result;
+}
+
+#else
+/* Install the private RAW cursor only for the original native delivery
+ * callback. Completion publication still sees the restored guest cursor. */
+static void toy_ahead_pump(kui_retail_async_region_type *r,bool demand) {
+    (void)demand;
+    struct kui_retail_async *e=&r->engine;
+    struct kui_sci_stream_state *stream=&r->shared.stream;
+    const struct kui_retail_cursor saved_cursor=e->cursor;
+    const uint32_t saved_active=e->active,saved_failed=e->failed;
+    const uint32_t saved_retries=e->retries,saved_since=e->since;
+    const uint8_t saved_policy=stream->toy_suite_active,saved_poll=stream->toy_suite_poll;
+    const uint32_t verified=A.verified;
+    const bool room=A.cursor.done<A.cursor.count && A.verified-A.first<=AHEAD_SLOTS-2u;
+    const bool was_busy=C.config.ops->busy();
+    const bool owned=!A.receive_token || A.receive_token==e->token;
+    const bool foreground=!e->in_irq;
+    const bool slice=foreground && room && (saved_poll==1u || saved_poll==2u);
+
+    if(!room && !was_busy)return;
+    e->cursor=A.cursor;
+    e->active=room;
+    e->failed=0u;
+    e->retries=A.retry;
+    e->since=0u;
+    /* Idle UPDATE has no GD save frame. Keep every scoped delivery on
+     * the native one-pass branch, including when its SCI route is lost. */
+    if(!saved_poll)stream->toy_suite_poll=2u;
+    stream->toy_suite_active=saved_policy|1u;
+    if(owned)stream->toy_suite_active|=KUI_TOY_SUITE_RESUME_ACTIVE|
+        (foreground || e->in_irq==2u?KUI_TOY_SUITE_RESUME_FOREGROUND:0u);
+    if(!was_busy)A.receive_token=e->token;
+    C.config.ops->hook();
+    uint32_t *trace=C.diagnostics.stage_result[KUI_NATIVE_RA_STAGE_NONE];
+    ++trace[foreground?4u:5u];
+    if(slice)toy_resume_slice(r,(A.variant-1u)/2u);
+    else C.config.ops->deliver(0u);
+    A.cursor=e->cursor;
+    A.retry=(uint8_t)e->retries;
+    A.error=A.error || e->failed;
+    C.stats.producer_blocks+=A.verified-verified;
+    A.receiving=C.config.ops->busy() || stream->state>RA_PAUSED;
+    if(!A.receiving)A.receive_token=0u;
+    e->cursor=saved_cursor;
+    e->active=saved_active;
+    e->failed=saved_failed;
+    e->retries=saved_retries;
+    e->since=saved_since;
+    stream->toy_suite_active=saved_policy;
+    stream->toy_suite_poll=saved_poll;
+}
+#endif
+
+#if KUI_TOY_SUITE_MODE != 66
+/* One block per callback. Start the next DMA before CRC/EDC on the ready
+ * block, reserving space for both and for a block that straddles sectors. */
+static void toy_ahead_pump(kui_retail_async_region_type *r,bool demand) {
+    const struct kui_native_ra_low_ops *ops=C.config.ops;
+    struct kui_sci_stream_state *stream=&r->shared.stream;
+    if(A.cursor.done==A.cursor.count || A.verified-A.first>AHEAD_SLOTS-2u)return;
+    const uint8_t saved_active=stream->toy_suite_active;
+    const uint8_t saved_bounded=stream->token_bounded,saved_budget=stream->token_budget;
+    /* An intact DMA block can cross a REQUEST boundary. A parked suffix
+     * remains associated with the token that started that DMA. */
+    if(A.receive_token && A.receive_token==r->engine.token)
+        stream->toy_suite_active|=KUI_TOY_SUITE_RESUME_ACTIVE|
+        (r->engine.in_irq!=1u?KUI_TOY_SUITE_RESUME_FOREGROUND:0u);
+    stream->token_bounded=1u;
+    stream->token_budget=KUI_SCI_STREAM_TOKEN_SLICE;
+    enum kui_sci_stream_result result=KUI_SCI_STREAM_PENDING;
+    const uint32_t block=A.cursor.block;
+#if KUI_TOY_SUITE_MODE == 65
+    if(A.retry) {
+        /* Retire an already-started successor without appending it. Only
+         * foreground may reopen at the failed block, using the usual
+         * sliced command phases and CRC-checked programmed read. */
+        if(ops->busy()) {
+            result=ops->poll(r->engine.in_irq!=0u);
+            if(result==KUI_SCI_STREAM_RESET)
+                toy_ahead_fault(KUI_NATIVE_RA_STAGE_POLL,result,block);
+            if(result==KUI_SCI_STREAM_PENDING || A.error)goto restore;
+        }
+        if(r->engine.in_irq)goto restore;
+        stream->toy_suite_active&=(uint8_t)~(KUI_TOY_SUITE_RESUME_ACTIVE|KUI_TOY_SUITE_RESUME_FOREGROUND);
+        result=ops->fetch(block,AHEAD_TOKEN_LIMIT,true);
+        if(result>KUI_SCI_STREAM_PENDING)toy_ahead_fault(KUI_NATIVE_RA_STAGE_FETCH,result,block);
+        if(result!=KUI_SCI_STREAM_OK)goto restore;
+    } else
+#endif
+    if(ops->busy()) {
+        result=ops->poll(r->engine.in_irq!=0u);
+        if(result==KUI_SCI_STREAM_PENDING)goto restore;
+        if(result!=KUI_SCI_STREAM_OK) {
+#if KUI_TOY_SUITE_MODE == 65
+            toy_ahead_fault(KUI_NATIVE_RA_STAGE_POLL,result,block);
+#else
+            A.error=true;
+#endif
+            goto restore;
+        }
+    }
+    const bool ready=stream->arrived==block+1u;
+    enum kui_sci_stream_result next=KUI_SCI_STREAM_PENDING;
+    if(ready && A.cursor.run>1u && A.verified-A.first<=AHEAD_SLOTS-3u
+#if KUI_TOY_SUITE_MODE == 65
+       && !A.retry
+#endif
+       ) {
+        /* A repair's ownership is tied to the currently accepted token.
+         * The hardware of an ahead-only DMA is retired with repairs off. */
+        next=toy_ahead_arm(r,block+1u,false);
+    }
+#if KUI_TOY_SUITE_MODE != 65
+    if(next>KUI_SCI_STREAM_PENDING)A.error=true;
+#endif
+    const uint8_t *data=ops->take(block,&result);
+    if(data) {
+        const uint32_t verified=A.verified;
+        if(ops->feed(&A.cursor,data)!=KUI_GAME_OK)A.error=true;
+        C.stats.producer_blocks+=A.verified-verified;
+#if KUI_TOY_SUITE_MODE == 65
+        if(A.retry) {
+            ++AHEAD_TRACE[3];
+            A.retry=0u;
+        }
+        if(A.error)toy_ahead_fault(KUI_NATIVE_RA_STAGE_APPEND,KUI_SCI_STREAM_CRC,block);
+        else if(next>KUI_SCI_STREAM_PENDING)
+            toy_ahead_fault(KUI_NATIVE_RA_STAGE_FETCH,next,block+1u);
+#endif
+        if(!A.error && !ops->busy() && stream->state!=AHEAD_TOKEN_WAIT
+#if KUI_TOY_SUITE_MODE == 65
+           && !A.retry
+#endif
+           ) {
+            A.receiving=false;
+            A.receive_token=0u;
+        }
+    } else if(result!=KUI_SCI_STREAM_PENDING) {
+#if KUI_TOY_SUITE_MODE == 65
+        toy_ahead_fault(KUI_NATIVE_RA_STAGE_TAKE,result,block);
+#else
+        A.error=true;
+#endif
+    }
+    if(!A.error && !ready && !data && !ops->busy()) {
+        result=toy_ahead_arm(r,block,demand);
+        if(result>KUI_SCI_STREAM_PENDING) {
+#if KUI_TOY_SUITE_MODE == 65
+            toy_ahead_fault(KUI_NATIVE_RA_STAGE_FETCH,result,block);
+#else
+            A.error=true;
+#endif
+        }
+    }
+restore:
+    stream->toy_suite_active=saved_active;
+    stream->token_bounded=saved_bounded;
+    stream->token_budget=saved_budget;
+}
+
+#endif
+
+static bool toy_ahead_publish(kui_retail_async_region_type *r) {
+    struct kui_retail_async *e=&r->engine;
+    const struct kui_retail_gd *s=&r->shared.service;
+    /* The caller has admitted the whole unchanged native request. */
+    if(s->count>A.verified-A.first)return false;
+    for(uint32_t i=0u;i<s->count && !e->failed;i++)
+        e->cursor.write(e->cursor.context,i*KUI_GAME_DATA_BYTES,
+            toy_ahead_sector(A.first+i)+16u,KUI_GAME_DATA_BYTES);
+    if(!e->failed) {
+        A.first+=s->count;
+        A.head+=s->count;
+        if(A.head>=AHEAD_SLOTS)A.head-=AHEAD_SLOTS;
+        e->cursor.done=s->count;
+        e->since=e->target;
+#if KUI_TOY_SUITE_MODE == 66
+        uint32_t *trace=C.diagnostics.stage_result[KUI_NATIVE_RA_STAGE_NONE];
+        trace[(A.variant-1u)/2u]+=s->count;
+        ++C.stats.hit_requests;
+#endif
+    }
+    e->active=0u;
+    return true;
+}
+
+static bool toy_ahead_fallback(kui_retail_async_region_type *r) {
+    struct kui_retail_async *e=&r->engine;
+    if(toy_ahead_clear(r))return false;
+    if(e->in_irq) {
+        if(C.config.ops->busy())(void)C.config.ops->poll(true);
+    } else if(e->active) {
+        /* The bounded CMD12 failed. Preserve the original cursor and report
+         * an I/O failure rather than leaving the request pending forever. */
+        e->failed=KUI_GD_ERROR_IO;
+        e->active=0u;
+    }
+    return true;
+}
+
+static bool toy_movie_ahead(kui_retail_async_region_type *r,unsigned variant,bool selected,
+    uint32_t wait) {
+    struct kui_retail_async *e=&r->engine;
+    const struct kui_retail_gd *s=&r->shared.service;
+    const bool demand=e->active && s->pending;
+    if(demand && e->failed)return toy_ahead_fallback(r);
+    if(A.variant && !demand && r->shared.stream.state==RA_RESUME &&
+       A.receive_token!=e->token)A.error=true;
+    const bool warm=A.variant && s->lba==A.first && s->count<=A.verified-A.first;
+#if KUI_TOY_SUITE_MODE >= 64
+    /* Katana's aligned GDFS submit immediately calls EXEC at 0x8c0b2b4a
+     * before restoring its mask. The resident already keeps this one
+     * kickoff bounded when its SCI callback is armed. Preserve its FIFO. */
+    const bool kick=r->shared.stream.toy_suite_kick && e->release.armed;
+#else
+    const bool kick=false;
+#endif
+    selected=selected && s->token && !s->executing && !s->completed_bytes &&
+        e->cursor.manifest==e->manifest && e->cursor.lba==s->lba && e->cursor.count==s->count &&
+        !e->cursor.done && !e->cursor.offset && e->cursor.write &&
+        s->count<=KUI_RETAIL_IMAGE_MAX_SECTORS &&
+        (!wait || kick || warm) &&
+        (variant<=2u || C.onset[1].quiet_ctx==UINT32_MAX);
+#if KUI_TOY_SUITE_MODE == 64
+    uint32_t *trace=C.diagnostics.stage_result[KUI_NATIVE_RA_STAGE_NONE];
+    if(demand && A.variant && wait && !warm) {
+        if(kick && selected)++trace[4];
+        if(!kick)++trace[5];
+    }
+#endif
+    if(A.variant && (A.error || !toy_ahead_live() ||
+       (!demand && s->status!=KUI_GD_COMPLETED) ||
+       (s->command && s->command!=KUI_GD_PIOREAD && s->command!=KUI_GD_DMAREAD) ||
+       (demand && (!selected || variant!=A.variant || s->lba!=A.first)))) {
+        if(demand)A.failed_token=s->token;
+        if(toy_ahead_fallback(r))return true;
+    }
+    if(!e->opened || r->shared.port.fault || !r->shared.port.acquired) {
+        return toy_ahead_fallback(r);
+    }
+    if(!A.variant) {
+        if(!selected || !demand || s->token==A.failed_token ||
+           (C.resume.token==s->token && C.resume.state!=TOY_RESUME_IDLE))return false;
+        if(C.config.ops->busy() || !toy_ahead_begin(e,variant)) {
+            A.failed_token=s->token;
+            return false;
+        }
+        toy_resume_invalidate();
+#if KUI_TOY_SUITE_MODE == 64
+        ++trace[2u+(variant-1u)/2u];
+#elif KUI_TOY_SUITE_MODE == 66
+        ++C.diagnostics.stage_result[KUI_NATIVE_RA_STAGE_NONE][2u+(variant-1u)/2u];
+#endif
+    }
+    if(selected && !A.error && toy_ahead_publish(r)) {
+        if(!e->failed) {
+#if KUI_TOY_SUITE_MODE != 66
+            uint32_t *stats=C.diagnostics.stage_result[KUI_NATIVE_RA_STAGE_NONE];
+            stats[(variant-1u)/2u]+=s->count;
+            ++C.stats.hit_requests;
+#endif
+            toy_ahead_pump(r,false);
+        }
+        return true;
+    }
+    toy_ahead_pump(r,demand);
+    if(A.error) {
+        if(demand)A.failed_token=s->token;
+        ++C.stats.abandoned;
+        return toy_ahead_fallback(r);
+    }
+    if(selected && toy_ahead_publish(r)) {
+#if KUI_TOY_SUITE_MODE == 65
+        if(!e->failed)++AHEAD_TRACE[4];
+#endif
+    }
+    return true;
+}
+#if KUI_TOY_SUITE_MODE == 65
+#undef AHEAD_TRACE
+#endif
+#undef A
diff --git a/src/loader/toy_movie_chunk_hook.inc b/src/loader/toy_movie_chunk_hook.inc
new file mode 100644
index 00000000..c02c4ead
--- /dev/null
+++ b/src/loader/toy_movie_chunk_hook.inc
@@ -0,0 +1,52 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+
+/* Observe the native AVI update call at 8c08d894. Its fifth argument
+ * belongs at the original callee's SP. Copy it into the same slot in
+ * the wrapper's 16-byte frame, keeping the incoming stack alignment. */
+    .section .text.toy_movie_chunk,"ax"
+    .balign 4
+    .global C_SYMBOL(kui_toy_movie_chunk_hook)
+    .type C_SYMBOL(kui_toy_movie_chunk_hook),@function
+C_SYMBOL(kui_toy_movie_chunk_hook):
+    movt r0
+    sts pr,r1
+    mov.l .Lchunk_return,r2
+    cmp/eq r2,r1
+    bf .Lchunk_tail
+
+    add #-16,r15
+    mov.l r1,@(12,r15)
+    mov.l @(16,r15),r1
+    mov.l r1,@r15
+    mov r6,r2
+    add #-124,r2
+    mov.l r2,@(8,r15)
+    mov.l .Lchunk_original,r1
+    jsr @r1
+    shlr r0
+
+    movt r1
+    mov.l r1,@r15
+    mov.l r0,@(4,r15)
+    mov.l @(8,r15),r4
+    mov.l .Lchunk_observe,r1
+    jsr @r1
+    mov r0,r5
+
+    mov.l @(12,r15),r1
+    lds r1,pr
+    mov.l @(4,r15),r0
+    mov.l @r15,r1
+    add #16,r15
+    rts
+    shlr r1
+.Lchunk_tail:
+    mov.l .Lchunk_original,r1
+    jmp @r1
+    shlr r0
+
+    .balign 4
+.Lchunk_return: .long 0x8c08d898
+.Lchunk_original: .long 0x8c08edbc
+.Lchunk_observe: .long C_SYMBOL(kui_toy_movie_chunk_observe)
+    .size C_SYMBOL(kui_toy_movie_chunk_hook),.-C_SYMBOL(kui_toy_movie_chunk_hook)
diff --git a/src/loader/toy_movie_exit_hook.inc b/src/loader/toy_movie_exit_hook.inc
new file mode 100644
index 00000000..11cb283d
--- /dev/null
+++ b/src/loader/toy_movie_exit_hook.inc
@@ -0,0 +1,447 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include "kui/toy_movie_exit.h"
+
+#define TOY_INTRO_OPEN_POLICY (KUI_TOY_SUITE_MODE == 54 || KUI_TOY_SUITE_MODE == 56)
+#define TOY_MOVIE_OUTPUT_WITNESS (KUI_TOY_SUITE_MODE >= 49 && KUI_TOY_SUITE_MODE <= 66)
+#define TOY_MOVIE_PRESENT_WITNESS (KUI_TOY_SUITE_MODE == 60 || KUI_TOY_SUITE_MODE >= 61)
+
+/* Installed at the exact original movie-update pointer. Tail-call the
+ * original for every untracked caller. Capture start and first terminal
+ * results using the existing uncached auxiliary context. The intro-buffer
+ * profiles consider available space only at the original start call. */
+    .section .text.toy_movie_exit,"ax"
+    .balign 4
+    .global C_SYMBOL(kui_toy_movie_exit_hook)
+    .type C_SYMBOL(kui_toy_movie_exit_hook),@function
+C_SYMBOL(kui_toy_movie_exit_hook):
+    movt r7
+    sts pr,r1
+    mov.l .Lexit_start_return,r2
+    cmp/eq r2,r1
+    bf .Lexit_maybe_update
+    mov.w .Lexit_start_cmd,r2
+    cmp/eq r2,r5
+#if TOY_INTRO_OPEN_POLICY
+    bf .Lexit_tail_jump
+    bra .Lexit_opening_buffer
+    nop
+.Lexit_tail_jump:
+#else
+    bt .Lexit_call
+#endif
+    bra .Lexit_tail
+    nop
+.Lexit_maybe_update:
+    mov.l .Lexit_update_return,r2
+    cmp/eq r2,r1
+    bf .Lexit_maybe_followup
+    tst r5,r5
+    bt .Lexit_call
+    bra .Lexit_check_stop
+    nop
+.Lexit_maybe_followup:
+    mov.l .Lexit_followup_return,r2
+    cmp/eq r2,r1
+#if TOY_INTRO_OPEN_POLICY
+    bf .Lexit_tail_jump
+#elif TOY_MOVIE_PRESENT_WITNESS
+    bf .Lexit_tail_short
+#else
+    bf .Lexit_tail
+#endif
+.Lexit_check_stop:
+    mov #4,r2
+    cmp/eq r2,r5
+#if TOY_INTRO_OPEN_POLICY
+    bf .Lexit_tail_jump
+#elif TOY_MOVIE_PRESENT_WITNESS
+    bt .Lexit_call
+.Lexit_tail_short:
+    bra .Lexit_tail
+    nop
+#else
+    bf .Lexit_tail
+#endif
+.Lexit_call:
+#if TOY_INTRO_OPEN_POLICY
+    mov #0,r2
+.Lexit_call_marked:
+#endif
+    mov.l r4,@-r15
+    mov.l r5,@-r15
+    sts.l pr,@-r15
+#if TOY_INTRO_OPEN_POLICY
+    mov.l r2,@-r15
+#else
+    add #-4,r15
+#endif
+    mov.l .Lexit_original,r1
+    jsr @r1
+    shlr r7
+    movt r7
+#if TOY_INTRO_OPEN_POLICY
+    mov.l @r15+,r2
+    or r2,r7
+#else
+    add #4,r15
+#endif
+    lds.l @r15+,pr
+    mov.l @r15+,r5
+    mov.l @r15+,r4
+    mov.w .Lexit_start_cmd,r2
+    cmp/eq r2,r5
+    bt/s .Lexit_name
+    mov #KUI_TOY_MOVIE_EXIT_STARTED,r6
+    mov #KUI_TOY_MOVIE_EXIT_TERMINAL,r6
+    cmp/pz r0
+    bf .Lexit_name
+    mov.w .Lexit_stop_status,r2
+    cmp/eq r2,r0
+#if KUI_TOY_SUITE_MODE >= 62
+    bt .Lexit_name
+    tst r5,r5
+    bf .Lexit_done
+    add #-16,r15
+    sts pr,r1
+    mov.l r1,@(12,r15)
+    mov.l r7,@(8,r15)
+    mov.l r0,@(4,r15)
+    mov.l .Lexit_ahead_update,r1
+    jsr @r1
+    nop
+    mov.l @(12,r15),r1
+    lds r1,pr
+    mov.l @(4,r15),r0
+    mov.l @(8,r15),r7
+    bra .Lexit_done
+    add #16,r15
+#else
+    bf .Lexit_done
+#endif
+.Lexit_name:
+    mov.w .Lexit_name_offset,r1
+    add r4,r1
+    mov.l @r1+,r3
+    mov.l .Lexit_name_ntsc,r2
+    cmp/eq r2,r3
+    bt .Lexit_movie
+    mov.l .Lexit_name_pal,r2
+    cmp/eq r2,r3
+    bf .Lexit_done
+.Lexit_movie:
+    mov.l @r1+,r3
+    mov.l .Lexit_bumper1,r2
+    cmp/eq r2,r3
+    bf .Lexit_intro
+    mov.l @r1+,r3
+    mov.l .Lexit_bumper2,r2
+    cmp/eq r2,r3
+    bf .Lexit_done
+    mov.l @r1+,r3
+    mov.l .Lexit_bumper3,r2
+    cmp/eq r2,r3
+    bf .Lexit_done
+    mov.l @r1+,r3
+    mov.l .Lexit_bumper4,r2
+    cmp/eq r2,r3
+    bf .Lexit_done
+    mov.b @r1,r3
+    tst r3,r3
+    bf .Lexit_done
+    mov.l .Lexit_witness,r2
+    bra .Lexit_record
+    nop
+.Lexit_intro:
+    mov.l .Lexit_intro1,r2
+    cmp/eq r2,r3
+    bf .Lexit_done
+    mov.l @r1+,r3
+    mov.l .Lexit_intro2,r2
+    cmp/eq r2,r3
+    bf .Lexit_done
+    mov.l @r1+,r3
+    mov.l .Lexit_intro3,r2
+    cmp/eq r2,r3
+    bf .Lexit_done
+    mov.l @r1,r3
+    mov.l .Lexit_intro4,r2
+    cmp/eq r2,r3
+    bf .Lexit_done
+    mov.l .Lexit_witness,r2
+    add #KUI_TOY_MOVIE_EXIT_BYTES,r2
+.Lexit_record:
+    mov.l @r2,r1
+    mov #KUI_TOY_MOVIE_EXIT_STARTED,r3
+    cmp/eq r3,r6
+    bf .Lexit_terminal
+    tst r1,r1
+    bf .Lexit_done
+    mov.l r0,@(4,r2)
+#if TOY_INTRO_OPEN_POLICY
+    mov r7,r3
+#if KUI_TOY_SUITE_MODE == 56
+    mov #KUI_TOY_MOVIE_EXIT_MORE_PREFILL,r1
+#else
+    mov #KUI_TOY_MOVIE_EXIT_LARGER_BUFFER,r1
+#endif
+    and r1,r3
+    or r3,r6
+    mov #1,r3
+    and r3,r7
+#endif
+#if !TOY_MOVIE_OUTPUT_WITNESS
+    mov.w .Lexit_frame_offset,r3
+    add r4,r3
+    mov.l @r3,r3
+    mov.l r3,@(8,r2)
+    mov.w .Lexit_sample_offset,r3
+    add r4,r3
+    mov.l @r3,r3
+    mov.l r3,@(12,r2)
+#endif
+#if TOY_MOVIE_PRESENT_WITNESS
+    mov.l r6,@r2
+    bra .Lexit_present_boundary
+    nop
+#else
+    bra .Lexit_done
+    mov.l r6,@r2
+#endif
+.Lexit_terminal:
+    tst r3,r1
+    bt .Lexit_done
+    tst r6,r1
+    bf .Lexit_done
+    or r6,r1
+    mov #KUI_TOY_MOVIE_EXIT_INPUT_STOP,r3
+    cmp/eq r3,r5
+    bf .Lexit_terminal_fields
+    sts pr,r6
+    mov.l .Lexit_followup_return,r3
+    cmp/eq r3,r6
+    bf/s .Lexit_publish_stop_kind
+    mov #KUI_TOY_MOVIE_EXIT_INPUT_STOP,r3
+    mov #KUI_TOY_MOVIE_EXIT_FOLLOWUP_STOP,r3
+.Lexit_publish_stop_kind:
+    or r3,r1
+.Lexit_terminal_fields:
+    mov.l r0,@(16,r2)
+#if TOY_MOVIE_OUTPUT_WITNESS
+    /* These are the owner's output-callback and no-output advance
+     * counters, separate from its overall frame cursor. */
+    mov.w .Lexit_output_offset,r3
+    add r4,r3
+    mov.l @r3,r3
+    mov.l r3,@(8,r2)
+    mov.w .Lexit_skip_offset,r3
+    add r4,r3
+    mov.l @r3,r3
+    mov.l r3,@(12,r2)
+#endif
+    mov.w .Lexit_frame_offset,r3
+    add r4,r3
+    mov.l @r3,r3
+    mov.l r3,@(20,r2)
+    mov.w .Lexit_sample_offset,r3
+    add r4,r3
+    mov.l @r3,r3
+    mov.l r3,@(24,r2)
+    mov.w .Lexit_lag_status,r3
+    cmp/eq r3,r0
+    bf .Lexit_publish
+    mov.l .Lexit_lag,r3
+    mov.l @r3,r3
+    mov.l r3,@(28,r2)
+    mov.w .Lexit_limit_offset,r3
+    add r4,r3
+    mov.l @r3,r3
+    shll r3
+    mov.l r3,@(32,r2)
+.Lexit_publish:
+    mov.l r1,@r2
+#if TOY_MOVIE_PRESENT_WITNESS
+    mov #KUI_TOY_MOVIE_EXIT_TERMINAL,r6
+.Lexit_present_boundary:
+    /* R4 is the exact game owner and R2 the identified witness slot. */
+    add #-16,r15
+    sts pr,r1
+    mov.l r1,@(12,r15)
+    mov.l r7,@(8,r15)
+    mov.l r0,@(4,r15)
+    mov.l .Lexit_present_boundary_handler,r1
+    jsr @r1
+    mov r2,r5
+    mov.l @(12,r15),r1
+    lds r1,pr
+    mov.l @(4,r15),r0
+    mov.l @(8,r15),r7
+    add #16,r15
+#endif
+.Lexit_done:
+    rts
+    shlr r7
+.Lexit_tail:
+    mov.l .Lexit_original,r1
+    jmp @r1
+    shlr r7
+
+#if TOY_INTRO_OPEN_POLICY
+.Lexit_start_cmd: .word 0x0200
+.Lexit_stop_status: .word 0x07dc
+.Lexit_lag_status: .word 0xf843
+.Lexit_name_offset: .word 0x00bc
+.Lexit_frame_offset: .word 0x01c0
+.Lexit_sample_offset: .word 0x0244
+.Lexit_limit_offset: .word 0x00a0
+.Lexit_output_offset: .word 0x00ac
+.Lexit_skip_offset: .word 0x0090
+
+.Lexit_opening_buffer:
+    /* The wrapper passes its local context at SP+4. At the recognized
+     * START dispatch the owner has reserved a further 12 stack bytes. */
+    mov r15,r1
+    add #16,r1
+    cmp/eq r1,r4
+    bf .Lexit_normal_buffer
+    mov.w .Lexit_opening_name_offset,r1
+    add r4,r1
+    mov.l @r1+,r3
+    mov.l .Lexit_name_ntsc,r2
+    cmp/eq r2,r3
+    bt .Lexit_opening_name
+    mov.l .Lexit_name_pal,r2
+    cmp/eq r2,r3
+    bf .Lexit_normal_buffer
+.Lexit_opening_name:
+    mov.l @r1+,r3
+    mov.l .Lexit_intro1,r2
+    cmp/eq r2,r3
+    bf .Lexit_normal_buffer
+    mov.l @r1+,r3
+    mov.l .Lexit_intro2,r2
+    cmp/eq r2,r3
+    bf .Lexit_normal_buffer
+    mov.l @r1+,r3
+    mov.l .Lexit_intro3,r2
+    cmp/eq r2,r3
+    bf .Lexit_normal_buffer
+    mov.l @r1,r3
+    mov.l .Lexit_intro4,r2
+    cmp/eq r2,r3
+    bf .Lexit_normal_buffer
+
+    /* Respect any existing caller overrides. */
+    mov.w .Lexit_buffer_offset,r1
+    add r4,r1
+    mov.l @r1+,r3
+    mov.l .Lexit_buffer_1m,r2
+    cmp/eq r2,r3
+    bf .Lexit_normal_buffer
+    mov.l @r1,r3
+    mov #-1,r2
+    cmp/eq r2,r3
+    bf .Lexit_normal_buffer
+#if KUI_TOY_SUITE_MODE == 56
+    /* 960 KiB gives 192 KiB more lead in the original 1 MiB ring. */
+    mov.l .Lexit_prefill,r3
+    mov #KUI_TOY_MOVIE_EXIT_MORE_PREFILL,r2
+    bra .Lexit_call_marked
+    mov.l r3,@r1
+#else
+    mov.l .Lexit_allocator_slot,r1
+    mov.l @r1,r3
+    mov.l .Lexit_default_allocator,r2
+    cmp/eq r2,r3
+    bf .Lexit_normal_buffer
+
+    /* The SDK query takes pointers to total and largest free sizes.
+     * Keep one further MiB available in the same contiguous free block
+     * for the original player setup, plus the split block header. The
+     * original allocator owns the actual allocation and all cleanup. */
+    mov.l r0,@-r15
+    mov.l r4,@-r15
+    mov.l r5,@-r15
+    mov.l r6,@-r15
+    mov.l r7,@-r15
+    sts.l pr,@-r15
+    add #-8,r15
+    mov r15,r4
+    mov r15,r5
+    add #4,r5
+    mov.l .Lexit_query_allocator,r1
+    jsr @r1
+    nop
+    mov.l @(4,r15),r2
+    add #8,r15
+    lds.l @r15+,pr
+    mov.l @r15+,r7
+    mov.l @r15+,r6
+    mov.l @r15+,r5
+    mov.l @r15+,r4
+    mov.l @r15+,r0
+    mov.l .Lexit_buffer_min_free,r3
+    cmp/hs r3,r2
+    bf .Lexit_normal_buffer
+    mov.w .Lexit_buffer_offset,r1
+    add r4,r1
+    mov.l .Lexit_buffer_2m,r3
+    mov #KUI_TOY_MOVIE_EXIT_LARGER_BUFFER,r2
+    bra .Lexit_call_marked
+    mov.l r3,@r1
+#endif
+.Lexit_normal_buffer:
+    bra .Lexit_call
+    nop
+#endif
+
+    .balign 4
+.Lexit_original: .long 0x8c08d638
+.Lexit_start_return: .long 0x8c06d3f0
+.Lexit_update_return: .long 0x8c06d39a
+.Lexit_followup_return: .long 0x8c06d3c0
+.Lexit_witness: .long C_SYMBOL(kui_native_readahead_aux_context)+KUI_TOY_MOVIE_EXIT_OFFSET
+#if TOY_MOVIE_PRESENT_WITNESS
+.Lexit_present_boundary_handler: .long C_SYMBOL(kui_toy_movie_present_boundary)
+#endif
+#if KUI_TOY_SUITE_MODE >= 62
+.Lexit_ahead_update: .long C_SYMBOL(kui_toy_movie_ahead_update)
+#endif
+.Lexit_lag: .long 0x8c1138c4
+.Lexit_name_ntsc: .ascii "60hz"
+.Lexit_name_pal: .ascii "50hz"
+.Lexit_bumper1: .ascii "_Bum"
+.Lexit_bumper2: .ascii "per_"
+.Lexit_bumper3: .ascii "LRTF"
+.Lexit_bumper4: .ascii ".avi"
+.Lexit_intro1: .ascii "_Int"
+.Lexit_intro2: .ascii "ro_L"
+.Lexit_intro3: .ascii "RTF."
+.Lexit_intro4: .asciz "avi"
+#if !TOY_INTRO_OPEN_POLICY
+.Lexit_start_cmd: .word 0x0200
+.Lexit_stop_status: .word 0x07dc
+.Lexit_lag_status: .word 0xf843
+.Lexit_name_offset: .word 0x00bc
+.Lexit_frame_offset: .word 0x01c0
+.Lexit_sample_offset: .word 0x0244
+.Lexit_limit_offset: .word 0x00a0
+#if TOY_MOVIE_OUTPUT_WITNESS
+.Lexit_output_offset: .word 0x00ac
+.Lexit_skip_offset: .word 0x0090
+#endif
+#else
+.Lexit_opening_name_offset: .word 0x00bc
+.Lexit_buffer_offset: .word 0x01dc
+    .balign 4
+.Lexit_buffer_1m: .long 0x00100000
+#if KUI_TOY_SUITE_MODE == 56
+.Lexit_prefill: .long 0x000f0000
+#else
+.Lexit_buffer_2m: .long 0x00200000
+.Lexit_buffer_min_free: .long 0x00300020
+.Lexit_allocator_slot: .long 0x8c117dbc
+.Lexit_default_allocator: .long 0x8c0c5ac8
+.Lexit_query_allocator: .long 0x8c0b3e6e
+#endif
+#endif
