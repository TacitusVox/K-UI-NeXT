+    CHECK(R.shared.stream.toy_suite_active & KUI_TOY_SUITE_FIRST_CUT_ACTIVE);
+    cut_movie_dma(token);
+    CHECK(R.shared.stream.toy_suite_slow_pending == KUI_TOY_SCI_PIO_WINDOW_FIRST);
+    CHECK(!kui_sci_stream_stats()->toy_retry_slow && !payload_calls);
+    return token;
+}
