new file mode 100644
index 00000000..6860c4c5
--- /dev/null
+++ b/tests/test_toy_dma_priority.py
@@ -0,0 +1,200 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-only
+"""Run the real Toy DMA priority installer and replay five original C2 starts.
+
+Pass the private ToyCommander-1GUTH.BIN as the only argument. The host test
+models P1/P2 cache publication. The SH replay observes register writes, with
+no hardware arbitration or movie playback emulation.
+"""
+
+import argparse
+from hashlib import sha256
+import os
+from pathlib import Path
+from struct import iter_unpack
+import subprocess
+from tempfile import TemporaryDirectory
+
+from test_toy_original_gd_poll import SOURCE_BYTES, SOURCE_SHA256
+from test_vmu_native_heap_execution import ROOT, SH, signed
+
+
+BASE = 0x8C010000
+PRIORITY_LITERALS = (0x8C094F98, 0x8C095A6C)
+ORIGINAL_DMAOR, RX_FIRST_DMAOR = 0x8201, 0x8001
+SAR2, DMATCR2, CHCR2, DMAOR = 0xFFA00020, 0xFFA00028, 0xFFA0002C, 0xFFA00040
+C2DSTAT, C2DLEN, C2DST = 0xA05F6800, 0xA05F6804, 0xA05F6808
+SRC, DST, LENGTH = 0x0C200000, 0x10800000, 0x6000
+
+
+HOST = r"""
+#define _GNU_SOURCE
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+
+#define BASE UINT32_C(0x8c010000)
+#define P2 UINT32_C(0x20000000)
+#define BYTES 748444u
+
+static const uint32_t literals[] = {0x8c094f98u, 0x8c095a6cu};
+static uint8_t *p1, *p2;
+static unsigned publishes;
+static uint32_t drop_publication;
+
+static uint32_t native_word(uint32_t address) {
+    assert(address == (literals[0] | P2) || address == (literals[1] | P2));
+    uint32_t value;
+    memcpy(&value, p2 + (address - (BASE | P2)), sizeof(value));
+    return value;
+}
+
+static void native_publish(uint32_t address) {
+    assert(address == literals[0] || address == literals[1]);
+    ++publishes;
+    size_t offset = (address & ~31u) - BASE;
+    if(address != drop_publication) memcpy(p2 + offset, p1 + offset, 32u);
+}
+
+#include "toy_dma_priority_stage.inc"
+
+int main(int argc, char **argv) {
+    assert(argc == 2);
+    p1 = mmap((void *)(uintptr_t)BASE, BYTES, PROT_READ | PROT_WRITE,
+              MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);
+    p2 = malloc(BYTES);
+    uint8_t *original = malloc(BYTES);
+    assert(p1 == (void *)(uintptr_t)BASE && p2 && original);
+    FILE *file = fopen(argv[1], "rb");
+    assert(file && fread(original, 1u, BYTES, file) == BYTES && fgetc(file) == EOF);
+    assert(fclose(file) == 0);
+
+    for(unsigned i = 0; i < 2u; ++i) {
+        memcpy(p1, original, BYTES);
+        memcpy(p2, original, BYTES);
+        size_t offset = literals[i] - BASE;
+        p1[offset] ^= 1u;
+        p2[offset] ^= 1u;
+        assert(!toy_dma_priority_install() && publishes == 0u);
+        assert(p1[offset] == (original[offset] ^ 1u));
+        assert(p2[offset] == (original[offset] ^ 1u));
+        p1[offset] ^= 1u;
+        p2[offset] ^= 1u;
+        assert(memcmp(p1, original, BYTES) == 0 && memcmp(p2, original, BYTES) == 0);
+    }
+
+    for(unsigned i = 0; i < 2u; ++i) {
+        memcpy(p1, original, BYTES);
+        memcpy(p2, original, BYTES);
+        drop_publication = literals[i];
+        assert(!toy_dma_priority_install());
+    }
+
+    memcpy(p1, original, BYTES);
+    memcpy(p2, original, BYTES);
+    drop_publication = 0u;
+    publishes = 0u;
+    assert(toy_dma_priority_install() && publishes == 2u);
+    assert(memcmp(p1, p2, BYTES) == 0);
+    assert(fwrite(p2, 1u, BYTES, stdout) == BYTES);
+}
+"""
+
+
+class C2Start(SH):
+    """Replay the original integer setup instructions up to C2DST."""
+
+    def __init__(self, image):
+        super().__init__(image)
+        self.mmio = {address: 0 for address in (SAR2, DMATCR2, CHCR2, DMAOR, C2DSTAT, C2DLEN, C2DST)}
+        self.r[14] = 0x8C00E000
+        for offset, value in ((12, LENGTH), (16, SRC), (20, DST)):
+            self.write(self.r[14] + offset, value)
+
+    def read(self, address, count=4):
+        if address in self.mmio:
+            assert count == 4
+            return self.mmio[address]
+        return super().read(address, count)
+
+    def write(self, address, value, count=4):
+        if address in self.mmio:
+            assert count == 4
+            self.mmio[address] = value
+            self.writes.append((self.executing, address, value, count))
+        else:
+            super().write(address, value, count)
+
+    def step_plain(self, pc):
+        self.plain(self.read(pc, 2), pc)
+
+    def run_setup(self, entry, dmaor_pc, start_pc, priority):
+        if entry == 0x8C094EE0:
+            self.r[6], self.r[5] = CHCR2, 1
+        else:
+            # These four setup slices run after the common prologue has
+            # loaded the priority literal and initialized the other inputs.
+            self.step_plain(0x8C095986)
+            self.r[9], self.r[10], self.r[11], self.r[12], self.r[13] = SAR2, C2DSTAT, 0, 1, CHCR2
+        self.writes.clear()
+        pc = entry
+        for _ in range(50):
+            op = self.read(pc, 2)
+            if op >> 12 == 0xA:
+                self.step_plain(pc + 2)  # The branches have real store delay slots.
+                pc += 4 + 2 * signed(op & 0xFFF, 12)
+            else:
+                self.step_plain(pc)
+                pc += 2
+            if self.mmio[C2DST]:
+                break
+        assert self.writes[-1] == (start_pc, C2DST, 1, 4)
+        assert self.mmio == {
+            SAR2: SRC, DMATCR2: LENGTH // 32, CHCR2: 0x12C1,
+            DMAOR: priority, C2DSTAT: DST, C2DLEN: LENGTH, C2DST: 1,
+        }
+        assert [write for write in self.writes if write[1] == DMAOR] == [(dmaor_pc, DMAOR, priority, 4)]
+        return self.writes
+
+
+def install_with_host(path):
+    with TemporaryDirectory(prefix="kui-toy-dma-priority-") as tmp:
+        src, tool = Path(tmp) / "install.c", Path(tmp) / "install"
+        src.write_text(HOST)
+        subprocess.run([os.environ.get("CC", "cc"), "-std=c11", "-O2", "-Wall", "-Wextra", "-Werror",
+                        "-I", str(ROOT / "src/loader"), str(src), "-o", str(tool)], check=True)
+        return subprocess.run([str(tool), str(path)], check=True, stdout=subprocess.PIPE).stdout
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("original", type=Path)
+    args = parser.parse_args()
+    original = args.original.read_bytes()
+    assert len(original) == SOURCE_BYTES and sha256(original).hexdigest() == SOURCE_SHA256
+    assert tuple(BASE + 4 * i for i, (word,) in enumerate(iter_unpack("<I", original))
+                 if word == ORIGINAL_DMAOR) == PRIORITY_LITERALS
+    patched = install_with_host(args.original)
+    expected = bytearray(original)
+    assert ORIGINAL_DMAOR ^ RX_FIRST_DMAOR == 0x0200
+    for address in PRIORITY_LITERALS:
+        offset = address - BASE
+        expected[offset:offset + 4] = RX_FIRST_DMAOR.to_bytes(4, "little")
+    assert patched == expected
+
+    for route in ((0x8C094EE0, 0x8C094EFA, 0x8C094F52), (0x8C0959C0, 0x8C0959DA, 0x8C095AD0),
+                  (0x8C0959E6, 0x8C095A00, 0x8C095AD0), (0x8C095AA4, 0x8C095AC0, 0x8C095AD0),
+                  (0x8C095AEC, 0x8C095B08, 0x8C095B1A)):
+        old_writes = C2Start(original).run_setup(*route, ORIGINAL_DMAOR)
+        new_writes = C2Start(patched).run_setup(*route, RX_FIRST_DMAOR)
+        assert new_writes == [(pc, address, RX_FIRST_DMAOR if address == DMAOR else value, count)
+                              for pc, address, value, count in old_writes]
+    print("Original Toy DMA priority: exact SHA and two edits, five C2 starts, P1/P2 publication and refusals verified")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/test_toy_fmv_compare.c b/tests/test_toy_fmv_compare.c
new file mode 100644
index 00000000..f17c3138
--- /dev/null
+++ b/tests/test_toy_fmv_compare.c
@@ -0,0 +1,112 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include "kui/toy_fmv_compare.h"
+#include "kui/gd_service.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+static const struct kui_toy_movie_range ranges[4]={
+    {1000u,600u},{2000u,600u},{3000u,600u},{4000u,600u}
+};
+
+static void test_movie_bins(void) {
+    struct kui_toy_fmv_trace trace={0};
+    const uint32_t begin=256u;
+    const uint32_t half=KUI_TOY_FMV_BIN_TICKS;
+    struct kui_toy_fmv_movie *bumper=&trace.movie[0], *intro=&trace.movie[1];
+
+    /* The header, the end of an extent, and invalid requests are excluded. */
+    kui_toy_fmv_request(&trace,ranges,1u,1385u,1u,begin);
+    kui_toy_fmv_request(&trace,ranges,1u,1600u,1u,begin);
+    kui_toy_fmv_request(&trace,ranges,0u,1386u,1u,begin);
+    kui_toy_fmv_request(&trace,ranges,1u,1386u,0u,begin);
+    assert(!bumper->requests && !intro->requests);
+
+    /* Requests are attributed to their issue bin and completions to their
+     * CHECK bin. Two handles can overlap and complete out of issue order. */
+    kui_toy_fmv_request(&trace,ranges,1u,1386u,4u,begin);
+    kui_toy_fmv_request(&trace,ranges,2u,1390u,2u,begin-1u);
+    kui_toy_fmv_status(&trace,1u,begin-2u,KUI_GD_PROCESSING,2048u);
+    kui_toy_fmv_status(&trace,3u,begin-3u,KUI_GD_COMPLETED,2048u);
+    assert(bumper->requests==2u && bumper->bins[0].requested==6u && !bumper->acks);
+    kui_toy_fmv_status(&trace,2u,begin-(half-1u),KUI_GD_COMPLETED,4096u);
+    assert(bumper->bins[0].completed==2u && bumper->bins[0].longest==half-2u);
+    assert(bumper->end_lba==1392u);
+    kui_toy_fmv_status(&trace,1u,begin-half,KUI_GD_COMPLETED,6145u);
+    kui_toy_fmv_status(&trace,1u,begin-half-1u,KUI_GD_COMPLETED,8192u);
+    assert(bumper->acks==2u && bumper->short_bytes==1u && !bumper->failed);
+    assert(bumper->bins[1].completed==3u && bumper->bins[1].longest==half);
+    assert(bumper->bins[1].gap==1u && bumper->end_lba==1389u && !trace.clock_lost);
+
+    /* Each movie has its own zero. A failed read ends its request without
+     * adding successful sectors, even if CHECK reports a byte count. */
+    const uint32_t intro_begin=begin-17u*half;
+    kui_toy_fmv_request(&trace,ranges,3u,4386u,5u,intro_begin);
+    kui_toy_fmv_status(&trace,3u,intro_begin-half,KUI_GD_FAILED,4096u);
+    assert(intro->first_tick==intro_begin && intro->bins[0].requested==5u);
+    assert(intro->acks==1u && intro->failed==1u && !intro->short_bytes);
+    assert(!intro->bins[1].completed && intro->bins[1].longest==half);
+    kui_toy_fmv_request(&trace,ranges,4u,4391u,1u,intro_begin-20u*half);
+    kui_toy_fmv_status(&trace,4u,intro_begin-20u*half-1u,KUI_GD_COMPLETED,2048u);
+    assert(intro->bins[12].requested==1u && intro->bins[12].completed==1u);
+    assert(intro->bins[12].gap==19u*half+1u && intro->end_lba==4392u);
+}
+
+static void test_pending_and_clock(void) {
+    struct kui_toy_fmv_trace trace={0};
+    struct kui_toy_fmv_movie *bumper=&trace.movie[0], *intro=&trace.movie[1];
+    const uint32_t begin=1000u;
+
+    for(uint32_t token=1u;token<=KUI_TOY_FMV_PENDING+1u;++token)
+        kui_toy_fmv_request(&trace,ranges,token,2386u,1u,begin-token);
+    assert(bumper->requests==KUI_TOY_FMV_PENDING+1u && bumper->unmatched==1u);
+    kui_toy_fmv_status(&trace,KUI_TOY_FMV_PENDING+1u,begin-8u,KUI_GD_COMPLETED,2048u);
+    assert(!bumper->acks);
+
+    kui_toy_fmv_request(&trace,ranges,2u,3386u,2u,begin-10u);
+    assert(bumper->unmatched==2u && intro->requests==1u);
+    kui_toy_fmv_status(&trace,2u,begin-11u,KUI_GD_COMPLETED,4096u);
+    assert(intro->acks==1u && intro->bins[0].completed==2u && !bumper->acks);
+
+    kui_toy_fmv_status(&trace,1u,begin+1u,KUI_GD_COMPLETED,2048u);
+    kui_toy_fmv_request(&trace,ranges,7u,2387u,1u,begin+1u);
+    assert(trace.clock_lost==2u && !bumper->acks);
+    assert(bumper->requests==KUI_TOY_FMV_PENDING+1u);
+    kui_toy_fmv_request(&trace,ranges,7u,2387u,1u,begin-13u);
+    kui_toy_fmv_status(&trace,7u,begin-14u,KUI_GD_COMPLETED,4096u);
+    assert(bumper->acks==1u && bumper->short_bytes==1u);
+    assert(bumper->bins[0].completed==1u);
+}
+
+static void test_format(void) {
+    struct kui_toy_fmv_trace trace={0};
+    struct kui_toy_fmv_movie *bumper=&trace.movie[0];
+    char guarded[KUI_TOY_REPORT_FILE_BYTES+3u];
+    memset(guarded,'!',sizeof(guarded));
+    char *const report=guarded+1u;
+    const char end[]="\nEND REPORT\n";
+    const size_t end_bytes=sizeof(end)-1u;
+
+    bumper->requests=UINT32_MAX;
+    bumper->bins[0]=(struct kui_toy_fmv_bin){UINT32_MAX,5u,781u,1562u};
+    trace.pending[0]=(struct kui_toy_fmv_pending){5u,100u,4386u,1u,1u};
+    trace.clock_lost=UINT32_MAX;
+    kui_toy_fmv_format(report,&trace,"PHYSICAL-LONG","123456789abc-extra");
+    assert(guarded[0]=='!' && report[KUI_TOY_REPORT_FILE_BYTES]=='!');
+    assert(report[KUI_TOY_REPORT_FILE_BYTES+1u]=='!');
+    assert(memcmp(report+KUI_TOY_REPORT_FILE_BYTES-end_bytes,end,end_bytes)==0);
+    report[KUI_TOY_REPORT_FILE_BYTES]='\0';
+    assert(strstr(report,"K-UI TOY FMV COMPARE V1 / PHYSICAL 123456789abc\n"));
+    assert(strstr(report,"BUMPER\nFFFF 0000 0000 0000 0000 0000 00000000 00000000\n"));
+    assert(strstr(report,"FFFF 0005 0001 0002\n"));
+    assert(strstr(report,"INTRO\n0000 0000 0000 0000 0000 0001 00000000 00000000\n"));
+    assert(strstr(report,"CLOCK LOST FFFFFFFF\n"));
+}
+
+int main(void) {
+    test_movie_bins();
+    test_pending_and_clock();
+    test_format();
+    puts("Toy FMV comparison bins, pending handles, clock and report passed");
+    return 0;
+}
diff --git a/tests/test_toy_movie_iso_stage.c b/tests/test_toy_movie_iso_stage.c
new file mode 100644
index 00000000..e50e09b0
--- /dev/null
+++ b/tests/test_toy_movie_iso_stage.c
@@ -0,0 +1,74 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include "retail_storage.h"
+#include "kui/retail_image.h"
+#include "kui/vmu_native_mode.h"
+#include "kui/vmu_launch_package.h"
+#include <assert.h>
+#include <string.h>
+
+static struct kui_retail_manifest manifest;
+static struct kui_retail_storage card;
+static struct kui_retail_image image;
+static uint8_t raw_boot[KUI_GAME_DATA_BYTES], volume[KUI_GAME_DATA_BYTES], directory[KUI_GAME_DATA_BYTES];
+static uint32_t boot_crc, exec_bytes, largest_range;
+static unsigned acquire, release;
+static bool fail_stop;
+
+static uint32_t native_runtime_mode(void) { return KUI_VMU_NATIVE_MODE_READER_ONLY; }
+enum kui_loader_sd_result kui_retail_storage_acquire(struct kui_retail_storage *s) {
+    assert(s==&card);++acquire;return KUI_LOADER_SD_OK;
+}
+enum kui_loader_sd_result kui_retail_storage_stop(struct kui_retail_storage *s) {
+    assert(s==&card);return fail_stop?KUI_LOADER_SD_TIMEOUT:KUI_LOADER_SD_OK;
+}
+void kui_retail_storage_release(struct kui_retail_storage *s) { assert(s==&card);++release; }
+enum kui_game_result kui_retail_image_read(struct kui_retail_image *img,uint32_t lba,
+    uint32_t count,enum kui_game_sector_format format,void *out,size_t bytes) {
+    assert(img==&image && count==1u && format==KUI_GAME_SECTOR_MODE1 && bytes==KUI_GAME_DATA_BYTES);
+    if(lba==45016u)memcpy(out,volume,bytes);
+    else if(lba==45020u)memcpy(out,directory,bytes);
+    else return KUI_GAME_RANGE;
+    return KUI_GAME_OK;
+}
+enum kui_game_result kui_retail_image_check_validated(const struct kui_retail_manifest *m,
+    uint32_t lba,uint32_t count,enum kui_game_sector_format format) {
+    assert(m==&manifest && format==KUI_GAME_SECTOR_MODE1 && count<=KUI_RETAIL_IMAGE_MAX_SECTORS);
+    if(count>largest_range)largest_range=count;
+    return lba>=49000u && lba+count<52000u?KUI_GAME_OK:KUI_GAME_RANGE;
+}
+#include "toy_movie_iso_stage.inc"
+
+static void dual(uint8_t *p,uint32_t value) {
+    for(unsigned i=0;i<4u;i++)p[i]=p[7u-i]=(uint8_t)(value>>(i*8u));
+}
+static unsigned record(uint8_t *p,const char *name,unsigned length,uint32_t lba,
+    uint32_t bytes,uint8_t flags) {
+    unsigned record_size=33u+length+!(length&1u);
+    memset(p,0,record_size);p[0]=record_size;p[25]=flags;p[32]=length;
+    dual(p+2,lba);dual(p+10,bytes);memcpy(p+33,name,length);
+    return record_size;
+}
+static void reset(void) {
+    memset(toy_movie_ranges,0,sizeof(toy_movie_ranges));
+    memset(volume,0,sizeof(volume));memset(directory,0,sizeof(directory));
+    manifest.reader=KUI_RETAIL_READER_ASYNC;manifest.session_lba=45000u;
+    manifest.ip_crc32=KUI_VMU_LAUNCH_TOY_IP_CRC;boot_crc=KUI_VMU_LAUNCH_TOY_EXEC_CRC;
+    exec_bytes=KUI_VMU_LAUNCH_TOY_EXEC_BYTES;
+    volume[0]=1u;memcpy(volume+1,"CD001\1",6u);volume[129]=volume[130]=8u;
+    record(volume+156,"\0",1u,45020u,2048u,2u);
+    const char bumper[]="60hz_Bumper_LRTF.avi;1",intro[]="60HZ_INTRO_LRTF.AVI";
+    unsigned next=record(directory,bumper,sizeof(bumper)-1u,49000u,130u*2048u,0u);
+    record(directory+next,intro,sizeof(intro)-1u,51000u,340u*2048u+1u,0u);
+    acquire=release=largest_range=0u;fail_stop=false;
+}
+int main(void) {
+    reset();toy_movie_scan();
+    assert(acquire==1u && release==1u && largest_range==64u);
+    assert(!toy_movie_ranges[0].count && toy_movie_ranges[1].lba==49000u && toy_movie_ranges[1].count==130u);
+    assert(!toy_movie_ranges[2].count && toy_movie_ranges[3].lba==51000u && toy_movie_ranges[3].count==341u);
+    reset();fail_stop=true;toy_movie_scan();assert(release==1u && !toy_movie_ranges[1].count);
+    reset();directory[25]=128u;toy_movie_scan();assert(release==1u && !toy_movie_ranges[1].count);
+    reset();directory[9]^=1u;toy_movie_scan();assert(release==1u && !toy_movie_ranges[1].count);
+    reset();boot_crc=0u;toy_movie_scan();assert(!acquire && !toy_movie_ranges[1].count);
+    return 0;
+}
diff --git a/tests/test_toy_original_gd_poll.py b/tests/test_toy_original_gd_poll.py
new file mode 100644
index 00000000..6ef42561
--- /dev/null
+++ b/tests/test_toy_original_gd_poll.py
@@ -0,0 +1,324 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-only
+"""Replay the exact Toy Commander GDFS paths around GD EXEC and CHECK.
+
+Requires the original private executable as input. The test models BIOS GD
+returns, ASIC status and cache-line addresses. Game instructions and stack
+frames execute from the executable with initialized objects supplied by the
+test. The ASIC tests start at the SDK's installed dispatchers after hardware
+interrupt acceptance, so the varied entry masks test the local code.
+"""
+
+import argparse
+from hashlib import sha256
+from itertools import product
+from pathlib import Path
+import sys
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "tools"))
+from profile_vmu_native_release_sh import ReleaseSH
+from check_vmu_native_worker_gateway import read_elf, symbol_bytes
+from sh4_delay_slots import validate_delay_slot
+from test_vmu_native_heap_execution import SH, MASK, signed
+
+
+SOURCE_BYTES = 748444
+SOURCE_SHA256 = "ee68a326da964fec5892b7226311f2293fd3a0bbf5bac496ec82991964d49bbd"
+MOVIE_POLL = 0x8C097114
+ALIGNED_REFILL = 0x8C0B2A98
+ASIC_DISPATCH, ASIC_FPU_DISPATCH = 0x8C085B8C, 0x8C085C78
+ASIC_NORMAL_STATUS, ASIC_EXTERNAL_STATUS = 0xA05F6900, 0xA05F6908
+ASIC_CONTEXT, ASIC_CALLBACKS = 0x8C1135F4, 0x8C1135F4 + 48
+ASIC_EVENT, ASIC_CALLBACK = 29, 0x8C0884B0
+SCAN_INTERRUPT = 1 << 3
+EVENT_WRAPPER = 0x8C0B3B6E
+EVENT_STEP = 0x8C0B1704
+EVENT_HEAD = 0x8C117CFC
+EVENT_LIST = 0x8C113574
+EVENT_NODE = 0x8C116ACC
+GDFS_MANAGER_CELL = 0x8C0C69EC
+GDFS_DISPATCH_CELL = 0x8C0C69F8
+GDFS_DISPATCH = 0x8C0C5980
+GD_BACKEND = 0x8C0C6260
+GD_VECTOR = 0x8C0000BC
+GD_FIRMWARE = 0x8C000800
+MANAGER, FILE, TOKEN = 0x8C117F00, 0x8C118000, 0x42
+REFILL_LBA, REFILL_SECTORS, REFILL_DST = 0x70000, 14, 0x8C200000
+STACK, RETURN = 0x8C00E000, 0x8C008A00
+REQUEST, CHECK, EXEC = 0, 1, 2
+GD_PROCESSING, GD_COMPLETED = 1, 2
+IMASK = 0xF0
+CONTINUATIONS = {
+    "event": 0x8C0B3B88,
+    "event_fpu": 0x8C0B3B88,
+    "nonblocking": 0x8C097144,
+    "blocking": 0x8C09712A,
+    "refill": 0x8C0B2B4E,
+}
+
+
+class ToyGdReplay(ReleaseSH):
+    def __init__(self, image, completed_on, resident):
+        SH.__init__(self, image)
+        self.active = False
+        self.completed_on = completed_on
+        self.events = []
+        self.cache_invalidations = []
+        self.asic_status = {ASIC_NORMAL_STATUS: SCAN_INTERRUPT, ASIC_EXTERNAL_STATUS: 0}
+        self.mach, self.macl, self.fpscr = 0x45671234, 0x87653210, 0x180001
+        self.fr = [0x12345678 + i for i in range(16)]
+        self.checks = 0
+        self.hook = self.dispatch = self.poll_frame = self.caller = None
+        self.publications = 0
+        self.resident_code = []
+        if resident:
+            data, _, segments, _, symbols = resident
+            bottom = symbols["__retail_hook_stack_bottom"][0]
+            top = symbols["__retail_hook_stack"][0]
+            assert (bottom, top) in ((0x8C007BA0, 0x8C007D00), (0x8C007CE0, 0x8C007E40),
+                                     (0x8C007D60, 0x8C007EC0), (0x8C007E80, 0x8C007FE0))
+            for kind, offset, address, _, stored, memory, flags, _ in segments:
+                if kind == 1:
+                    assert 0x8C004000 <= address <= bottom - memory
+                    self.store_block(address, data[offset:offset + stored] + bytes(memory - stored))
+                    if flags & 1:
+                        self.resident_code.append(range(address, address + stored))
+            self.hook = symbols["_kui_retail_resident_hook"][0]
+            self.dispatch = symbols["_kui_retail_resident_dispatch"][0]
+            self.poll_frame = symbols["_kui_toy_poll_frame"][0]
+            self.hook_active = symbols["_kui_retail_hook_active"][0]
+            self.hook_source = symbols["_kui_retail_hook_source"][0]
+            self.hook_stack = top - 16
+            self.hook_fault = symbols["_kui_retail_hook_fault"][0]
+            self.write(bottom, 0x4B554947)
+        self.write(GD_VECTOR, self.hook or GD_FIRMWARE)
+        self.write(GDFS_MANAGER_CELL, MANAGER)
+        self.write(GDFS_DISPATCH_CELL, GDFS_DISPATCH)
+        self.write(MANAGER + 12, GD_BACKEND)
+        self.write(MANAGER + 28, FILE)
+        self.write(FILE + 60, TOKEN)
+        self.write(FILE + 76, 1, 2)  # Open file handle.
+        self.write(FILE + 80, 2, 2)  # GDFS file is reading.
+        self.write(ASIC_CONTEXT + 24, SCAN_INTERRUPT)
+        self.write(ASIC_CALLBACKS + 16 * ASIC_EVENT, ASIC_CALLBACK)
+        self.write(EVENT_LIST + 8, EVENT_WRAPPER)
+        self.write(EVENT_HEAD, EVENT_NODE)
+        self.write(EVENT_NODE, EVENT_STEP)
+        self.write(EVENT_NODE + 8, MANAGER)
+
+    def read(self, address, count=4):
+        if address in self.asic_status:
+            assert count == 4
+            return self.asic_status[address]
+        return super().read(address, count)
+
+    def write(self, address, value, count=4):
+        if address in self.asic_status:
+            assert count == 4 and address == ASIC_NORMAL_STATUS and value == SCAN_INTERRUPT
+            self.asic_status[address] &= ~value
+        else:
+            if address == self.poll_frame:
+                pr, stack, sr = self.caller
+                assert count == 4 and self.r[15] == self.r[8] == value == stack - 36
+                assert self.read(value + 28) == pr
+                assert self.read(value + 32) == sr
+                assert self.read(self.hook_active) == 1 and self.read(self.hook_source) == 0
+                self.publications += 1
+            super().write(address, value, count)
+
+    def plain(self, op, pc):
+        n, m = (op >> 8) & 15, (op >> 4) & 15
+        if op & 0xF00F == 0x0006:  # mov.l Rm,@(R0,Rn)
+            self.write((self.r[0] + self.r[n]) & MASK, self.r[m])
+        elif op & 0xF00F == 0x3003:  # cmp/ge Rm,Rn
+            self.flag(signed(self.r[n], 32) >= signed(self.r[m], 32))
+        elif op & 0xF00F == 0x3007:  # cmp/gt Rm,Rn
+            self.flag(signed(self.r[n], 32) > signed(self.r[m], 32))
+        elif op & 0xF0FF == 0x0093:  # ocbi @Rn
+            self.cache_invalidations.append(self.r[n])
+        elif op & 0xF0FF == 0x4018:  # shll8 Rn
+            self.r[n] = self.r[n] << 8 & MASK
+        elif op & 0xF0FF == 0x006A:  # sts FPSCR,Rn
+            self.r[n] = self.fpscr
+        elif op & 0xF0FF == 0x406A:  # lds Rn,FPSCR
+            self.fpscr = self.r[n]
+        elif op & 0xF0FF in (0x4002, 0x4012):  # sts.l MACH/MACL,@-Rn
+            self.r[n] -= 4
+            self.write(self.r[n], self.macl if op & 0x10 else self.mach)
+        elif op & 0xF0FF in (0x4006, 0x4016):  # lds.l @Rn+,MACH/MACL
+            value = self.read(self.r[n])
+            self.r[n] += 4
+            if op & 0x10:
+                self.macl = value
+            else:
+                self.mach = value
+        elif op & 0xF00F == 0xF00B:  # fmov FRm,@-Rn, single width
+            assert not self.fpscr & 0x180000
+            self.r[n] -= 4
+            self.write(self.r[n], self.fr[m])
+        elif op & 0xF00F == 0xF009:  # fmov @Rm+,FRn, single width
+            assert not self.fpscr & 0x180000
+            self.fr[n] = self.read(self.r[m])
+            self.r[m] += 4
+        else:
+            return super().plain(op, pc)
+        self.executing = pc
+        self.instructions += 1
+
+    def bios_gd(self):
+        function = self.r[7]
+        assert self.r[6] == 0
+        if self.hook:
+            pr, stack, sr = self.caller
+            assert self.r[15] == self.hook_stack
+            assert self.read(self.poll_frame) == stack - 36
+            assert self.sr & 0x100000F0 == 0x100000F0
+            assert self.read(self.hook_active) == 1 and self.read(self.hook_fault) == 0
+            self.caller = None
+        else:
+            pr, stack, sr = self.pr, self.r[15], self.sr
+        if function == REQUEST:
+            assert pr == 0x8C0BD2B6 and self.r[4] == 17
+            assert [self.read(self.r[5] + 4 * i) for i in range(4)] == [
+                REFILL_LBA, REFILL_SECTORS, REFILL_DST & 0x1FFFFFFF, 0,
+            ]
+            continuation = self.read(stack + 20)
+            self.r[0] = TOKEN
+        elif function == EXEC:
+            assert pr == 0x8C0BD55A
+            continuation = self.read(stack)
+            if continuation == 0x8C0B1FE6:
+                continuation = self.read(stack + 4)
+            self.r[0] = 0
+        else:
+            assert function == CHECK and pr == 0x8C0BD374
+            assert self.read(stack + 16) == 0x8C0B145C
+            continuation = self.read(stack + 64)
+            assert self.r[4] == TOKEN
+            assert self.r[5] == stack
+            self.checks += 1
+            complete = self.checks >= self.completed_on
+            for i, word in enumerate((0, 0, 14 * 2048 if complete else 0, 0)):
+                self.write(self.r[5] + 4 * i, word)
+            self.r[0] = GD_COMPLETED if complete else GD_PROCESSING
+        self.events.append((function, sr & IMASK, continuation))
+        self.pc = self.pr
+
+    def run_poll(self, entry, mask, args):
+        saved = self.r[8:15]
+        saved_math = self.fr[:], self.fpscr, self.mach, self.macl
+        self.pc, self.pr, self.r[15] = entry, RETURN, STACK
+        self.sr = 0x40000000 | mask << 4
+        self.r[4:4 + len(args)] = args
+        for _ in range(4000):
+            pc = self.pc
+            if pc == RETURN:
+                assert self.pr == RETURN and self.r[15] == STACK
+                assert self.r[8:15] == saved
+                assert (self.fr, self.fpscr, self.mach, self.macl) == saved_math
+                assert not self.sr & 0x10000000  # No new SR.BL.
+                if self.hook:
+                    assert self.publications == len(self.events)
+                    assert self.read(self.hook_active) == self.read(self.hook_fault) == 0
+                return self.r[0]
+            if pc == self.hook:
+                assert self.caller is None
+                self.caller = self.pr, self.r[15], self.sr
+            if pc == (self.dispatch or GD_FIRMWARE):
+                self.bios_gd()
+                continue
+            in_original = 0x8C010000 <= pc < 0x8C010000 + SOURCE_BYTES
+            assert in_original or any(pc in region for region in self.resident_code), hex(pc)
+            op = self.read(pc, 2)
+            target, delayed = pc + 2, False
+            if op >> 12 in (0xA, 0xB):
+                target = pc + 4 + 2 * signed(op & 0xFFF, 12)
+                delayed = True
+                if op >> 12 == 0xB:
+                    self.pr = pc + 4
+            elif op & 0xF0FF in (0x400B, 0x402B):
+                target, delayed = self.r[(op >> 8) & 15], True
+                if op & 0xF0FF == 0x400B:
+                    self.pr = pc + 4
+            elif op == 0x000B:
+                target, delayed = self.pr, True
+            elif op >> 8 in (0x89, 0x8B, 0x8D, 0x8F):
+                delayed = op >> 8 in (0x8D, 0x8F)
+                taken = bool(self.sr & 1) == (op >> 8 in (0x89, 0x8D))
+                target = pc + 4 + 2 * signed(op & 255, 8) if taken else pc + (4 if delayed else 2)
+            else:
+                self.plain(op, pc)
+            if delayed:
+                slot = self.read(pc + 2, 2)
+                validate_delay_slot(slot, pc)
+                self.plain(slot, pc + 2)
+            self.pc = target & MASK
+        raise AssertionError("Original GDFS poll exceeded its instruction bound")
+
+
+def check_poll_paths(image, resident):
+    count = 0
+    for mask, route in product(range(16), CONTINUATIONS):
+        continuation = CONTINUATIONS[route]
+        if route in ("event", "event_fpu"):
+            cpu = ToyGdReplay(image, 2, resident)
+            entry = ASIC_DISPATCH if route == "event" else ASIC_FPU_DISPATCH
+            cpu.run_poll(entry, mask, ())
+            assert cpu.asic_status[ASIC_NORMAL_STATUS] == 0
+            expected_mask, passes = 6, 1
+        elif route == "nonblocking":
+            cpu = ToyGdReplay(image, 2, resident)
+            assert cpu.run_poll(MOVIE_POLL, mask, (FILE, 0)) == 0
+            expected_mask, passes = mask, 1
+        elif route == "blocking":
+            cpu = ToyGdReplay(image, 3, resident)
+            assert cpu.run_poll(MOVIE_POLL, mask, (FILE, 1)) == 1
+            expected_mask, passes = mask, 3
+        else:
+            cpu = ToyGdReplay(image, 2, resident)
+            cpu.write(MANAGER + 28, 0)
+            cpu.write(FILE, MANAGER)
+            cpu.write(FILE + 8, REFILL_LBA)
+            cpu.write(FILE + 16, 64)
+            cpu.write(FILE + 78, 1, 2)  # Aligned direct DMA.
+            assert cpu.run_poll(ALIGNED_REFILL, mask, (FILE, REFILL_SECTORS, REFILL_DST)) == REFILL_SECTORS
+            assert cpu.read(FILE + 60) == TOKEN
+            assert cpu.cache_invalidations == list(range(REFILL_DST, REFILL_DST + 14 * 2048, 32))
+            expected_mask, passes = mask, 0
+        if route == "refill":
+            expected = [(REQUEST, 0xF0, 0x8C0B2B24), (EXEC, 0xF0, continuation)]
+        else:
+            expected = [(EXEC, expected_mask << 4, continuation),
+                        (CHECK, expected_mask << 4, continuation)] * passes
+        assert cpu.events == expected, (route, mask, cpu.events)
+        assert cpu.sr & IMASK == expected_mask << 4
+        count += len(cpu.events)
+    return count
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("original", type=Path)
+    parser.add_argument("--resident", type=Path, help="Linked Toy movie-poll SCI resident ELF")
+    parser.add_argument("--stage", type=Path, help="Linked Toy movie-poll stage ELF")
+    args = parser.parse_args()
+    original = args.original.read_bytes()
+    assert len(original) == SOURCE_BYTES and sha256(original).hexdigest() == SOURCE_SHA256
+    if args.stage:
+        stage = read_elf(args.stage)
+        digests = [name for name in stage[4]
+                   if name.split(".")[0] == "_toy_poll_digest"]
+        assert len(digests) == 1, "Linked stage is missing the exact poll-owner digest"
+        _, digest, _ = symbol_bytes(stage, digests[0], 1)
+        assert digest == sha256(original).digest(), (
+            "Linked stage's poll-owner digest rejects the original executable", digest.hex(),
+        )
+    resident = read_elf(args.resident) if args.resident else None
+    calls = check_poll_paths(original, resident)
+    entry = "linked GD hook" if resident else "firmware stub"
+    print(f"Original Toy GDFS via {entry}: 80 cases, {calls} GD calls and exact caller frames verified")
+
+
+if __name__ == "__main__":
+    main()
