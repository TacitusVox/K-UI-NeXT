+
+#define KUI_DISC_TOY_TRACE_LEASE 0x8cfd0000u
+#define KUI_DISC_TOY_TRACE_BYTES 0x00030000u
+#define KUI_DISC_TOY_TRACE_LINK 0xacfd0000u
+#define KUI_DISC_TOY_TRACE_GD_VECTOR 0xac0000bcu
