diff --git a/src/apps/toy_suite_report_prepare.inc b/src/apps/toy_suite_report_prepare.inc
new file mode 100644
index 00000000..c27884b1
--- /dev/null
+++ b/src/apps/toy_suite_report_prepare.inc
@@ -0,0 +1,143 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include "kui/toy_suite_report_wire.h"
+#include "kui/vmu_backing.h"
+#include "kui/disc_launcher.h"
+
+static size_t toy_report_seed_slot(const struct kui_runtime_image *package) {
+    const uint8_t *payload=package->data;
+    const size_t bytes=package->info.payload_bytes;
+    size_t found=SIZE_MAX;
+    for(size_t at=0;bytes>=KUI_TOY_REPORT_WIRE_BYTES && at<=bytes-KUI_TOY_REPORT_WIRE_BYTES;at+=4u) {
+        const uint8_t *p=payload+at;
+        if(le32(p)!=KUI_TOY_REPORT_MAGIC0 || le32(p+4u)!=KUI_TOY_REPORT_MAGIC1 ||
+           le32(p+8u)!=KUI_TOY_REPORT_VERSION || le32(p+12u)!=KUI_TOY_REPORT_WIRE_BYTES)continue;
+        unsigned nonblank=0;
+        for(unsigned i=KUI_TOY_REPORT_TEST_OFFSET;i<KUI_TOY_REPORT_WIRE_BYTES;i++)nonblank|=p[i];
+        if(nonblank || found!=SIZE_MAX)return SIZE_MAX;
+        found=at;
+    }
+    return found;
+}
+
+static bool toy_report_create(unsigned test,char path[48],uint8_t blank[KUI_TOY_REPORT_FILE_BYTES],
+    kui_log_fn log,kui_cancel_fn cancel) {
+    static const char *const dirs[]={"0:/reports","0:/reports/toy"};
+    for(unsigned i=0;i<sizeof(dirs)/sizeof(*dirs);i++) {
+        if(cancel())return false;
+        FRESULT r=f_mkdir(dirs[i]);
+        if(r!=FR_OK && r!=FR_EXIST) {log("Toy report folder failed: FatFs=%u",(unsigned)r);return false;}
+    }
+    FIL file;
+    for(unsigned run=1u;run<=9999u && !cancel();run++) {
+        if(run==1u)snprintf(path,48u,"0:/reports/toy/%u.txt",test);
+        else snprintf(path,48u,"0:/reports/toy/%u-%u.txt",test,run);
+        FRESULT r=f_open(&file,path,FA_CREATE_NEW|FA_WRITE);
+        if(r==FR_EXIST)continue;
+        if(r!=FR_OK) {log("Toy report create failed: FatFs=%u",(unsigned)r);return false;}
+        memset(blank,' ',KUI_TOY_REPORT_FILE_BYTES);
+        for(unsigned i=0;i<2u;i++) {
+            uint8_t *p=blank+i*KUI_TOY_REPORT_SECTOR_BYTES;
+            int n=snprintf((char *)p,KUI_TOY_REPORT_SECTOR_BYTES,
+                "K-UI Toy Commander test %u, run %u, reserved block %u/2\n"
+                "Report pending. Hold both triggers and A+B+X+Y in the game to save.\n",test,run,i+1u);
+            if(n<0 || (unsigned)n>=KUI_TOY_REPORT_SECTOR_BYTES) {
+                (void)f_close(&file);return false;
+            }
+            p[n]=' ';
+            p[KUI_TOY_REPORT_SECTOR_BYTES-1u]='\n';
+        }
+        UINT written=0;
+        bool ok=f_write(&file,blank,KUI_TOY_REPORT_FILE_BYTES,&written)==FR_OK &&
+            written==KUI_TOY_REPORT_FILE_BYTES;
+        if(ok)ok=f_sync(&file)==FR_OK;
+        if(f_close(&file)!=FR_OK)ok=false;
+        if(!ok)log("Toy report allocation could not be flushed: %s",path+2u);
+        return ok;
+    }
+    log("Toy report allocation cancelled or all run numbers are in use");
+    return false;
+}
+
+static bool toy_report_sectors(const struct kui_retail_extent extents[2],unsigned count,
+    const struct kui_retail_manifest *map,const struct kui_volume *volume,
+    uint64_t data_first,uint32_t lba[2]) {
+    unsigned at=0;
+    if(!count || count>2u ||
+       (map && map->track_count+map->extent_count>KUI_RETAIL_ASYNC_SLOTS))return false;
+    for(unsigned i=0;i<count;i++) {
+        const struct kui_retail_extent *e=&extents[i];
+        if(e->file_block!=at || !e->blocks || e->blocks>2u-at || e->card_lba<data_first ||
+           e->card_lba<volume->start ||
+           (uint64_t)e->card_lba+e->blocks>(uint64_t)volume->start+volume->count)return false;
+        for(unsigned j=0;j<e->blocks;j++)lba[at++]=e->card_lba+j;
+        for(unsigned j=0;map && j<map->extent_count;j++) {
+            const struct kui_retail_extent *g=&map->slots[map->track_count+j].extent;
+            if((uint64_t)e->card_lba<(uint64_t)g->card_lba+g->blocks &&
+               (uint64_t)g->card_lba<(uint64_t)e->card_lba+e->blocks)return false;
+        }
+    }
+    return at==2u && lba[0]!=lba[1];
+}
+
+/* The last operation with this mounted card. Leave it unmounted if we get
+ * as far as the physical proof. A failed proof leaves the reader seed blank. */
+static bool toy_report_prepare(FATFS *fs,const struct kui_volume *volume,
+    const struct kui_retail_manifest *map,struct kui_runtime_image *package,unsigned test,
+    kui_log_fn log,kui_cancel_fn cancel) {
+    const size_t slot=toy_report_seed_slot(package);
+    if(slot==SIZE_MAX) {log("Toy report binding needs a matching reader module");return false;}
+    const uint64_t volume_end=(uint64_t)volume->start+volume->count;
+    if((!kui_toy_suite_package(test) && !(KUI_TOY_DISC_TRACE_ENABLED &&
+       test==KUI_TOY_DISC_TRACE_TEST)) || (fs->fs_type!=FS_FAT32 && fs->fs_type!=FS_EXFAT) ||
+       kui_storage_active()!=KUI_STORAGE_SCI || (map &&
+       (map->storage_transport!=KUI_STORAGE_SCI || volume->start!=map->partition_start ||
+        volume_end!=map->partition_end)))return false;
+    char path[48];
+    _Alignas(32) uint8_t blank[KUI_TOY_REPORT_FILE_BYTES],sector[KUI_TOY_REPORT_SECTOR_BYTES];
+    if(!toy_report_create(test,path,blank,log,cancel))return false;
+    struct kui_retail_extent extents[2];unsigned count=0;uint64_t bytes=0;
+    const char *problem=NULL;
+    struct kui_toy_report_wire seed={.magic={KUI_TOY_REPORT_MAGIC0,KUI_TOY_REPORT_MAGIC1},
+        .version=KUI_TOY_REPORT_VERSION,.bytes=KUI_TOY_REPORT_WIRE_BYTES,.test=test};
+    if(!kui_native_session_map_file(fs,volume,path,extents,2u,&count,&bytes,&problem,cancel) ||
+       bytes!=KUI_TOY_REPORT_FILE_BYTES ||
+       !toy_report_sectors(extents,count,map,volume,(uint64_t)volume->start+fs->database,seed.lba)) {
+        log("Toy report allocation could not be mapped safely: %s",path+2u);return false;
+    }
+    if(f_mount(NULL,"0:",0)!=FR_OK || cancel())return false;
+    struct kui_media_ops raw;
+    struct kui_vmu_sd_identity identity;
+    if(!kui_sd_raw_read_ops(&raw) || !raw.read || !kui_sd_card_identity(&identity) ||
+       identity.sectors<volume_end)return false;
+    for(unsigned i=0;i<2u;i++) {
+        if(cancel() || raw.read(raw.ctx,seed.lba[i],1u,sector) ||
+           memcmp(sector,blank+i*KUI_TOY_REPORT_SECTOR_BYTES,KUI_TOY_REPORT_SECTOR_BYTES)) {
+            log("Toy report physical readback failed: %s block %u",path+2u,i+1u);return false;
+        }
+        seed.placeholder_crc[i]=kui_retail_crc32(0,sector,sizeof(sector));
+    }
+    memcpy(seed.cid,identity.cid,sizeof(seed.cid));
+    seed.high_capacity=identity.high_capacity?1u:0u;
+    seed.crc32=kui_retail_crc32(0,&seed,KUI_TOY_REPORT_CRC_OFFSET);
+    memcpy((uint8_t *)package->data+slot,&seed,sizeof(seed));
+    log("Toy report file prepared: %s",path+2u);
+    return true;
+}
+
+#if KUI_TOY_DISC_TRACE_ENABLED
+bool kui_toy_report_prepare_disc(struct kui_runtime_image *package,kui_log_fn log,kui_cancel_fn cancel) {
+    if(toy_report_seed_slot(package)==SIZE_MAX)return false;
+    const bool photo_fallback=KUI_TOY_PHYSICAL_BASELINE_ENABLED;
+    if(!kui_sd_connect()) {
+        if(photo_fallback)log("Toy disc report unavailable; photograph the report pages");
+        return photo_fallback && !cancel();
+    }
+    FATFS fs;
+    bool ready=kui_mount(&fs,log) && toy_report_prepare(&fs,kui_media_volume(),NULL,
+        package,KUI_TOY_DISC_TRACE_TEST,log,cancel);
+    bool unmounted=f_mount(NULL,"0:",0)==FR_OK;
+    kui_sd_disconnect();
+    if(!ready && photo_fallback)log("Toy disc report unavailable; photograph the report pages");
+    return (ready || photo_fallback) && unmounted && !cancel();
+}
+#endif
