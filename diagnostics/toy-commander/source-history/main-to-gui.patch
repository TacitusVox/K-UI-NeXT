+/* Identity is independently checked by Games inspection, at launch, and
+ * by the detached loader. A name, product code, or folder suffix is not
+ * an image format or executable check. */
+static inline unsigned kui_toy_suite_sector_bytes(const struct kui_game_image *image,
+    const struct kui_game_metadata *metadata) {
+    if(!image || !metadata || image->format!=KUI_GAME_IMAGE_GDI || image->compressed ||
+       image->scrambled || image->cd_image || image->count!=15u ||
+       image->data_lba!=KUI_VMU_LAUNCH_TOY_SESSION_LBA ||
+       metadata->session_lba!=KUI_VMU_LAUNCH_TOY_SESSION_LBA ||
+       !metadata->ip_valid || !metadata->boot_valid || !metadata->native_gd ||
+       metadata->native_cd || metadata->windows_ce ||
+       metadata->boot_lba!=KUI_VMU_LAUNCH_TOY_BOOT_LBA ||
+       metadata->boot_bytes!=KUI_VMU_LAUNCH_TOY_EXEC_BYTES)return 0u;
+    static const uint32_t starts[]={0u,7257u,45000u,201900u,219712u,234091u,
+        255599u,272017u,282799u,303092u,323352u,341314u,356690u,374201u,377422u};
+    static const uint32_t ends[]={7107u,7753u,201750u,219712u,234091u,
+        255599u,272017u,282799u,303092u,323352u,341314u,356690u,374201u,377272u,549150u};
+    const unsigned bytes=image->tracks[0].sector_bytes;
+    if(bytes!=KUI_GAME_DATA_BYTES && bytes!=KUI_GAME_RAW_BYTES)return 0u;
+    for(unsigned i=0;i<image->count;i++) {
+        const struct kui_game_image_track *track=&image->tracks[i];
+        const bool data=i==0u || i==2u || i==14u;
+        if(track->number!=i+1u || track->start_lba!=starts[i] || track->end_lba!=ends[i] ||
+           track->control!=(data?4u:0u) || track->file_offset ||
+           track->file_bytes!=(uint64_t)(ends[i]-starts[i])*track->sector_bytes ||
+           track->sector_bytes!=(data?bytes:KUI_GAME_RAW_BYTES) ||
+           track->sector_mode!=(data?1u:0u) ||
+           track->data_offset!=(data && bytes==KUI_GAME_RAW_BYTES?16u:0u))return 0u;
+    }
+    return bytes;
+}
