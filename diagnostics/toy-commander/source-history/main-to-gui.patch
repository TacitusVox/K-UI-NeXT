+    uint8_t *payload=image->data,*slot=NULL;
+    const size_t bytes=image->info.payload_bytes;
+    for(size_t at=0;bytes>=sizeof(seed) && at<=bytes-sizeof(seed);at+=4u) {
+        if(memcmp(payload+at,seed,sizeof(seed)))continue;
+        if(slot)return false;
+        slot=payload+at;
+    }
