	ASAN_OPTIONS=detect_leaks=0 $(BUILD)/test-survey-mixed-pad-cdda
endif
ifeq ($(TOY_CDDA_CARD),1)
# Test 85 (CARD): and with the audio's consumer called at both heartbeats
# under the survey's rule, behind the survey where the worker has one, and
