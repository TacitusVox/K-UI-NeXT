 $(foreach s,STREAM TICK CACHED WORDS PACE IDLE LEAN OPEN CLEAN MSB QUICK SWIFT STEADY FLUID SEQ ANY TITLES QUERY TIMER \
 STAY LATER RING QUIT HOT COPY GAP APART,TOY_WIRE_$(s)=$(TOY_WIRE_$(s)))
