	ASAN_OPTIONS=detect_leaks=0 $(BUILD)/test-survey-mixed-pad-card
	$(HOST_CC) $(TOY_SURVEY_MIXED_PAD_HOST_FLAGS) -DKUI_NATIVE_COOP_PUMP=1 -DKUI_NATIVE_IRQ_REARM=1 \
	 -DKUI_TOY_CDDA_CARD=1 tests/test_toy_survey_mixed_pad.c $(COMPAT_WORKER_HOST_SRC) \
	 -Wl,--gc-sections -o $(BUILD)/test-survey-mixed-pad-card-alone
	ASAN_OPTIONS=detect_leaks=0 $(BUILD)/test-survey-mixed-pad-card-alone
endif
