# heartbeats, the completion built with the worker's cooperative pump.
	$(HOST_CC) $(TOY_SURVEY_MIXED_PAD_HOST_FLAGS) -DKUI_NATIVE_COOP_PUMP=1 -DKUI_NATIVE_IRQ_REARM=1 \
