+/* Validate the complete header before any state machine reads sequence numbers,
+   computes payload size or walks the advertised options. */
+static int tcp_header_valid(const uint8_t *wire, size_t size) {
+    if(size < sizeof(tcp_hdr_t))
+        return 0;
+    const tcp_hdr_t *tcp = (const tcp_hdr_t *)wire;
+    size_t header = TCP_GET_OFFSET(ntohs(tcp->off_flags));
+    if(header < sizeof(*tcp) || header > size)
+        return 0;
+    for(size_t i = sizeof(*tcp); i < header;) {
+        uint8_t kind = wire[i++];
+        if(kind == TCP_OPT_EOL)
+            break;
+        if(kind == TCP_OPT_NOP)
+            continue;
+        if(i >= header)
+            return 0;
+        size_t length = wire[i];
+        if(length < 2 || length-1 > header-i)
+            return 0;
+        if(kind == TCP_OPT_MSS && (length != 4 || !(wire[i+1] | wire[i+2])))
+            return 0;
+        i += length-1;
+    }
+    return 1;
 }

