+/* The fd is being closed and the payload has been acknowledged. Only control
+   traffic remains. Remember the original FIN sequence for retries. */
+static void tcp_begin_close(struct tcp_sock *sock) {
+    tcp_send_fin_ack(sock, sock->data.snd.nxt);
+    ++sock->data.snd.nxt;
+    sock->state = sock->state == TCP_STATE_CLOSE_WAIT ? TCP_STATE_LAST_ACK : TCP_STATE_FIN_WAIT_1;
+    sock->data.timer = timer_ms_gettime64();
+}
+
+static void tcp_enter_time_wait(struct tcp_sock *sock) {
+    /* Keep the tuple and sequence state for duplicate FINs. There is no
+       file descriptor and TIME_WAIT cannot deliver or retransmit payload. */
+    sock->state = TCP_STATE_TIME_WAIT;
+    sock->data.timer = timer_ms_gettime64();
+    free(sock->data.sndbuf);
+    free(sock->data.rcvbuf);
+    sock->data.sndbuf = sock->data.rcvbuf = NULL;
+    sock->data.sndbuf_cur_sz = sock->data.rcvbuf_cur_sz = 0;
+}

