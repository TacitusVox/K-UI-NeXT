+/* Keep the worker and RX storage alive until the last G2 completion.
+   Mask only the NIC IRQ: DMA completion has its own interrupt. */
+static void bba_stop_receive(void) {
+    {
+        irq_disable_scoped();
+        rx_enabled = false;
+        asic_evt_disable(ASIC_EVT_EXP_PCI, BBA_ASIC_IRQ);
+        asic_evt_remove_handler(ASIC_EVT_EXP_PCI);
+    }
+    while(atomic_load(&dma_used))
+        thd_sleep(1);
+    thd_worker_destroy(rx_worker);
+    rx_worker = NULL;
+}
