+
+static uint32_t be32(const uint8_t *b) {
+    return (uint32_t)b[0]<<24 | (uint32_t)b[1]<<16 | (uint32_t)b[2]<<8 | (uint32_t)b[3];
+}
+static uint32_t le32(const uint8_t *b) {
+    return (uint32_t)b[3]<<24 | (uint32_t)b[2]<<16 | (uint32_t)b[1]<<8 | (uint32_t)b[0];
+}
+static bool complete_png(const uint8_t *data, size_t size) {
+    if(size < 33 || memcmp(data, "\211PNG\r\n\032\n\0\0\0\rIHDR", 16)) return false;
+    size_t at = 8;
+    while(size-at >= 12) {
+        uint32_t n = be32(data+at);
+        if(n > size-at-12 || kui_crc32_capture(0, data+at+4, n+4) != be32(data+at+8+n)) return false;
+        if(!memcmp(data+at+4, "IEND", 4)) return !n && at+12 == size;
+        at += n+12;
+    }
+    return false;
+}
+static bool read_exact(FIL *file, void *data, UINT size) {
+    UINT read = 0;
+    return f_read(file, data, size, &read) == FR_OK && read == size;
+}
+static size_t plane_offset(enum kui_cover_size size) {
+    return kui_cover_offset(size) - KUI_COVER_HEADER_BYTES;
+}
+
+static enum kui_compact_result decode(FIL *source, bool small_jpeg, uint16_t *out, kui_cancel_fn cancel) {
+    if(f_size(source) < 8 || f_size(source) > KUI_INTERNET_COVER_MAX_BYTES) return KUI_COMPACT_INVALID;
+    size_t bytes = (size_t)f_size(source);
+    uint8_t sig[8];
+    if(f_lseek(source,0) != FR_OK || !read_exact(source,sig,sizeof(sig)) || f_lseek(source,0) != FR_OK)
+        return KUI_COMPACT_ERROR;
+    bool jpeg = sig[0] == 0xff && sig[1] == 0xd8 && sig[2] == 0xff;
+    if((small_jpeg && !jpeg) || (!jpeg && memcmp(sig,"\211PNG\r\n\032\n",8))) return KUI_COMPACT_INVALID;
+    enum kui_cover_rows_result r = jpeg ? kui_cover_jpeg_scaled(source,out,small_jpeg,cancel) :
+        kui_cover_png_rows(source,out,cancel);
+    if(r == KUI_COVER_ROWS_OK) return KUI_COMPACT_OK;
+    if(r == KUI_COVER_ROWS_INVALID) return KUI_COMPACT_INVALID;
+    if(r != KUI_COVER_ROWS_FALLBACK || f_lseek(source,0) != FR_OK) return KUI_COMPACT_ERROR;
+    if(bytes > KUI_COVER_IMAGE_MAX_BYTES) return KUI_COMPACT_INVALID;
+    uint8_t *data = malloc(bytes), *pixels = NULL;
+    if(!data) return KUI_COMPACT_ERROR;
+    enum kui_compact_result result = KUI_COMPACT_ERROR;
+    if(read_exact(source,data,(UINT)bytes)) {
+        bool valid = jpeg ? bytes >= 4 && data[0] == 0xff && data[1] == 0xd8 &&
+            data[bytes-2] == 0xff && data[bytes-1] == 0xd9 : complete_png(data,bytes);
+        unsigned w = 0, h = 0, channels = 0;
+        enum kui_cover_image_status status = valid ?
+            kui_cover_image_decode(data,bytes,&pixels,&w,&h,&channels) : KUI_COVER_IMAGE_CORRUPT;
+        free(data);
+        if(status != KUI_COVER_IMAGE_OK)
+            return status == KUI_COVER_IMAGE_MEMORY ? KUI_COMPACT_ERROR : KUI_COMPACT_INVALID;
+        if(w > KUI_INTERNET_COVER_MAX_EDGE || h > KUI_INTERNET_COVER_MAX_EDGE) {
+            kui_cover_image_free(pixels);
+            return KUI_COMPACT_INVALID;
+        }
+        kui_cover_reduce(pixels,&w,&h,channels);
+        result = KUI_COMPACT_OK;
+        for(enum kui_cover_size i=KUI_COVER_SIZE_LARGE; i<=KUI_COVER_SIZE_SMALL; ++i) {
+            if((cancel && cancel()) || !kui_cover_scale(pixels,w,h,channels,
+                    out + plane_offset(i)/2, kui_cover_edge(i))) {
+                result = KUI_COMPACT_ERROR;
+                break;
+            }
+        }
+        kui_cover_image_free(pixels);
+        return result;
+    }
+    free(data);
+    return result;
+}
+
+enum kui_compact_result kui_compact_cover_encode(FIL *source, FIL *dest, bool small_jpeg, kui_cancel_fn cancel) {
+    uint8_t *file = malloc(KUI_COMPACT_COVER_BYTES);
+    if(!file) return KUI_COMPACT_ERROR;
+    uint16_t *planes = (uint16_t *)(file + KUI_COMPACT_COVER_HEADER);
+    enum kui_compact_result result = decode(source, small_jpeg, planes, cancel);
+    if(result == KUI_COMPACT_OK) {
+        memcpy(file,"KCT1",4);
+        for(enum kui_cover_size i=KUI_COVER_SIZE_LARGE; i<=KUI_COVER_SIZE_SMALL; ++i) {
+            size_t offset = plane_offset(i);
+            uint8_t *p = file + KUI_COMPACT_COVER_HEADER + offset;
+            unsigned count = kui_cover_edge(i) * kui_cover_edge(i);
+            for(unsigned j=0; j<count; ++j) {
+                uint16_t pixel = planes[offset/2 + j];
+                p[2*j] = (uint8_t)pixel;
+                p[2*j+1] = (uint8_t)(pixel >> 8);
+            }
+            uint32_t crc = kui_crc32_capture(0,p,2*count);
+            for(unsigned j=0; j<4; ++j) file[4+4*i+j] = (uint8_t)(crc >> (8*j));
+        }
+        UINT written;
+        if((cancel && cancel()) || f_lseek(dest,0) != FR_OK ||
+           f_write(dest,file,KUI_COMPACT_COVER_BYTES,&written) != FR_OK ||
+           written != KUI_COMPACT_COVER_BYTES ||
+           (f_size(dest) != written && f_truncate(dest) != FR_OK)) result = KUI_COMPACT_ERROR;
+    }
+    free(file);
+    return result;
+}
+static bool read_header(FIL *file, uint8_t header[KUI_COMPACT_COVER_HEADER]) {
+    return f_size(file) == KUI_COMPACT_COVER_BYTES && f_lseek(file,0) == FR_OK &&
+        read_exact(file,header,KUI_COMPACT_COVER_HEADER) && !memcmp(header,"KCT1",4);
+}
+bool kui_compact_cover_pixels(FIL *file, enum kui_cover_size size, uint16_t *pixels) {
+    uint8_t header[KUI_COMPACT_COVER_HEADER];
+    if((unsigned)size > KUI_COVER_SIZE_SMALL || !read_header(file,header)) return false;
+    unsigned count = kui_cover_edge(size)*kui_cover_edge(size);
+    uint8_t *b = (uint8_t *)pixels;
+    if(f_lseek(file,KUI_COMPACT_COVER_HEADER + plane_offset(size)) != FR_OK ||
+        !read_exact(file,b,2u*count) || kui_crc32_capture(0,b,2u*count) != le32(header+4+4*size)) return false;
+    for(unsigned j=0; j<count; ++j) pixels[j] = (uint16_t)(b[2*j] | b[2*j+1] << 8);
+    return true;
+}
+enum kui_compact_result kui_compact_cover_verify(FIL *file, kui_cancel_fn cancel) {
+    uint8_t header[KUI_COMPACT_COVER_HEADER], block[2048];
+    if(f_size(file) != KUI_COMPACT_COVER_BYTES) return KUI_COMPACT_INVALID;
+    if(f_lseek(file,0) != FR_OK || !read_exact(file,header,sizeof(header))) return KUI_COMPACT_ERROR;
+    if(memcmp(header,"KCT1",4)) return KUI_COMPACT_INVALID;
+    for(enum kui_cover_size i=KUI_COVER_SIZE_LARGE; i<=KUI_COVER_SIZE_SMALL; ++i) {
+        unsigned left = 2*kui_cover_edge(i)*kui_cover_edge(i);
+        uint32_t crc = 0;
+        while(left) {
+            UINT n = left < sizeof(block) ? left : sizeof(block);
+            if((cancel && cancel()) || !read_exact(file,block,n)) return KUI_COMPACT_ERROR;
+            crc = kui_crc32_capture(crc,block,n);
+            left -= n;
+        }
+        if(crc != le32(header+4+4*i)) return KUI_COMPACT_INVALID;
+    }
+    return KUI_COMPACT_OK;
+}
diff --git a/src/apps/cover_jpeg.c b/src/apps/cover_jpeg.c
new file mode 100644
index 0000000000000000000000000000000000000000..0d7f61f77ff2b2c343cf07550260c53994fb381c
--- /dev/null
+++ b/src/apps/cover_jpeg.c
@@ -0,0 +1,123 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include "kui/cover_jpeg.h"
+#include "kui/compact_cover.h"
+#include "kui/cover_image.h"
+#include "../../third_party/tjpgd/tjpgd.h"
+#include <stdlib.h>
+#include <string.h>
+
+struct input {
+    FIL *file;
+    kui_cancel_fn cancel;
+    uint8_t *rgb;
+    unsigned width, height;
+    bool io_error;
+};
+static size_t input_bytes(JDEC *jd, uint8_t *dest, size_t count) {
+    struct input *in = jd->device;
+    if(in->cancel && in->cancel()) { in->io_error = true; return 0; }
+    FSIZE_t remaining = f_size(in->file) - f_tell(in->file);
+    if(!dest) {
+        if(count > remaining) return 0;
+        if(f_lseek(in->file,f_tell(in->file)+count) != FR_OK) { in->io_error = true; return 0; }
+        return count;
+    }
+    if(count > remaining) count = (size_t)remaining;
+    UINT got = 0;
+    if(f_read(in->file,dest,(UINT)count,&got) != FR_OK || got != count) in->io_error = true;
+    return in->io_error ? 0 : got;
+}
+static int output_block(JDEC *jd, void *rgb, JRECT *r) {
+    struct input *in = jd->device;
+    if((in->cancel && in->cancel()) || r->left > r->right || r->top > r->bottom ||
+       r->right >= in->width || r->bottom >= in->height) return 0;
+    const uint8_t *src = rgb;
+    size_t bytes = (r->right-r->left+1u)*3u;
+    for(unsigned y = r->top; y <= r->bottom; ++y) {
+        memcpy(in->rgb+3u*((size_t)y*in->width+r->left),src,bytes);
+        src += bytes;
+    }
+    return 1;
+}
+
+/* Identify the frame before handing a small progressive or baseline image
+ * back to stb. JPEG comments/EXIF may precede SOF and can exceed 64 KiB in
+ * aggregate, so skip them on the card instead of loading a header buffer. */
+static enum kui_cover_rows_result frame_info(struct input *in, unsigned *w,unsigned *h,bool *baseline) {
+    FIL *f = in->file;
+    uint8_t b[6];
+    JDEC io = {.device = in};
+    if(f_size(f) < 8) return KUI_COVER_ROWS_INVALID;
+    if(f_lseek(f,f_size(f)-2) != FR_OK) return KUI_COVER_ROWS_ERROR;
+    if(input_bytes(&io,b,2) != 2 || b[0] != 0xff || b[1] != 0xd9) return KUI_COVER_ROWS_INVALID;
+    if(f_lseek(f,0) != FR_OK) return KUI_COVER_ROWS_ERROR;
+    if(input_bytes(&io,b,2) != 2 || b[0] != 0xff || b[1] != 0xd8) return KUI_COVER_ROWS_INVALID;
+    while(f_tell(f) < f_size(f)) {
+        if(input_bytes(&io,b,1) != 1 || b[0] != 0xff) return KUI_COVER_ROWS_INVALID;
+        do { if(input_bytes(&io,b,1) != 1) return KUI_COVER_ROWS_INVALID; } while(b[0] == 0xff);
+        uint8_t marker = b[0];
+        if(!marker || (marker >= 0xd0 && marker <= 0xda) || input_bytes(&io,b,2) != 2)
+            return KUI_COVER_ROWS_INVALID;
+        size_t len = (size_t)b[0]*256+b[1];
+        if(len < 2 || len-2 > f_size(f)-f_tell(f)) return KUI_COVER_ROWS_INVALID;
+        if(marker == 0xc0 || marker == 0xc1 || marker == 0xc2) {
+            if(len < 11 || input_bytes(&io,b,sizeof(b)) != sizeof(b) || b[0] != 8 ||
+               len != 8u+3u*b[5]) return KUI_COVER_ROWS_INVALID;
+            *h = (unsigned)b[1]*256+b[2]; *w = (unsigned)b[3]*256+b[4]; *baseline = marker == 0xc0;
+            return *w && *h && *w <= KUI_INTERNET_COVER_MAX_EDGE && *h <= KUI_INTERNET_COVER_MAX_EDGE ?
+                KUI_COVER_ROWS_OK : KUI_COVER_ROWS_INVALID;
+        }
+        if(f_lseek(f,f_tell(f)+len-2) != FR_OK) return KUI_COVER_ROWS_ERROR;
+    }
+    return KUI_COVER_ROWS_INVALID;
+}
+
+enum kui_cover_rows_result kui_cover_jpeg_scaled(FIL *source, uint16_t *planes, bool small,
+                                                  kui_cancel_fn cancel) {
+    struct input in = {.file=source,.cancel=cancel};
+    bool baseline = false;
+    unsigned w=0,h=0;
+    enum kui_cover_rows_result result = frame_info(&in,&w,&h,&baseline);
+    if(in.io_error) return KUI_COVER_ROWS_ERROR;
+    if(result != KUI_COVER_ROWS_OK) return result;
+    if(small && ((w < KUI_COVER_LARGE && h < KUI_COVER_LARGE) || w > 256 || h > 256))
+        return KUI_COVER_ROWS_INVALID;
+    if((uint64_t)w*h <= KUI_COVER_IMAGE_MAX_PIXELS && f_size(source) <= KUI_COVER_IMAGE_MAX_BYTES)
+        return KUI_COVER_ROWS_FALLBACK;
+    if(small || !baseline) return KUI_COVER_ROWS_INVALID;
+
+    /* The long edge stays at least as large as the Games display where
+     * possible. At 4K this produces at most 512x512 RGB before final scaling. */
+    unsigned shift = 0, longest = w > h ? w : h;
+    while(shift < 3 && (longest >> (shift+1)) >= KUI_COVER_LARGE &&
+          (w >> (shift+1)) && (h >> (shift+1))) ++shift;
+    in.width=w>>shift; in.height=h>>shift;
+    if((uint64_t)in.width*in.height > 512u*512u) return KUI_COVER_ROWS_INVALID;
+    if(f_lseek(source,0) != FR_OK) return KUI_COVER_ROWS_ERROR;
+    JDEC jd;
+    unsigned pool_bytes = 16384;
+    void *pool = malloc(pool_bytes);
+    if(!pool) return KUI_COVER_ROWS_ERROR;
+    JRESULT status = jd_prepare(&jd,input_bytes,pool,pool_bytes,&in);
+    result = KUI_COVER_ROWS_INVALID;
+    if(status == JDR_OK && jd.width == w && jd.height == h) {
+        in.rgb = malloc(3u*in.width*in.height);
+        if(!in.rgb) result = KUI_COVER_ROWS_ERROR;
+        else {
+            status = jd_decomp(&jd,output_block,(uint8_t)shift);
+            if(status == JDR_OK) {
+                result = KUI_COVER_ROWS_OK;
+                for(enum kui_cover_size i=KUI_COVER_SIZE_LARGE; i<=KUI_COVER_SIZE_SMALL; ++i) {
+                    if((cancel && cancel()) || !kui_cover_scale(in.rgb,in.width,in.height,3,planes,kui_cover_edge(i))) {
+                        result = KUI_COVER_ROWS_ERROR;
+                        break;
+                    }
+                    planes += kui_cover_edge(i)*kui_cover_edge(i);
+                }
+            }
+        }
+    }
+    free(in.rgb);
+    free(pool);
+    return in.io_error || (cancel && cancel()) ? KUI_COVER_ROWS_ERROR : result;
+}
diff --git a/src/apps/cover_png_rows.c b/src/apps/cover_png_rows.c
new file mode 100644
index 0000000000000000000000000000000000000000..3fbc2d22b541f31d51ab861d7fb9748866f9152d
--- /dev/null
+++ b/src/apps/cover_png_rows.c
@@ -0,0 +1,324 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include "kui/cover_png_rows.h"
+#include "kui/compact_cover.h"
+#include "kui/game_cover.h"
+#include "kui/hash.h"
+#ifndef MINIZ_NO_ZLIB_APIS
+#define MINIZ_NO_ZLIB_APIS
+#endif
+#include "../../third_party/miniz/miniz.h"
+#include <stdlib.h>
+#include <string.h>
+
+struct view {
+    uint16_t *pixels;
+    unsigned edge, width, height, next;
+};
+
+/* 4096 -> 2048 -> 1024 -> 512. One pending source row per step. */
+struct half_row {
+    uint8_t *saved;
+    unsigned width;
+    bool pending;
+};
+
+struct png {
+    tinfl_decompressor inflater;
+    uint8_t history[TINFL_LZ_DICT_SIZE], input[4096];
+    uint8_t *rows, *source_rows, *reduced_row, *expanded;
+    uint8_t palette[256][4];
+    uint16_t key[3];
+    unsigned palette_count, depth, color, filter_bpp;
+    bool key_present;
+    struct half_row half[4];
+    unsigned levels, sample_y, sample_w, sample_h, sample_stride;
+    struct view views[3];
+    unsigned width, height, channels, stride, slots;
+    unsigned history_pos, y, row_bytes;
+    uint8_t filter;
+    bool ended;
+};
+
+static uint32_t be32(const uint8_t *p) {
+    return (uint32_t)p[0]<<24 | (uint32_t)p[1]<<16 | (uint32_t)p[2]<<8 | p[3];
+}
+
+static bool read_exact(FIL *file, void *data, UINT size) {
+    UINT got;
+    return f_read(file, data, size, &got) == FR_OK && got == size;
+}
+
+/* Store the rows needed by one output row. Mirroring this small window
+ * makes a band spanning the end of the ring contiguous for the area filter. */
+static bool prepare(struct png *p, uint16_t *out) {
+    unsigned w = p->width, h = p->height;
+    static const unsigned samples[] = {1,0,3,1,2,0,4};
+    unsigned bits = samples[p->color] * p->depth;
+    p->channels = p->color == 3 || p->color == 4 || p->color == 6 || p->key_present ? 4 : 3;
+    p->stride = (w*bits+7)/8;
+    p->filter_bpp = (bits+7)/8;
+    if(p->depth != 8 || (p->color != 2 && p->color != 6) || p->key_present) {
+        p->expanded = malloc(w*p->channels);
+        if(!p->expanded) return false;
+    }
+    while(kui_cover_can_halve(w,h)) {
+        if(p->levels == sizeof(p->half)/sizeof(p->half[0])) return false;
+        struct half_row *step = &p->half[p->levels++];
+        step->width = w;
+        step->saved = malloc(w*p->channels);
+        if(!step->saved) return false;
+        w/=2; h/=2;
+    }
+    if(p->levels || p->expanded) {
+        p->source_rows = calloc(2,p->stride);
+        if(!p->source_rows) return false;
+    }
+    if(p->levels) {
+        p->reduced_row = malloc((p->width/2)*p->channels);
+        if(!p->reduced_row) return false;
+    }
+    p->sample_w = w;
+    p->sample_h = h;
+    p->sample_stride = w*p->channels;
+    for(unsigned i=0; i<3; ++i) {
+        struct view *v = &p->views[i];
+        v->edge = kui_cover_edge((enum kui_cover_size)i);
+        kui_cover_fit(w, h, v->edge, &v->width, &v->height);
+        v->pixels = out;
+        for(unsigned j=0; j<v->edge*v->edge; ++j) *out++ = KUI_COVER_BACKGROUND;
+        unsigned needed = 1 + (h + v->height - 1) / v->height;
+        if(p->slots < needed) p->slots = needed;
+    }
+    p->rows = calloc(2u*p->slots, p->sample_stride);
+    return p->rows != NULL;
+}
+
+static int paeth(int a, int b, int c) {
+    int prediction = a + b - c;
+    int da = abs(prediction-a), db = abs(prediction-b), dc = abs(prediction-c);
+    return da <= db && da <= dc ? a : db <= dc ? b : c;
+}
+
+static uint8_t *source_row(struct png *p, bool previous) {
+    unsigned count = p->source_rows ? 2 : p->slots;
+    unsigned slot = (p->y+count-(previous ? 1u : 0u))%count;
+    return (p->source_rows ? p->source_rows : p->rows) + slot*p->stride;
+}
+static unsigned sample(const uint8_t *row, unsigned n, unsigned depth) {
+    if(depth == 16) return (unsigned)row[2*n]<<8 | row[2*n+1];
+    if(depth == 8) return row[n];
+    unsigned bit=n*depth;
+    return row[bit/8] >> (8-depth-bit%8) & ((1u<<depth)-1);
+}
+static uint8_t byte_sample(unsigned value, unsigned depth) {
+    if(depth == 16) return (uint8_t)(value>>8);
+    return (uint8_t)(depth == 8 ? value : value * (255u/((1u<<depth)-1u)));
+}
+static bool expand_row(struct png *p, const uint8_t *row) {
+    uint8_t *out=p->expanded;
+    for(unsigned x=0; x<p->width; ++x, out+=p->channels) {
+        if(p->color == 3) {
+            unsigned index=sample(row,x,p->depth);
+            if(index >= p->palette_count) return false;
+            memcpy(out,p->palette[index],4);
+        } else if(p->color == 0 || p->color == 4) {
+            unsigned n=p->color == 0 ? x : x*2;
+            unsigned gray=sample(row,n,p->depth);
+            out[0]=out[1]=out[2]=byte_sample(gray,p->depth);
+            if(p->color == 4) out[3]=byte_sample(sample(row,n+1,p->depth),p->depth);
+            else if(p->key_present) out[3]=gray == p->key[0] ? 0 : 255;
+        } else {
+            unsigned n=x*(p->color == 2 ? 3u : 4u);
+            bool transparent=p->key_present;
+            for(unsigned c=0;c<3;c++) {
+                unsigned v=sample(row,n+c,p->depth);
+                out[c]=byte_sample(v,p->depth);
+                if(v != p->key[c]) transparent=false;
+            }
+            if(p->color == 6) out[3]=byte_sample(sample(row,n+3,p->depth),p->depth);
+            else if(p->key_present) out[3]=transparent ? 0 : 255;
+        }
+    }
+    return true;
+}
+
+static bool finish_row(struct png *p) {
+    uint8_t *row = source_row(p,false);
+    const uint8_t *prev = source_row(p,true);
+    /* The unused previous slot starts zero for the first scanline. */
+    if(p->filter) {
+        for(unsigned i=0; i<p->stride; ++i) {
+            int a = i < p->filter_bpp ? 0 : row[i-p->filter_bpp];
+            int b = prev[i];
+            int c = i < p->filter_bpp ? 0 : prev[i-p->filter_bpp];
+            int delta;
+            switch(p->filter) {
+            case 1: delta = a; break;
+            case 2: delta = b; break;
+            case 3: delta = (a+b)/2; break;
+            default: delta = paeth(a,b,c); break;
+            }
+            row[i] = (uint8_t)(row[i]+delta);
+        }
+    }
+    if(p->expanded) {
+        if(!expand_row(p,row)) return false;
+        row=p->expanded;
+    }
+    ++p->y;
+    p->row_bytes = 0;
+    for(unsigned i=0; i<p->levels; ++i) {
+        struct half_row *step = &p->half[i];
+        if(!step->pending) {
+            memcpy(step->saved,row,step->width*p->channels);
+            step->pending = true;
+            return true;
+        }
+        kui_cover_half_row(step->saved,row,step->width,p->channels,p->reduced_row);
+        row = p->reduced_row;
+        step->pending = false;
+    }
+    uint8_t *slot = p->rows + (p->sample_y%p->slots)*p->sample_stride;
+    if(row != slot) memcpy(slot,row,p->sample_stride);
+    memcpy(slot+p->slots*p->sample_stride,slot,p->sample_stride);
+    ++p->sample_y;
+    for(unsigned i=0; i<3; ++i) {
+        struct view *v = &p->views[i];
+        if(v->next >= v->height || (v->next+1)*p->sample_h > p->sample_y*v->height) continue;
+        unsigned start = v->next*p->sample_h/v->height;
+        const uint8_t *band = p->rows + (start%p->slots)*p->sample_stride;
+        unsigned top = (v->edge-v->height)/2u, left = (v->edge-v->width)/2u;
+        kui_cover_shrink_row(band,p->sample_w,p->sample_h,p->channels,v->width,v->height,
