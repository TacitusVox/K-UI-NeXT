  "checks": [
    "Compare every executable PPF record with the corresponding bytes in its independently bundled reference executable.",
    "Replace every destination byte in the reference executable with a different value, select the release through the production IP.BIN matcher, and verify that the production boot patch reproduces the complete reference executable.",
    "Changing one byte outside the patch rejected the projected hash. Changing the last target after capture rejected the entire write set without a partial edit."
  ],
  "release_notes": {
    "Dino Crisis": "PAL English (05), Spanish (06), French (09), German (18) and Italian (13) executable PPFs. Internal product has two spaces before the edition code.",
    "Resident Evil Code: Veronica": "The author specifies the same executable for both discs of each of the four regional releases. The PPFs listed below apply only to the boot executable.",
    "Skies of Arcadia": "The publisher specifies the same executable for discs 1 and 2. Both pass a shared target SHA-256. The animated/cutscene/audio and walking-speed fixes in Riggles’ Perfect 60Hz patch are separate.",
    "Skies of Arcadia original disc metadata": {
      "RetroAchievements": "https://retroachievements.org/forums/topic/14579",
      "IP_first_256_and_stock_executable_MD5": [
        "276661ab8bea50afcc1b7a1e48d25ff8",
        "6e18b7264826413e55df3161cc13000e"
      ],
      "usage": "Independent disc identifiers for reference. The launcher verifies the complete projected executable."
    },
    "WWF Attitude": "PAL v1.010 uses the exact boot filename 1WWFTUDE.BIN from the publisher’s readme, size and region, with full projected executable SHA-256. The German v1.000 edition is distinct.",
    "Hydro Thunder May 1999 prototype": "The publisher identifies the May 20 alpha’s 1ST_READ.BIN. The exact file length and complete projected SHA-256 authenticate the executable across different IP.BIN versions and regions. The original product, version field and area field are unconfirmed. The July prototype and the retail builds use different executables."
  },
