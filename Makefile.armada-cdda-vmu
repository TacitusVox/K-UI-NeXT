# Not a delivery recipe: its reader (7827779dd053) failed on the console;
# see docs/armada-vmu-on-audio-fix-test.md. ARMADA_CDDA_VMU_TIMING=1 builds
# the same reader with the VMU Off movie timing and the Maple hook's own time
# (build/armada-ce-cdda-vmu-timing), a measurement only.
ifeq ($(ARMADA_CDDA_VMU_TIMING),1)
override ARMADA_A2_DIR := build/armada-ce-cdda-vmu-timing
else
override ARMADA_A2_DIR := build/armada-ce-cdda-vmu
endif
override ARMADA_A2_CDDA := 1
# The candidate: proven controller polls skip the hook's per-completion proofs
# (the e73f99a93865 measurement: 14% of the intro). 0 rebuilds that baseline.
ARMADA_A2_STEADY ?= 1
override ARMADA_A2_WRITE_LAYOUT := 1
override ARMADA_A2_WRITE_STAGING := 1
override ARMADA_A2_WRITE_RUNTIME := 1
override SD_PROFILE := $(ARMADA_A2_DIR)/vmu-sd-template.bin

.PHONY: armada-cdda-vmu
armada-cdda-vmu: $(ARMADA_A2_DIR)/entry.elf

$(SD_PROFILE): tools/vmu_persist_profile.py
	python3 $< --template $@ > /dev/null
# The layout record hashes the profile, so the template must exist first.
$(ARMADA_A2_DIR)/layout-config: $(SD_PROFILE)

include Makefile.armada-vmu-a2
